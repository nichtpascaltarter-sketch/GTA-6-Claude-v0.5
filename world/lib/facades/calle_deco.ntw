ntw 1 facade id=lib.facade.calle_deco
# the flat-roofed casitas: smooth stucco on a stucco plinth, a band at the floor line, an eyebrow over each window, a
# cornice along the parapet, casement windows without shutters
wall material=lib.kit.mat_stucco color=wall
trim kind=band material=lib.kit.mat_stucco color=trim h=0.20
trim kind=eyebrow material=lib.kit.mat_stucco color=trim h=0.12
trim kind=cornice material=lib.kit.mat_stucco color=trim h=0.35
window kind=casement frame=lib.kit.mat_frame color=trim shutters=none
door style=lib.kit.door_panel color=door
base h=0.45 material=lib.kit.mat_stucco
