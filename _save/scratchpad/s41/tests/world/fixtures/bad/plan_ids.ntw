ntw 1 plan id=lib.layout.house.x # expect id.form
meta class=house family=x floors=1 size=5.00x5.00
floor first layout=lib.layout.house.x_f0 z=0.00 h=2.80 # expect w:id.form
floor f0 layout=lib.layout.house.x_f0 z=0.00 h=2.80
floor f0 layout=lib.layout.house.x_f1 z=2.80 h=2.80 # expect id.unique
option porch choices=none,open default=none
option garage choices=none,carport default=garage # expect ref.missing
feature porch.open when=porch:open mesh=lib.kit.porch_open
feature porch.closed when=porch:closed mesh=lib.kit.porch_closed # expect ref.missing
feature deck when=deck:yes mesh=lib.kit.deck # expect ref.missing
feature deck2 when=porch mesh=lib.kit.deck # expect ref.form
entrance main door=f0.d1 kind=main
entrance main door=f0.d2 kind=service # expect id.unique
