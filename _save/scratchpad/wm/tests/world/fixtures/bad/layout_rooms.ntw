ntw 1 layout id=lib.layout.test.rooms
# rooms that aren't closed by walls, have no proper shape, or overlap (an outdoor room needs no walls)
wall w1 a=0.00,0.00 b=6.00,0.00 t=0.20 ext=front
wall w2 a=6.00,0.00 b=6.00,4.00 t=0.20 ext=right
wall w3 a=6.00,4.00 b=0.00,4.00 t=0.20 ext=back
wall w4 a=0.00,4.00 b=0.00,2.00 t=0.20 ext=left
room a type=living poly=0.00,0.00;3.00,0.00;3.00,4.00;0.00,4.00 # expect room.closed
room b type=living poly=3.00,0.00;6.00,0.00;6.00,4.00;3.00,4.00 # expect room.closed
room c type=bath poly=0.50,0.50;2.50,0.50;0.50,2.50;1.50,2.50 # expect room.closed room.reach
room d type=store poly=4.00,1.00;5.00,1.00;5.00,1.00 # expect room.closed room.reach
room f type=bath poly=2.00,1.00;4.00,1.00;4.00,2.00;2.00,2.00 # expect room.closed room.overlap room.overlap room.reach
room e type=living poly=0.00,4.00;6.00,4.00;6.00,6.00;0.00,6.00 outdoor=1
door d1 wall=w1 at=1.50 w=0.90 h=2.10 kind=hinged leads=out:a
door d2 wall=w3 at=1.50 w=0.90 h=2.10 kind=sliding leads=b:e
door d3 wall=w1 at=4.50 w=0.90 h=2.10 kind=hinged leads=out:b
