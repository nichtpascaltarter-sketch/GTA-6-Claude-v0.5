ntw 1 layout id=lib.layout.test.corridor
# a corridor too narrow to turn round in
wall w1 a=0.00,0.00 b=6.00,0.00 t=0.20 ext=front
wall w2 a=6.00,0.00 b=6.00,3.00 t=0.20 ext=right
wall w3 a=6.00,3.00 b=0.00,3.00 t=0.20 ext=back
wall w4 a=0.00,3.00 b=0.00,0.00 t=0.20 ext=left
wall w5 a=0.00,1.00 b=6.00,1.00 t=0.12
room hall type=corridor poly=0.00,0.00;6.00,0.00;6.00,1.00;0.00,1.00 # expect corridor.width
room flat type=living poly=0.00,1.00;6.00,1.00;6.00,3.00;0.00,3.00
door d1 wall=w1 at=1.00 w=0.90 h=2.10 kind=hinged leads=out:hall
door d2 wall=w5 at=3.00 w=0.90 h=2.10 kind=hinged leads=hall:flat
