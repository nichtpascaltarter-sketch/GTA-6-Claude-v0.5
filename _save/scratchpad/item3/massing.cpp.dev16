// Archetype massing (included by buildmesh.cpp after its helpers): the volumes an archetype carves out of a building's
// envelope (L and U plans, courtyards, stepped and podium sections, split lots, corner towers, curved fronts, wings), the
// roof form on each volume (parapet, eave slab, barrel-tile hip, tile pent, roof terrace, metal gable, sawtooth,
// butterfly), the archetype houses (ranch, bungalow, Mediterranean, two-storey, MiMo, split level, conch) and the
// industrial variants. Everything that shapes the silhouette is drawn from one seeded stream before any geometry, so
// the far LOD builds the same outline as the full-detail cell.
#include "buildings.h"

namespace World {

namespace massing {

using namespace buildmesh_detail;

// Envelope frame: u along Building::ax in [-hx, hx], v toward the street (Building::front) in [-hy, hy]
struct Env {
    vec2 c, ax, fr;
    float hx, hy;
    bool flip;   // (u, v) -> world mirrors the winding when front == -perp(ax)
    vec2 P(float u, float v) const { return c + ax * u + fr * v; }
};
Env envOf(const Building& b) {
    Env e;
    e.c = b.c;
    e.ax = b.ax;
    e.fr = b.front;
    e.hx = b.hx;
    e.hy = b.hy;
    e.flip = dot(b.front, perp(b.ax)) < 0.f;
    return e;
}
// polygon given counter-clockwise in (u, v) -> counter-clockwise in the world
std::vector<vec2> toWorld(const Env& e, const std::vector<vec2>& uv) {
    std::vector<vec2> w(uv.size());
    for (size_t i = 0; i < uv.size(); i++) w[i] = e.P(uv[i].x, uv[i].y);
    if (e.flip) std::reverse(w.begin(), w.end());
    return w;
}
std::vector<vec2> rectUV(float u0, float u1, float v0, float v1) { return {vec2(u0, v0), vec2(u1, v0), vec2(u1, v1), vec2(u0, v1)}; }

struct Vol {
    std::vector<vec2> uv;      // footprint, CCW in (u, v)
    std::vector<vec4> rects;   // rectangles covering it (u0, u1, v0, v1): collision, pitched roofs
    std::vector<vec2> hole;    // courtyard (CCW in (u, v)), empty if none
    float z0 = 0.f, z1 = 0.f;
    u32 facade = 0;
    u8 kind = FM_MAIN;
    u8 roof = RFM_PARAPET;
    bool ground = true;        // stands on the ground: walls run 3 m below it (terrain), collision from below
    bool top = true;           // nothing stands on its roof (clutter, terraces)
};

// Outward offset of a CCW polygon by d (mitred corners, clamped)
std::vector<vec2> offsetPoly(const std::vector<vec2>& fp, float d) {
    int n = (int)fp.size();
    std::vector<vec2> out(n);
    for (int i = 0; i < n; i++) {
        vec2 p = fp[i], prev = fp[(i + n - 1) % n], next = fp[(i + 1) % n];
        vec2 n0 = -perp(normalize(p - prev)), n1 = -perp(normalize(next - p));   // right normals = outward for CCW
        vec2 nm = normalize(n0 + n1);
        float sc = 1.f / Max(0.35f, dot(nm, n1));
        out[i] = p + nm * (d * sc);
    }
    return out;
}

// ------------------------------------------------------------------------------------------------ roof forms
// Flat roof slab projecting past the walls (MiMo eave): edge faces, top, underside
void eaveSlab(Ctx& x, const std::vector<vec2>& fp, float z, float over, float t, u32 col) {
    std::vector<vec2> o = offsetPoly(fp, over);
    flatRoof(x, o, z + t, col, makeMat(MAT_ROOF_GRAVEL));
    std::vector<vec3> under;
    for (int i = (int)o.size() - 1; i >= 0; i--) under.push_back(vec3(o[i], z) - x.org);
    x.m->polygon(under, vec3(0, 0, -1), packRGBA8(0.93f, 0.93f, 0.92f, 1), makeMat(MAT_PLASTER), 1.f);
    plainWalls(x, o, z, z + t, packRGBA8(0.96f, 0.96f, 0.95f, 1), makeMat(MAT_PLASTER));
}

// Barrel-tile pent roof along a wall a -> b (CCW footprint edge): from the parapet top out over the facade
void pentRoof(Ctx& x, vec2 a, vec2 b, float zTop, float out, u32 tile) {
    vec2 t = normalize(b - a), n(t.y, -t.x);
    vec2 a0 = a - t * 0.25f, b0 = b + t * 0.25f;
    vec3 p0 = vec3(a0 - n * 0.2f, zTop + 0.32f) - x.org, p1 = vec3(b0 - n * 0.2f, zTop + 0.32f) - x.org;
    vec3 q0 = vec3(a0 + n * out, zTop - 0.12f) - x.org, q1 = vec3(b0 + n * out, zTop - 0.12f) - x.org;
    float len = length(b0 - a0);
    x.m->quadFacing(p0, p1, q1, q0, vec2(0, 0), vec2(len, 0), vec2(len, out), vec2(0, out), tile, makeMat(MAT_ROOF_TILE), vec3(n, 2.f));
    x.m->quadFacing(p0, q0, q1, p1, vec2(0, 0), vec2(out, 0), vec2(out, len), vec2(0, len), packRGBA8(0.9f, 0.88f, 0.84f, 1), makeMat(MAT_PLASTER), vec3(-n, -2.f));
    // drip edge
    x.m->quadFacing(q0, q1, q1 - vec3(0, 0, 0.1f), q0 - vec3(0, 0, 0.1f), vec2(0, 0), vec2(len, 0), vec2(len, 0.1f), vec2(0, 0.1f), tile, makeMat(MAT_ROOF_TILE), vec3(n, 0.f));
}

// The eyebrow of a Keys house: the roof's front eave brought down over the upper windows - a tin pent across the wall a..b
// (n: outward) from above the wall top, out and down, with a painted soffit and a fascia board
void eyebrowPent(Ctx& x, vec2 a, vec2 b, vec2 n, float zTop, float out, float drop, u32 col, u32 mat, u32 soffit) {
    vec2 t = normalize(b - a);
    vec2 a0 = a - t * 0.3f, b0 = b + t * 0.3f;
    vec3 p0 = vec3(a0 - n * 0.15f, zTop + 0.2f) - x.org, p1 = vec3(b0 - n * 0.15f, zTop + 0.2f) - x.org;
    vec3 q0 = vec3(a0 + n * out, zTop - drop) - x.org, q1 = vec3(b0 + n * out, zTop - drop) - x.org;
    float len = length(b0 - a0);
    x.m->quadFacing(p0, p1, q1, q0, vec2(0, 0), vec2(len, 0), vec2(len, out), vec2(0, out), col, mat, vec3(n, 1.5f));
    x.m->quadFacing(p0, q0, q1, p1, vec2(0, 0), vec2(out, 0), vec2(out, len), vec2(0, len), soffit, makeMat(MAT_PLASTER), vec3(-n, -1.5f));
    x.m->quadFacing(q0, q1, q1 - vec3(0, 0, 0.16f), q0 - vec3(0, 0, 0.16f), vec2(0, 0), vec2(len, 0), vec2(len, 0.16f), vec2(0, 0.16f), soffit, makeMat(MAT_PLASTER),
                    vec3(n, 0.f));
}

// Shingled mansard band round a flat roof (1970s motor inns): from just outside the walls at the eave up and in to the
// flat top
void mansardRoof(Ctx& x, const std::vector<vec2>& fp, float z, float h, u32 col, u32 roofCol, u32 roofMat) {
    std::vector<vec2> lo = offsetPoly(fp, 0.55f), hi = offsetPoly(fp, -0.45f);
    int n = (int)fp.size();
    for (int i = 0; i < n; i++) {
        int j = (i + 1) % n;
        vec3 a0 = vec3(lo[i], z - 0.15f) - x.org, a1 = vec3(lo[j], z - 0.15f) - x.org, b0 = vec3(hi[i], z + h) - x.org, b1 = vec3(hi[j], z + h) - x.org;
        vec2 t = fp[j] - fp[i];
        float len = length(t);
        if (len < 0.05f) continue;
        vec2 nn(t.y / len, -t.x / len);
        float sl = sqrtf(1.f + h * h);
        x.m->quadFacing(a0, a1, b1, b0, vec2(0, 0), vec2(len, 0), vec2(len, sl), vec2(0, sl), col, makeMat(MAT_ROOF_SHINGLE), vec3(nn * h, 1.f));
        // the soffit under the band's overhang
        vec3 s0 = vec3(fp[i], z - 0.15f) - x.org, s1 = vec3(fp[j], z - 0.15f) - x.org;
        x.m->quadFacing(s0, s1, a1, a0, vec2(0, 0), vec2(len, 0), vec2(len, 0.55f), vec2(0, 0.55f), packRGBA8(0.85f, 0.83f, 0.8f, 1), makeMat(MAT_PLASTER), vec3(0, 0, -1));
    }
    flatRoof(x, hi, z + h, roofCol, roofMat);
}

// Sawtooth (north light) roof over a rectangle: teeth across the depth, glazed vertical faces, gable ends
void sawtoothRoof(Ctx& x, const Env& e, float u0, float u1, float v0, float v1, float z, u32 roofCol, u32 wallCol, u32 wallMat) {
    float depth = v1 - v0;
    int teeth = Max(2, (int)roundf(depth / 7.5f));
    float td = depth / teeth, rise = Clamp(td * 0.42f, 2.2f, 3.4f);
    vec3 X(e.ax, 0.f);
    for (int k = 0; k < teeth; k++) {
        float va = v0 + k * td, vb = va + td;
        // slope rising toward the back (glazing faces the back of the lot)
        vec3 a0 = vec3(e.P(u0, vb), z) - x.org, a1 = vec3(e.P(u1, vb), z) - x.org;
        vec3 b0 = vec3(e.P(u0, va), z + rise) - x.org, b1 = vec3(e.P(u1, va), z + rise) - x.org;
        vec3 up = normalize(vec3(e.fr * rise, td));
        x.m->quadFacing(a0, a1, b1, b0, vec2(0, 0), vec2(u1 - u0, 0), vec2(u1 - u0, td), vec2(0, td), roofCol, makeMat(MAT_ROOF_METAL), up);
        // glazed face (vertical) at va
        vec3 g0 = vec3(e.P(u0, va), z) - x.org, g1 = vec3(e.P(u1, va), z) - x.org;
        x.m->quadFacing(g0, g1, b1, b0, vec2(0, 0), vec2(u1 - u0, 0), vec2(u1 - u0, rise), vec2(0, rise), packRGBA8(0.35f, 0.42f, 0.45f, 1), makeMat(MAT_GLASS),
                        vec3(-e.fr, 0.f));
        // gable triangles at both ends
        for (int s = 0; s < 2; s++) {
            float u = s ? u1 : u0;
            vec3 p0 = vec3(e.P(u, vb), z) - x.org, p1 = vec3(e.P(u, va), z) - x.org, p2 = vec3(e.P(u, va), z + rise) - x.org;
            vec3 nn = s ? X : -X;
            u32 i0 = x.m->addVertex(p0, nn, vec3(e.fr, 0.f), vec2(0, 0), wallCol, wallMat);
            u32 i1 = x.m->addVertex(p1, nn, vec3(e.fr, 0.f), vec2(td, 0), wallCol, wallMat);
            u32 i2 = x.m->addVertex(p2, nn, vec3(e.fr, 0.f), vec2(td, rise), wallCol, wallMat);
            if (dot(cross(p1 - p0, p2 - p0), nn) >= 0.f) x.m->tri(i0, i1, i2);
            else x.m->tri(i0, i2, i1);
        }
    }
}

// Butterfly roof: two planes falling to a valley along the long axis of the rectangle
void butterflyRoof(Ctx& x, const Env& e, float u0, float u1, float v0, float v1, float z, float over, u32 col) {
    bool alongU = (u1 - u0) >= (v1 - v0);
    float rise = 0.18f * (alongU ? (v1 - v0) : (u1 - u0));
    u0 -= over, u1 += over, v0 -= over, v1 += over;
    float um = (u0 + u1) * 0.5f, vm = (v0 + v1) * 0.5f;
    auto V = [&](float u, float v, float h) { return vec3(e.P(u, v), z + h) - x.org; };
    u32 m = makeMat(MAT_ROOF_METAL);
    if (alongU) {
        x.m->quadFacing(V(u0, v0, rise), V(u1, v0, rise), V(u1, vm, 0.f), V(u0, vm, 0.f), vec2(0), vec2(1, 0), vec2(1), vec2(0, 1), col, m, vec3(0, 0, 1));
        x.m->quadFacing(V(u0, vm, 0.f), V(u1, vm, 0.f), V(u1, v1, rise), V(u0, v1, rise), vec2(0), vec2(1, 0), vec2(1), vec2(0, 1), col, m, vec3(0, 0, 1));
        x.m->quadFacing(V(u0, v0, rise), V(u1, v0, rise), V(u1, vm, 0.f), V(u0, vm, 0.f), vec2(0), vec2(1, 0), vec2(1), vec2(0, 1), packRGBA8(0.92f, 0.92f, 0.9f, 1),
                        makeMat(MAT_PLASTER), vec3(0, 0, -1));
        x.m->quadFacing(V(u0, vm, 0.f), V(u1, vm, 0.f), V(u1, v1, rise), V(u0, v1, rise), vec2(0), vec2(1, 0), vec2(1), vec2(0, 1), packRGBA8(0.92f, 0.92f, 0.9f, 1),
                        makeMat(MAT_PLASTER), vec3(0, 0, -1));
    } else {
        x.m->quadFacing(V(u0, v0, rise), V(um, v0, 0.f), V(um, v1, 0.f), V(u0, v1, rise), vec2(0), vec2(1, 0), vec2(1), vec2(0, 1), col, m, vec3(0, 0, 1));
        x.m->quadFacing(V(um, v0, 0.f), V(u1, v0, rise), V(u1, v1, rise), V(um, v1, 0.f), vec2(0), vec2(1, 0), vec2(1), vec2(0, 1), col, m, vec3(0, 0, 1));
        x.m->quadFacing(V(u0, v0, rise), V(um, v0, 0.f), V(um, v1, 0.f), V(u0, v1, rise), vec2(0), vec2(1, 0), vec2(1), vec2(0, 1), packRGBA8(0.92f, 0.92f, 0.9f, 1),
                        makeMat(MAT_PLASTER), vec3(0, 0, -1));
        x.m->quadFacing(V(um, v0, 0.f), V(u1, v0, rise), V(u1, v1, rise), V(um, v1, 0.f), vec2(0), vec2(1, 0), vec2(1), vec2(0, 1), packRGBA8(0.92f, 0.92f, 0.9f, 1),
                        makeMat(MAT_PLASTER), vec3(0, 0, -1));
    }
}

// The roof of a rectangle part of a volume for pitched forms (hip / gable), in the envelope frame
void pitchedPart(Ctx& x, const Env& e, vec4 r, float z, float pitch, bool hip, float over, u32 col, u32 mat, u32 gableCol, u32 gableMat, int ridge = -1) {
    float u0 = r.x, u1 = r.y, v0 = r.z, v1 = r.w;
    vec2 c = e.P((u0 + u1) * 0.5f, (v0 + v1) * 0.5f);
    pitchedRoof(x, c, e.ax, (u1 - u0) * 0.5f, (v1 - v0) * 0.5f, z, pitch, hip, over, col, mat, gableCol, gableMat, ridge);
}

// ------------------------------------------------------------------------------------------------ volumes
// Office block of an office-front warehouse (AR_WARE_OFFICE): width along the front, depth, side (+1 / -1 along ax)
inline float officeWidth(const Building& b) { return Clamp(2.f * b.hx * (0.35f + 0.2f * hashToFloat(hash32(b.seed ^ 0x0FF1CEu))), 6.f, Max(6.f, 2.f * b.hx - 8.f)); }
inline float officeDepth(const Building& b) { return Clamp(2.f * b.hy * 0.3f, 6.f, 10.f); }
inline float officeSide(const Building& b) { return (hash32(b.seed ^ 0x51DEu) & 1u) ? 1.f : -1.f; }

// Loading doors of an archetype warehouse: centres along ax (u) on the front face; returns the count
int archLoadingDoors(const Building& b, float* out, int maxN) {
    float ua = -b.hx, ub = b.hx;
    if (b.arch == AR_WARE_OFFICE) {
        float ow = officeWidth(b);
        if (officeSide(b) > 0.f) ub = b.hx - ow - 0.5f;
        else ua = -b.hx + ow + 0.5f;
    }
    float span = ub - ua;
    if (span < 4.5f) return 0;
    float pitch = b.arch == AR_WARE_BODYSHOP ? 5.5f : 14.f;
    int n = Clamp((int)(span / pitch), 1, maxN);
    for (int k = 0; k < n; k++) out[k] = ua + (k + 0.5f) * span / n;
    return n;
}

inline float arcadeDepth(const Building& b) { return Clamp(2.6f + 0.6f * hashToFloat(hash32(b.seed ^ 0xA2CADEu)), 2.6f, Max(2.6f, b.hy * 0.4f)); }

struct Plan {
    bool arcade = false;
    std::vector<Vol> vols;
    vec4 towerRect = vec4(0.f);   // corner tower footprint (u0, u1, v0, v1), zero if none
    float canopyZ = 0.f;          // MiMo entrance canopy height (0 none)
};

// Height of floor line k above the base (k = 0: ground)
inline float floorLine(const FacadeGPU& f, int k) { return k <= 0 ? 0.f : f.groundH + (k - 1) * f.floorH; }

Plan planVolumes(const Building& b, const FacadeGPU& fac, Rng& mr) {
    Plan P;
    const float hx = b.hx, hy = b.hy, z0 = b.baseZ, zTop = b.baseZ + b.height;
    const bool store = (fac.flags & 1u) != 0;
    const u32 f1 = b.facade, f2 = b.facade2 != 0xffffffffu ? b.facade2 : b.facade;
    const int floors = Max(1, (int)b.floors);
    auto vol = [&](std::vector<vec2> uv, std::vector<vec4> rects, float a, float c, u32 fac2, u8 kind, bool ground) {
        Vol v;
        v.uv = std::move(uv);
        v.rects = std::move(rects);
        v.z0 = a;
        v.z1 = c;
        v.facade = fac2;
        v.kind = kind;
        v.roof = b.roofForm;
        v.ground = ground;
        P.vols.push_back(v);
        return (int)P.vols.size() - 1;
    };
    auto full = [&](float zz0, float zz1, u32 f, u8 kind) {
        return vol(rectUV(-hx, hx, -hy, hy), {vec4(-hx, hx, -hy, hy)}, zz0, zz1, f, kind, true);
    };
    // the floor line at k floors (clamped inside the building)
    auto zAt = [&](int k) { return z0 + floorLine(fac, Clamp(k, 0, floors)); };
    bool cornerLeft = (b.archFlags & ABF_CORNER_LEFT) != 0;
    bool corner = (b.archFlags & ABF_CORNER) != 0;
    float side = corner ? (cornerLeft ? -1.f : 1.f) : (mr.chance(0.5f) ? -1.f : 1.f);
    if (b.arch == AR_SHOP_ARCADE && floors >= 2 && 2.f * hy > 12.f && b.massing != MK_CORNER_TOWER) {
        // Coral Gables arcade: the shopfronts recessed behind a colonnade, the upper floors carried over it
        float rec = arcadeDepth(b);
        float zg = zAt(1);
        vol(rectUV(-hx, hx, -hy, hy - rec), {vec4(-hx, hx, -hy, hy - rec)}, z0, zg, f1, FM_MAIN, true);
        int ui = vol(rectUV(-hx, hx, -hy, hy), {vec4(-hx, hx, -hy, hy)}, zg, zTop, f1, FM_TIER, false);
        (void)ui;
        P.arcade = true;
        return P;
    }
    if (b.arch == AR_WARE_OFFICE) {
        // a two-storey office block on one side of the street front, the shed wrapping round behind it
        float ow = officeWidth(b), od = officeDepth(b);
        float s = officeSide(b);
        float ua = s > 0.f ? hx - ow : -hx, ub = ua + ow;
        float vo = hy - od;
        float zo = Min(zTop - 0.8f, z0 + 7.4f);
        int oi = vol(rectUV(ua, ub, vo, hy), {vec4(ua, ub, vo, hy)}, z0, zo, f2, FM_PODIUM, true);
        P.vols[oi].roof = RFM_PARAPET;
        if (s > 0.f)
            vol({vec2(-hx, -hy), vec2(hx, -hy), vec2(hx, vo), vec2(ua, vo), vec2(ua, hy), vec2(-hx, hy)}, {vec4(-hx, hx, -hy, vo), vec4(-hx, ua, vo, hy)}, z0, zTop, f1,
                FM_MAIN, true);
        else
            vol({vec2(-hx, -hy), vec2(hx, -hy), vec2(hx, hy), vec2(ub, hy), vec2(ub, vo), vec2(-hx, vo)}, {vec4(-hx, hx, -hy, vo), vec4(ub, hx, vo, hy)}, z0, zTop, f1,
                FM_MAIN, true);
        return P;
    }
    switch (b.massing) {
        case MK_L: {
            // a back corner cut away (away from the street; houses keep the garage side whole)
            float cw = Clamp(2.f * hx * mr.range(0.38f, 0.55f), 0.f, 2.f * hx - 6.f), cd = Clamp(2.f * hy * mr.range(0.35f, 0.55f), 0.f, 2.f * hy - 6.f);
            if (cw < 3.f || cd < 3.f) { full(z0, zTop, f1, FM_MAIN); break; }
            float s = -side;
            if (b.style == BS_HOUSE) s = (b.seed & 64u) ? -1.f : 1.f;   // (garage wing on the +1 side when seed & 64)
            if (s > 0.f) {
                float uc = hx - cw, vc = -hy + cd;
                vol({vec2(-hx, -hy), vec2(uc, -hy), vec2(uc, vc), vec2(hx, vc), vec2(hx, hy), vec2(-hx, hy)}, {vec4(-hx, uc, -hy, hy), vec4(uc, hx, vc, hy)}, z0, zTop, f1,
                    FM_MAIN, true);
            } else {
                float uc = -hx + cw, vc = -hy + cd;
                vol({vec2(-hx, vc), vec2(uc, vc), vec2(uc, -hy), vec2(hx, -hy), vec2(hx, hy), vec2(-hx, hy)}, {vec4(uc, hx, -hy, hy), vec4(-hx, uc, vc, hy)}, z0, zTop, f1,
                    FM_MAIN, true);
            }
            break;
        }
        case MK_U: {
            // a notch in the middle: open to the back behind storefronts, open to the street for garden apartments
            float nw = Clamp(2.f * hx * mr.range(0.32f, 0.45f), 0.f, 2.f * hx - 12.f), nd = Clamp(2.f * hy * mr.range(0.4f, 0.6f), 0.f, 2.f * hy - 6.f);
            if (nw < 4.f || nd < 4.f) { full(z0, zTop, f1, FM_MAIN); break; }
            float off = mr.range(-0.15f, 0.15f) * (2.f * hx - nw - 12.f);
            float ua = off - nw * 0.5f, ub = off + nw * 0.5f;
            bool openFront = !store && b.arch == AR_MID_MIMO;
            if (!openFront) {
                float vc = -hy + nd;
                vol({vec2(-hx, -hy), vec2(ua, -hy), vec2(ua, vc), vec2(ub, vc), vec2(ub, -hy), vec2(hx, -hy), vec2(hx, hy), vec2(-hx, hy)},
                    {vec4(-hx, ua, -hy, hy), vec4(ub, hx, -hy, hy), vec4(ua, ub, vc, hy)}, z0, zTop, f1, FM_MAIN, true);
            } else {
                float vc = hy - nd;
                vol({vec2(-hx, -hy), vec2(hx, -hy), vec2(hx, hy), vec2(ub, hy), vec2(ub, vc), vec2(ua, vc), vec2(ua, hy), vec2(-hx, hy)},
                    {vec4(-hx, ua, -hy, hy), vec4(ub, hx, -hy, hy), vec4(ua, ub, -hy, vc)}, z0, zTop, f1, FM_MAIN, true);
            }
            break;
        }
        case MK_COURT: {
            float wg = mr.range(6.5f, 9.f);
            float iu = hx - wg, iv = hy - wg;
            if (iu < 2.5f || iv < 2.5f) { full(z0, zTop, f1, FM_MAIN); break; }
            int vi = vol(rectUV(-hx, hx, -hy, hy), {vec4(-hx, hx, iv, hy), vec4(-hx, hx, -hy, -iv), vec4(-hx, -iu, -iv, iv), vec4(iu, hx, -iv, iv)}, z0, zTop, f1, FM_MAIN, true);
            P.vols[vi].hole = rectUV(-iu, iu, -iv, iv);
            break;
        }
        case MK_STEP_FRONT: {
            // shops (or an office block) low along the street, the body set back behind them
            int low = Clamp(mr.irange(1, 2), 1, Max(1, floors - 1));
            float zl = zAt(low);
            float sb = Clamp(2.f * hy * mr.range(0.3f, 0.45f), 4.f, 2.f * hy - 8.f);
            if (floors < 2 || 2.f * hy < 14.f) { full(z0, zTop, f1, FM_MAIN); break; }
            u32 fb = b.facade2 != 0xffffffffu ? f2 : f1;   // the low front band's own cladding
            full(z0, zl, fb, FM_PODIUM);
            P.vols.back().top = true;
            vol(rectUV(-hx, hx, -hy, hy - sb), {vec4(-hx, hx, -hy, hy - sb)}, zl, zTop, f1, FM_TIER, false);
            break;
        }
        case MK_STEP_BACK: {
            // full height on the street, a lower rear wing
            int low = Clamp(floors - mr.irange(1, 3), 1, Max(1, floors - 1));
            if (floors < 2) {
                // one storey: the rear wing simply lower (shorter ground floor) - a step in the roofline behind the parapet
                float vb = -hy + 2.f * hy * mr.range(0.35f, 0.5f);
                full(z0, zTop - Min(1.2f, b.height * 0.25f), f1, FM_MAIN);
                vol(rectUV(-hx, hx, vb, hy), {vec4(-hx, hx, vb, hy)}, zTop - Min(1.2f, b.height * 0.25f), zTop, f1, FM_TIER, false);
                break;
            }
            float zl = zAt(low);
            float vb = -hy + 2.f * hy * mr.range(0.35f, 0.55f);
            full(z0, zl, f1, FM_MAIN);
            vol(rectUV(-hx, hx, vb, hy), {vec4(-hx, hx, vb, hy)}, zl, zTop, f1, FM_TIER, false);
            break;
        }
        case MK_SPLIT: {
            // two buildings on one lot: different heights, the second in its own cladding
            float us = -hx + 2.f * hx * mr.range(0.38f, 0.62f);
            if (us + hx < 4.f || hx - us < 4.f) { full(z0, zTop, f1, FM_MAIN); break; }
            int other = floors > 1 ? Max(1, floors - mr.irange(1, 2)) : 1;
            float zo = floors > 1 ? zAt(other) : zTop - Min(1.4f, b.height * 0.3f);
            bool tallLeft = mr.chance(0.5f);
            vol(rectUV(-hx, us, -hy, hy), {vec4(-hx, us, -hy, hy)}, z0, tallLeft ? zTop : zo, tallLeft ? f1 : f2, FM_MAIN, true);
            vol(rectUV(us, hx, -hy, hy), {vec4(us, hx, -hy, hy)}, z0, tallLeft ? zo : zTop, tallLeft ? f2 : f1, FM_MAIN, true);
            break;
        }
        case MK_CORNER_TOWER: {
            full(z0, zTop, f1, FM_MAIN);
            float ts = Clamp(Min(2.f * hx, 2.f * hy) * mr.range(0.24f, 0.34f), 3.6f, 7.f);
            int extra = mr.irange(1, 2);
            float zt = zTop + (extra == 1 ? Max(fac.floorH, 2.8f) : 2.f * Max(fac.floorH, 2.8f));
            float u0 = side > 0.f ? hx - ts : -hx, u1 = u0 + ts;
            int ti = vol(rectUV(u0, u1, hy - ts, hy), {vec4(u0, u1, hy - ts, hy)}, zTop, zt, f1, FM_WING, false);
            P.vols[ti].roof = b.roofForm == RFM_EAVE ? RFM_EAVE : (b.roofForm == RFM_PARAPET ? RFM_PARAPET : RFM_TILE_HIP);
            P.vols[0].top = true;
            P.towerRect = vec4(u0, u1, hy - ts, hy);
            break;
        }
        case MK_PODIUM_SLAB: {
            int pf = Clamp(mr.irange(2, floors > 16 ? 6 : 4), 1, Max(1, floors - 2));
            float zp = zAt(pf);
            float fi = Clamp(mr.range(3.f, 9.f), 2.f, Max(2.f, 2.f * hy - 14.f));
            float bi = Clamp(mr.range(0.f, 4.f), 0.f, Max(0.f, 2.f * hy - fi - 12.f));
            float si = Clamp(mr.range(0.f, 5.f), 0.f, Max(0.f, hx - 8.f));
            if (2.f * hy - fi - bi < 10.f || floors < 4) { full(z0, zTop, f1, FM_MAIN); break; }
            full(z0, zp, f2, FM_PODIUM);
            vol(rectUV(-hx + si, hx - si, -hy + bi, hy - fi), {vec4(-hx + si, hx - si, -hy + bi, hy - fi)}, zp, zTop, f1, FM_TIER, false);
            break;
        }
        case MK_CURVE: {
            // a bowed front: concave toward the street (the resort-hotel curve) or convex, inside the envelope
            float sag = Clamp(mr.range(2.5f, 6.f), 1.f, hy * 0.6f);
            bool concave = mr.chance(0.6f);
            std::vector<vec2> uv = {vec2(-hx, -hy), vec2(hx, -hy)};
            const int seg = 10;
            for (int k = 0; k <= seg; k++) {
                float t = (float)k / seg;
                float u = Lerp(hx, -hx, t);
                float bulge = 4.f * t * (1.f - t);   // 0 at the ends, 1 in the middle
                float v = concave ? hy - sag * bulge : hy - sag * (1.f - bulge);
                uv.push_back(vec2(u, v));
            }
            // rectangles under the curve for collision
            float vmid = hy - sag;
            vol(uv, {vec4(-hx, hx, -hy, vmid), vec4(-hx, -hx * 0.55f, vmid, concave ? hy - sag * 0.2f : hy - sag * 0.75f),
                     vec4(hx * 0.55f, hx, vmid, concave ? hy - sag * 0.2f : hy - sag * 0.75f)},
                z0, zTop, f1, FM_MAIN, true);
            break;
        }
        case MK_WINGS: {
            // a taller middle block with lower wings either side
            int low = Clamp(floors - mr.irange(1, 3), 1, Max(1, floors - 1));
            float zl = floors > 1 ? zAt(low) : zTop;
            float mw = hx * mr.range(0.35f, 0.55f);
            if (floors < 2) { full(z0, zTop, f1, FM_MAIN); break; }
            full(z0, zl, f1, FM_MAIN);
            vol(rectUV(-mw, mw, -hy, hy), {vec4(-mw, mw, -hy, hy)}, zl, zTop, f1, FM_TIER, false);
            break;
        }
        case MK_CHAMFER: {
            // the corner on the cross street cut at 45 degrees, full height
            float ch = Clamp(Min(hx, hy) * mr.range(0.3f, 0.45f), 2.f, 4.5f);
            bool left = corner ? cornerLeft : side < 0.f;
            if (left)
                vol({vec2(-hx, -hy), vec2(hx, -hy), vec2(hx, hy), vec2(-hx + ch, hy), vec2(-hx, hy - ch)}, {vec4(-hx, hx, -hy, hy - ch), vec4(-hx + ch, hx, hy - ch, hy)}, z0, zTop,
                    f1, FM_MAIN, true);
            else
                vol({vec2(-hx, -hy), vec2(hx, -hy), vec2(hx, hy - ch), vec2(hx - ch, hy), vec2(-hx, hy)}, {vec4(-hx, hx, -hy, hy - ch), vec4(-hx, hx - ch, hy - ch, hy)}, z0, zTop,
                    f1, FM_MAIN, true);
            break;
        }
        case MK_ROUNDED: {
            // streamline moderne: rounded street corners (both, or the cross-street one on a corner lot)
            float R = Clamp(Min(hx, hy) * mr.range(0.35f, 0.55f), 2.f, 6.f);
            bool rl = !corner || cornerLeft, rr = !corner || !cornerLeft;
            const int seg = 6;
            std::vector<vec2> uv = {vec2(-hx, -hy), vec2(hx, -hy)};
            if (rr)
                for (int k = 0; k <= seg; k++) {
                    float a = kPi * 0.5f * k / seg;
                    uv.push_back(vec2(hx - R + R * cosf(a), hy - R + R * sinf(a)));
                }
            else uv.push_back(vec2(hx, hy));
            if (rl)
                for (int k = 0; k <= seg; k++) {
                    float a = kPi * 0.5f + kPi * 0.5f * k / seg;
                    uv.push_back(vec2(-hx + R + R * cosf(a), hy - R + R * sinf(a)));
                }
            else uv.push_back(vec2(-hx, hy));
            vol(uv, {vec4(-hx, hx, -hy, hy - R), vec4(rl ? -hx + R : -hx, rr ? hx - R : hx, hy - R, hy)}, z0, zTop, f1, FM_MAIN, true);
            break;
        }
        default: full(z0, zTop, f1, FM_MAIN); break;
    }
    // volumes with something on their roof
    for (size_t i = 0; i < P.vols.size(); i++)
        for (size_t j = 0; j < P.vols.size(); j++)
            if (i != j && fabsf(P.vols[j].z0 - P.vols[i].z1) < 0.05f) P.vols[i].top = false;
    // a MiMo entrance canopy over the frontage
    if ((b.arch == AR_SHOP_MIMO || b.arch == AR_CONDO_MIMO || b.arch == AR_MID_OFFICE60) && mr.chance(b.arch == AR_MID_OFFICE60 ? 0.4f : 0.8f))
        P.canopyZ = z0 + Min(fac.groundH - 0.5f, b.arch == AR_CONDO_MIMO ? 4.6f : 3.7f);
    return P;
}

// Emits a volume: facade walls (with the courtyard walls), roof form, collision, the facade mass for the detail pass
void emitVolume(Ctx& x, const Building& b, const Env& e, const Vol& v, const FacadeGPU& fac, Rng& dr) {
    const float bay = (gBuildings && v.facade < gBuildings->facades.size()) ? gBuildings->facades[v.facade].bayW : fac.bayW;
    std::vector<vec2> fp = toWorld(e, v.uv);
    std::vector<vec2> hole;
    if (!v.hole.empty()) {
        hole = toWorld(e, v.hole);
        std::reverse(hole.begin(), hole.end());   // clockwise: its walls face into the courtyard
    }
    u8 rf = v.roof;
    bool pitched = rf == RFM_TILE_HIP || rf == RFM_METAL_GABLE || rf == RFM_SAWTOOTH || rf == RFM_BUTTERFLY;
    if (!v.top && pitched) rf = RFM_PARAPET;   // (a lower volume under a taller one keeps a flat roof)
    pitched = rf == RFM_TILE_HIP || rf == RFM_METAL_GABLE || rf == RFM_SAWTOOTH || rf == RFM_BUTTERFLY;
    bool parapetOn = rf == RFM_PARAPET || rf == RFM_TILE_PENT || rf == RFM_TERRACE;
    float skirt = v.ground ? 3.f : 0.f;
    const u32 roofGray = packRGBA8(0.9f, 0.9f, 0.88f, 1);
    recordMass(x, fp, v.z0, v.z1, b.baseZ, (u8)v.kind, parapetOn, v.facade);
    facadeWalls(x, fp, v.z0 - skirt, v.z1 + (parapetOn ? 1.0f : 0.f), b.baseZ, v.facade, bay);
    if (!hole.empty()) {
        recordMass(x, hole, v.z0, v.z1, b.baseZ, FM_WING, parapetOn, v.facade);
        facadeWalls(x, hole, v.z0 - skirt, v.z1 + (parapetOn ? 1.0f : 0.f), b.baseZ, v.facade, bay);
    }
    // roof
    u32 tile = b.roofTint;
    vec4 wc = unpackRGBA8(fac.wallColor);
    u32 wallTone = packRGBA8(Saturate(wc.x * 1.5f), Saturate(wc.y * 1.5f), Saturate(wc.z * 1.5f), 1.f);
    if (!hole.empty() && !pitched) {
        // ring roof between the outer outline and the courtyard (each covering rectangle)
        for (const vec4& r : v.rects) flatRoof(x, toWorld(e, rectUV(r.x, r.y, r.z, r.w)), v.z1 + 0.02f, x.roofCol, x.roofMat);
        if (parapetOn && (x.detail || x.farRoof)) {
            parapet(x, fp, v.z1, 1.0f, 0.3f, packRGBA8(0.8f, 0.8f, 0.78f, 1), makeMat(MAT_CONCRETE));
            parapet(x, hole, v.z1, 1.0f, 0.3f, packRGBA8(0.8f, 0.8f, 0.78f, 1), makeMat(MAT_CONCRETE));
        }
    } else {
        switch (rf) {
            case RFM_EAVE: eaveSlab(x, fp, v.z1, b.style == BS_HOUSE || b.style == BS_VILLA ? 0.9f : 0.75f, 0.28f, wallTone); break;
            case RFM_TILE_HIP:
                for (const vec4& r : v.rects) pitchedPart(x, e, r, v.z1, 0.36f, true, 0.45f, tile, makeMat(MAT_ROOF_TILE), wallTone, makeMat(MAT_PLASTER));
                break;
            case RFM_METAL_GABLE: {
                // (a tin hip roof on the Keys motels that blockstyle.cpp gives one)
                const bool metalHip = b.style == BS_MOTEL && b.roof == ROOF_HIP;
                for (const vec4& r : v.rects)
                    pitchedPart(x, e, r, v.z1, metalHip ? 0.42f : 0.5f, metalHip, 0.4f, tile, makeMat(MAT_ROOF_METAL), wallTone, makeMat((u32)fac.wallLayer));
                break;
            }
            case RFM_SAWTOOTH:
                for (const vec4& r : v.rects) sawtoothRoof(x, e, r.x, r.y, r.z, r.w, v.z1, packRGBA8(0.7f, 0.71f, 0.72f, 1), wallTone, makeMat((u32)fac.wallLayer));
                break;
            case RFM_BUTTERFLY:
                for (const vec4& r : v.rects) butterflyRoof(x, e, r.x, r.y, r.z, r.w, v.z1, 0.8f, packRGBA8(0.85f, 0.86f, 0.87f, 1));
                break;
            case RFM_MANSARD: {
                vec3 sc = vec3(0.32f, 0.26f, 0.22f) * (0.85f + 0.3f * hashToFloat(hash32(b.seed ^ 0x3A45u)));
                if (hash32(b.seed ^ 0x3A46u) & 1u) sc = vec3(0.22f, 0.23f, 0.25f);
                mansardRoof(x, fp, v.z1, 1.25f, packRGBA8(sc.x, sc.y, sc.z, 1), x.roofCol, x.roofMat);
                break;
            }
            default:
                flatRoof(x, fp, v.z1 + 0.02f, x.roofCol, x.roofMat);
                if (parapetOn && (x.detail || x.farRoof)) parapet(x, fp, v.z1, rf == RFM_TERRACE ? 0.6f : 1.0f, 0.3f, packRGBA8(0.8f, 0.8f, 0.78f, 1), makeMat(MAT_CONCRETE));
                break;
        }
        // tile pent roof along the street front (and the cross-street side of a corner lot)
        if (rf == RFM_TILE_PENT) {
            int n = (int)fp.size();
            for (int i = 0; i < n; i++) {
                vec2 a = fp[i], c = fp[(i + 1) % n];
                vec2 t = c - a;
                float len = length(t);
                if (len < 2.f) continue;
                vec2 nn(t.y / len, -t.x / len);
                bool front = dot(nn, b.front) > 0.9f;
                bool sideStreet = (b.archFlags & ABF_CORNER) && fabsf(dot(nn, b.ax)) > 0.9f && dot(nn, b.ax) * ((b.archFlags & ABF_CORNER_LEFT) ? -1.f : 1.f) > 0.f;
                if (front || sideStreet) pentRoof(x, a, c, v.z1 + 1.0f, 0.75f, tile);
            }
        }
    }
    // collision per covering rectangle
    for (const vec4& r : v.rects) {
        vec2 cc = e.P((r.x + r.y) * 0.5f, (r.z + r.w) * 0.5f);
        addCollision(x, cc, e.ax, (r.y - r.x) * 0.5f, (r.w - r.z) * 0.5f, v.z0 - (v.ground ? 3.f : 0.f), v.z1 + (pitched ? 1.5f : 0.f));
    }
    (void)dr;
}

// Roof terrace: a pergola, planters and umbrellas on part of the top roof; glass railing on the low parapet
void roofTerrace(Ctx& x, const Env& e, const vec4& r, float z, Rng& dr) {
    if (!x.detail) return;
    float u0 = r.x + 1.f, u1 = r.y - 1.f, v0 = r.z + 1.f, v1 = r.w - 1.f;
    if (u1 - u0 < 4.f || v1 - v0 < 4.f) return;
    vec3 X(e.ax, 0.f), Y(perp(e.ax), 0.f), Z(0, 0, 1);
    // decking
    float du0 = u0, du1 = Lerp(u0, u1, dr.range(0.45f, 0.75f)), dv0 = v0, dv1 = v1;
    flatRoof(x, toWorld(e, rectUV(du0, du1, dv0, dv1)), z + 0.06f, packRGBA8(0.75f, 0.6f, 0.45f, 1), makeMat(MAT_WOOD));
    // pergola over part of it
    float pu0 = du0 + 0.5f, pu1 = Min(du1 - 0.5f, pu0 + dr.range(3.5f, 6.f)), pv0 = dv0 + 0.5f, pv1 = Min(dv1 - 0.5f, pv0 + dr.range(3.f, 5.f));
    u32 wood = packRGBA8(0.45f, 0.33f, 0.22f, 1), wm = makeMat(MAT_WOOD);
    for (int k = 0; k < 4; k++) {
        vec2 p = e.P((k & 1) ? pu1 : pu0, (k & 2) ? pv1 : pv0);
        x.m->box(vec3(p, z + 1.25f) - x.org, X, Y, Z, vec3(0.08f, 0.08f, 1.25f), wood, wm);
    }
    for (float u = pu0; u <= pu1 + 0.01f; u += 0.6f) {
        vec2 p = e.P(u, (pv0 + pv1) * 0.5f);
        x.m->box(vec3(p, z + 2.55f) - x.org, X, Y, Z, vec3(0.04f, (pv1 - pv0) * 0.5f + 0.25f, 0.08f), wood, wm);
    }
    // planters with shrubs along one edge, umbrellas over tables elsewhere
    int np = dr.irange(2, 4);
    for (int k = 0; k < np; k++) {
        float u = Lerp(du0 + 0.6f, du1 - 0.6f, (k + 0.5f) / np);
        vec2 p = e.P(u, dv1 - 0.35f);
        x.m->box(vec3(p, z + 0.35f) - x.org, X, Y, Z, vec3(0.5f, 0.3f, 0.35f), packRGBA8(0.75f, 0.74f, 0.7f, 1), makeMat(MAT_CONCRETE));
        leafBlobEx(*x.m, x.org, vec3(p, z + 0.95f), X, Y, vec3(0.5f, 0.32f, 0.35f), vec3(0.6f, 0.95f, 0.45f), dr.next(), 0.05f, 8, 5, vec3(-1.f));
    }
    if (x.props && (u1 - du1) > 3.f) {
        int nu = dr.irange(1, 3);
        for (int k = 0; k < nu; k++) {
            PropInstance pi;
            vec2 p = e.P(Lerp(du1 + 1.2f, u1 - 1.f, (k + 0.5f) / nu), Lerp(v0 + 1.f, v1 - 1.f, dr.f()));
            pi.pos = vec3(p, z);
            pi.yaw = dr.f() * kTwoPi;
            pi.scale = 0.85f;
            pi.type = PROP_UMBRELLA;
            pi.variant = (u8)dr.irange(0, 3);
            pi.flags = 0;
            x.props->push_back(pi);
        }
    }
}

// MiMo entrance canopy: a thin cantilevered slab across the frontage, its edge raked
void mimoCanopy(Ctx& x, const Building& b, const Env& e, float z, Rng& mr) {
    float w = Min(b.hx * mr.range(0.6f, 0.95f), b.hx - 0.3f), dep = mr.range(1.8f, 2.8f);
    float off = (b.archFlags & ABF_CORNER) ? ((b.archFlags & ABF_CORNER_LEFT) ? -1.f : 1.f) * (b.hx - w) : mr.range(-1.f, 1.f) * (b.hx - w);
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    vec2 c = e.P(off, b.hy + dep * 0.5f);
    vec4 wc = unpackRGBA8(gBuildings ? gBuildings->facades[b.facade].frameColor : 0xffffffffu);
    u32 edge = (b.archFlags & ABF_ACCENT) ? packRGBA8(wc.x, wc.y, wc.z, 1) : packRGBA8(0.96f, 0.96f, 0.95f, 1);
    x.m->box(vec3(c, z + 0.12f) - x.org, X, Y, Z, vec3(w, dep * 0.5f, 0.12f), packRGBA8(0.95f, 0.95f, 0.94f, 1), makeMat(MAT_PLASTER), true);
    // raked fascia band on the edge (taller at one end: the "atomic" wedge)
    vec2 a0 = e.P(off - w, b.hy + dep), a1 = e.P(off + w, b.hy + dep);
    float h0 = 0.35f, h1 = mr.chance(0.5f) ? 0.9f : 0.35f;
    x.m->quadFacing(vec3(a0, z - 0.02f) - x.org, vec3(a1, z - 0.02f) - x.org, vec3(a1, z + h1) - x.org, vec3(a0, z + h0) - x.org, vec2(0), vec2(1, 0), vec2(1), vec2(0, 1), edge,
                    makeMat(MAT_PLASTER), vec3(e.fr, 0.f));
    // (cantilevered: no posts, which would stand on the sidewalk)
}

}  // namespace massing

// Archetype building (non-house): volumes, roofs, rooftop dressing, canopies. Returns false to fall back to the plain
// generator (no archetype, interiors).
namespace massing {

// Barns of the farm regions: a gambrel roof with the big door and a hay door in the gable end facing the yard, an open
// pole barn (machine shed), a steep gable barn with a cupola; a lean-to shed along one side. The gable ends face the
// street side of the lot (Building::front).
void buildArchBarn(Ctx& x, const Building& b, const FacadeGPU& fac) {
    Rng mr(b.seed ^ 0xBA4Bu);
    Env e = envOf(b);
    const float hx = b.hx, hy = b.hy, z0 = b.baseZ, zt = z0 + b.height;
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    vec4 wl = unpackRGBA8(fac.wallColor);
    const u32 wallTone = packRGBA8(Saturate(wl.x * 1.45f), Saturate(wl.y * 1.45f), Saturate(wl.z * 1.45f), 1);
    const u32 wmat = makeMat((u32)fac.wallLayer), trim = packRGBA8(0.95f, 0.95f, 0.93f, 1), post = packRGBA8(0.5f, 0.45f, 0.38f, 1);
    const vec3 roofs[] = {vec3(0.8f, 0.81f, 0.83f), vec3(0.55f, 0.22f, 0.18f), vec3(0.3f, 0.45f, 0.35f), vec3(0.5f, 0.36f, 0.26f), vec3(0.62f, 0.63f, 0.65f)};
    vec3 rc = roofs[mr.next() % 5u];
    const u32 roofCol = packRGBA8(rc.x, rc.y, rc.z, 1), roofMat = makeMat(MAT_ROOF_METAL);
    const bool leanTo = b.arch != AR_BARN_POLE && (b.massing == MK_WINGS || mr.chance(0.35f));
    const float ls = mr.chance(0.5f) ? 1.f : -1.f;
    const float ld = mr.range(3.f, 4.2f);
    auto wallQuad = [&](vec2 a, vec2 c, float za, float zb2, u32 col, u32 mat, vec2 out) {
        float len = length(c - a);
        x.m->quadFacing(vec3(a, za) - x.org, vec3(c, za) - x.org, vec3(c, zb2) - x.org, vec3(a, zb2) - x.org, vec2(0, 0), vec2(len, 0), vec2(len, zb2 - za),
                        vec2(0, zb2 - za), col, mat, vec3(out, 0.f));
    };
    // a convex polygon in the vertical plane at v = vf (the gable end), facing dir
    auto gableEnd = [&](float vf, const std::vector<vec2>& uz, vec2 dir) {
        std::vector<u32> idx;
        for (const vec2& q : uz) idx.push_back(x.m->addVertex(vec3(e.P(q.x, vf), q.y) - x.org, vec3(dir, 0.f), X, vec2(q.x, q.y - z0), wallTone, wmat));
        for (size_t i = 1; i + 1 < idx.size(); i++) {
            vec3 p0 = x.m->verts[idx[0]].pos, p1 = x.m->verts[idx[i]].pos, p2 = x.m->verts[idx[i + 1]].pos;
            if (dot(cross(p1 - p0, p2 - p0), vec3(dir, 0.f)) >= 0.f) x.m->tri(idx[0], idx[i], idx[i + 1]);
            else x.m->tri(idx[0], idx[i + 1], idx[i]);
        }
    };
    if (b.arch == AR_BARN_POLE) {
        // closed back and one end in corrugated sheet, posts along the open front, a low gable roof, a concrete pad
        float es = mr.chance(0.5f) ? 1.f : -1.f;
        vec2 bl = e.P(-hx, -hy), br = e.P(hx, -hy), el0 = e.P(es * hx, -hy), el1 = e.P(es * hx, hy);
        wallQuad(bl, br, z0 - 0.3f, zt, wallTone, wmat, -e.fr);
        wallQuad(br, bl, z0 - 0.3f, zt, wallTone, wmat, e.fr);
        wallQuad(el0, el1, z0 - 0.3f, zt, wallTone, wmat, e.ax * es);
        wallQuad(el1, el0, z0 - 0.3f, zt, wallTone, wmat, -e.ax * es);
        addCollision(x, e.P(0.f, -hy + 0.05f), e.ax, hx, 0.08f, z0 - 1.f, zt);
        addCollision(x, e.P(es * (hx - 0.05f), 0.f), e.ax, 0.08f, hy, z0 - 1.f, zt);
        int np = Max(2, (int)roundf(2.f * hx / 4.5f) + 1);
        for (int k = 0; k < np; k++) {
            vec2 p = e.P(Lerp(-hx + 0.15f, hx - 0.15f, (float)k / (np - 1)), hy - 0.15f);
            x.m->box(vec3(p, (z0 + zt) * 0.5f) - x.org, X, Y, Z, vec3(0.12f, 0.12f, (zt - z0) * 0.5f), post, makeMat(MAT_WOOD));
            addCollision(x, p, e.ax, 0.13f, 0.13f, z0 - 1.f, zt);
        }
        // beams along the front and the middle
        x.m->box(vec3(e.P(0.f, hy - 0.15f), zt - 0.15f) - x.org, X, Y, Z, vec3(hx, 0.1f, 0.15f), post, makeMat(MAT_WOOD));
        // pad
        x.m->box(vec3(e.P(0.f, 0.f), z0 - 0.1f) - x.org, X, Y, Z, vec3(hx + 0.2f, hy + 0.2f, 0.14f), packRGBA8(0.72f, 0.7f, 0.66f, 1), makeMat(MAT_CONCRETE), false);
        pitchedPart(x, e, vec4(-hx, hx, -hy, hy), zt, mr.range(0.2f, 0.3f), false, 0.5f, roofCol, roofMat, wallTone, wmat, hx >= hy ? 0 : 1);
        return;
    }
    // walls (the barn's facade grid: board siding, a few high windows), recorded for the detail pass
    std::vector<vec2> fp = toWorld(e, rectUV(-hx, hx, -hy, hy));
    recordMass(x, fp, z0, zt, z0, FM_MAIN, false);
    facadeWalls(x, fp, z0 - 1.f, zt, z0, b.facade, fac.bayW);
    float rTop;
    if (b.arch == AR_BARN_GAMBREL) {
        // gambrel across u (the ridge runs toward the street): steep lower slopes to the knee, shallow upper slopes
        float ov = 0.35f, uk = hx * 0.55f, hk = (hx - uk) * 1.7f, hr = uk * 0.45f;
        float zk = zt + hk, zr = zk + hr;
        rTop = zr;
        for (int sd = -1; sd <= 1; sd += 2) {
            float u0 = sd * (hx + ov), u1 = sd * uk;
            float z0e = zt - ov * 1.7f;
            vec3 a0 = vec3(e.P(u0, -hy - ov), z0e) - x.org, a1 = vec3(e.P(u0, hy + ov), z0e) - x.org;
            vec3 k0 = vec3(e.P(u1, -hy - ov), zk) - x.org, k1 = vec3(e.P(u1, hy + ov), zk) - x.org;
            vec3 r0 = vec3(e.P(0.f, -hy - ov), zr) - x.org, r1 = vec3(e.P(0.f, hy + ov), zr) - x.org;
            vec3 n1 = normalize(vec3(e.ax * (float)sd * hk, hx + ov - uk)), n2 = normalize(vec3(e.ax * (float)sd * hr, uk));
            float l1 = length(k0 - a0), l2 = length(r0 - k0), L = 2.f * (hy + ov);
            x.m->quadFacing(a0, a1, k1, k0, vec2(0, 0), vec2(L, 0), vec2(L, l1), vec2(0, l1), roofCol, roofMat, n1);
            x.m->quadFacing(a0, k0, k1, a1, vec2(0, 0), vec2(l1, 0), vec2(l1, L), vec2(0, L), post, makeMat(MAT_WOOD), -n1);
            x.m->quadFacing(k0, k1, r1, r0, vec2(0, 0), vec2(L, 0), vec2(L, l2), vec2(0, l2), roofCol, roofMat, n2);
            x.m->quadFacing(k0, r0, r1, k1, vec2(0, 0), vec2(l2, 0), vec2(l2, L), vec2(0, L), post, makeMat(MAT_WOOD), -n2);
        }
        for (int sv = -1; sv <= 1; sv += 2)
            gableEnd(sv * hy, {vec2(-hx, zt), vec2(hx, zt), vec2(uk, zk), vec2(0.f, zr), vec2(-uk, zk)}, e.fr * (float)sv);
    } else {
        // steep gable with the ridge toward the street, a cupola on the ridge
        float ov = 0.4f, pitch = mr.range(0.75f, 1.f);
        float zr = zt + hx * pitch;
        rTop = zr;
        pitchedPart(x, e, vec4(-hx, hx, -hy, hy), zt, pitch, false, ov, roofCol, roofMat, wallTone, wmat, 1);
        if (mr.chance(0.6f)) {
            vec2 cc = e.P(0.f, mr.range(-0.3f, 0.3f) * hy);
            float cs = Clamp(hx * 0.18f, 0.8f, 1.3f);
            std::vector<vec2> cfp = toWorld(e, rectUV(-cs, cs, -cs, cs));
            for (vec2& q : cfp) q = q - e.c + cc;
            plainWalls(x, cfp, zr - 0.6f, zr + 1.1f, trim, makeMat(MAT_WOOD_SIDING));
            pitchedRoof(x, cc, e.ax, cs, cs, zr + 1.1f, 0.9f, true, 0.2f, roofCol, roofMat, trim, makeMat(MAT_PLASTER));
        }
    }
    addCollision(x, e.c, e.ax, hx, hy, z0 - 2.f, rTop);
    // the big door in the front gable end (white X-braced frame) and a hay door above it
    {
        float dw = Clamp(hx * 0.7f, 1.8f, 2.6f), dh = Min(zt - z0 - 0.6f, 4.2f);
        vec2 dc = e.P(0.f, hy + 0.04f);
        x.m->box(vec3(dc, z0 + dh * 0.5f) - x.org, X, Y, Z, vec3(dw, 0.04f, dh * 0.5f), wallTone, wmat);
        if (x.detail) {
            x.m->box(vec3(dc + e.fr * 0.05f, z0 + dh) - x.org, X, Y, Z, vec3(dw + 0.1f, 0.05f, 0.1f), trim, makeMat(MAT_PLASTER));
            for (int sd = -1; sd <= 1; sd += 2) {
                x.m->box(vec3(dc + e.fr * 0.05f + e.ax * (sd * dw), z0 + dh * 0.5f) - x.org, X, Y, Z, vec3(0.1f, 0.05f, dh * 0.5f), trim, makeMat(MAT_PLASTER));
                x.m->box(vec3(dc + e.fr * 0.05f, z0 + dh * 0.5f) - x.org, X, Y, Z, vec3(0.06f, 0.05f, dh * 0.5f), trim, makeMat(MAT_PLASTER));
                // the X braces of each leaf
                vec2 lc = dc + e.fr * 0.06f + e.ax * (sd * dw * 0.5f);
                for (int dg = -1; dg <= 1; dg += 2) {
                    vec3 dir = normalize(vec3(e.ax * (dw * (float)dg), dh));
                    vec3 up = normalize(cross(Y, dir));
                    if (up.z < 0.f) up = -up;
                    x.m->box(vec3(lc, z0 + dh * 0.5f) - x.org, dir, Y, up, vec3(sqrtf(dw * dw + dh * dh) * 0.5f - 0.1f, 0.03f, 0.07f), trim, makeMat(MAT_PLASTER));
                }
            }
            float hz = z0 + dh + 1.4f;
            if (hz + 0.8f < rTop - 0.8f) {
                x.m->box(vec3(dc, hz + 0.5f) - x.org, X, Y, Z, vec3(0.7f, 0.05f, 0.6f), packRGBA8(0.25f, 0.2f, 0.16f, 1), makeMat(MAT_WOOD));
                x.m->box(vec3(dc + e.fr * 0.05f, hz + 0.5f) - x.org, X, Y, Z, vec3(0.8f, 0.04f, 0.7f), trim, makeMat(MAT_PLASTER));
            }
            // corner boards
            for (int su = -1; su <= 1; su += 2)
                for (int sv = -1; sv <= 1; sv += 2)
                    x.m->box(vec3(e.P(su * (hx + 0.02f), sv * (hy + 0.02f)), (z0 + zt) * 0.5f) - x.org, X, Y, Z, vec3(0.1f, 0.1f, (zt - z0) * 0.5f), trim, makeMat(MAT_PLASTER));
        }
    }
    // lean-to shed along one side: a mono-pitch roof off the wall, open on posts or closed in the barn's boards
    if (leanTo) {
        float zh = zt - 0.3f, zl = Max(z0 + 2.4f, zh - ld * 0.35f);
        float u0 = ls * hx, u1 = ls * (hx + ld);
        vec3 a0 = vec3(e.P(u0, -hy), zh) - x.org, a1 = vec3(e.P(u0, hy), zh) - x.org, b0 = vec3(e.P(u1, -hy - 0.2f), zl) - x.org, b1 = vec3(e.P(u1, hy + 0.2f), zl) - x.org;
        vec3 n = normalize(vec3(e.ax * (ls * (zh - zl)), ld));
        x.m->quadFacing(a0, a1, b1, b0, vec2(0, 0), vec2(2.f * hy, 0), vec2(2.f * hy, ld), vec2(0, ld), roofCol, roofMat, n);
        x.m->quadFacing(a0, b0, b1, a1, vec2(0, 0), vec2(ld, 0), vec2(ld, 2.f * hy), vec2(0, 2.f * hy), post, makeMat(MAT_WOOD), -n);
        int np = Max(2, (int)roundf(2.f * hy / 3.5f) + 1);
        for (int k = 0; k < np; k++) {
            vec2 p = e.P(ls * (hx + ld - 0.15f), Lerp(-hy + 0.15f, hy - 0.15f, (float)k / (np - 1)));
            x.m->box(vec3(p, (z0 + zl) * 0.5f) - x.org, X, Y, Z, vec3(0.1f, 0.1f, (zl - z0) * 0.5f), post, makeMat(MAT_WOOD));
            addCollision(x, p, e.ax, 0.11f, 0.11f, z0 - 1.f, zl);
        }
    }
}

// Churches: the nave's gable toward the street (its long axis along the lot's depth), by type: a mission church with a
// stepped front gable and a corner bell tower, a white board church with a central steeple, a brick Gothic church with a
// pinnacled corner tower, a sixties A-frame with a glass gable and a free-standing bell pylon
void buildArchChurch(Ctx& x, const Building& b, const FacadeGPU& fac) {
    Rng mr(b.seed ^ 0xC4A4u);
    Env e = envOf(b);
    const float hx = b.hx, hy = b.hy, z0 = b.baseZ, zt = z0 + b.height;
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    vec4 wl = unpackRGBA8(fac.wallColor);
    const u32 wallTone = packRGBA8(Saturate(wl.x * 1.45f), Saturate(wl.y * 1.45f), Saturate(wl.z * 1.45f), 1);
    const u32 wmat = makeMat((u32)fac.wallLayer), white = packRGBA8(0.96f, 0.96f, 0.94f, 1);
    const float ts = mr.chance(0.5f) ? 1.f : -1.f;   // the tower's side
    std::vector<vec2> fp = toWorld(e, rectUV(-hx, hx, -hy, hy));
    auto tower = [&](float u0, float u1, float v0, float v1, float za, float zb2, u32 col, u32 mat) {
        std::vector<vec2> tfp = toWorld(e, rectUV(u0, u1, v0, v1));
        plainWalls(x, tfp, za, zb2, col, mat);
        addCollision(x, e.P((u0 + u1) * 0.5f, (v0 + v1) * 0.5f), e.ax, (u1 - u0) * 0.5f, (v1 - v0) * 0.5f, z0 - 1.f, zb2);
    };
    if (b.arch == AR_CHURCH_AFRAME) {
        // the roof planes from just above the ground to the ridge; glass in the front gable, the back gable walled
        float ov = 0.6f, ze = z0 + 0.9f, zr = ze + (hx + ov) * 2.1f;
        u32 rc = packRGBA8(0.32f, 0.3f, 0.3f, 1), rmat = makeMat(MAT_ROOF_SHINGLE);
        if (mr.chance(0.4f)) rc = packRGBA8(0.75f, 0.76f, 0.78f, 1), rmat = makeMat(MAT_ROOF_METAL);
        for (int sd = -1; sd <= 1; sd += 2) {
            vec3 a0 = vec3(e.P(sd * (hx + ov), -hy - 0.4f), ze) - x.org, a1 = vec3(e.P(sd * (hx + ov), hy + 0.4f), ze) - x.org;
            vec3 r0 = vec3(e.P(0.f, -hy - 0.4f), zr) - x.org, r1 = vec3(e.P(0.f, hy + 0.4f), zr) - x.org;
            vec3 n = normalize(vec3(e.ax * ((float)sd * (zr - ze)), hx + ov));
            float L = 2.f * hy + 0.8f, sl = length(r0 - a0);
            x.m->quadFacing(a0, a1, r1, r0, vec2(0, 0), vec2(L, 0), vec2(L, sl), vec2(0, sl), rc, rmat, n);
            x.m->quadFacing(a0, r0, r1, a1, vec2(0, 0), vec2(sl, 0), vec2(sl, L), vec2(0, L), packRGBA8(0.55f, 0.42f, 0.3f, 1), makeMat(MAT_WOOD), -n);
            // the low side walls under the eaves
            vec2 w0 = e.P(sd * hx, -hy), w1 = e.P(sd * hx, hy);
            x.m->quadFacing(vec3(w0, z0 - 0.5f) - x.org, vec3(w1, z0 - 0.5f) - x.org, vec3(w1, ze + 0.25f) - x.org, vec3(w0, ze + 0.25f) - x.org, vec2(0, 0),
                            vec2(2.f * hy, 0), vec2(2.f * hy, 1.6f), vec2(0, 1.6f), wallTone, wmat, vec3(e.ax * (float)sd, 0.f));
        }
        // gable ends: the front glazed (with a cross of mullions up close), the back in the wall finish
        for (int sv = -1; sv <= 1; sv += 2) {
            float v = sv * hy;
            vec3 p0 = vec3(e.P(-hx, v), z0 - 0.3f) - x.org, p1 = vec3(e.P(hx, v), z0 - 0.3f) - x.org;
            vec3 p2 = vec3(e.P(hx, v), ze + (ov) * 2.1f) - x.org, p3 = vec3(e.P(0.f, v), zr - 0.5f) - x.org, p4 = vec3(e.P(-hx, v), ze + (ov) * 2.1f) - x.org;
            vec3 nn(e.fr * (float)sv, 0.f);
            u32 col = sv > 0 ? packRGBA8(0.35f, 0.42f, 0.48f, 1) : wallTone, mat = sv > 0 ? makeMat(MAT_GLASS) : wmat;
            vec3 pts[5] = {p0, p1, p2, p3, p4};
            u32 idx[5];
            for (int k = 0; k < 5; k++) idx[k] = x.m->addVertex(pts[k], nn, X, vec2(k, 0), col, mat);
            for (int k = 1; k + 1 < 5; k++) {
                if (dot(cross(pts[k] - pts[0], pts[k + 1] - pts[0]), nn) >= 0.f) x.m->tri(idx[0], idx[k], idx[k + 1]);
                else x.m->tri(idx[0], idx[k + 1], idx[k]);
            }
            if (sv > 0 && x.detail) {
                x.m->box(vec3(e.P(0.f, v + 0.05f), (z0 + zr - 0.5f) * 0.5f) - x.org, X, Y, Z, vec3(0.12f, 0.06f, (zr - 0.5f - z0) * 0.5f), white, makeMat(MAT_PLASTER));
                x.m->box(vec3(e.P(0.f, v + 0.05f), z0 + (zr - z0) * 0.62f) - x.org, X, Y, Z, vec3(hx * 0.5f, 0.06f, 0.1f), white, makeMat(MAT_PLASTER));
            }
        }
        addCollision(x, e.c, e.ax, hx + ov, hy, z0 - 1.f, zr);
        // the free-standing bell pylon beside the front corner, a cross on top
        vec2 pp = e.P(ts * (hx + 2.4f), hy - 1.f);
        float ph = mr.range(10.f, 14.f);
        x.m->box(vec3(pp, z0 + ph * 0.5f - 0.5f) - x.org, X, Y, Z, vec3(0.35f, 0.7f, ph * 0.5f + 0.5f), packRGBA8(0.85f, 0.84f, 0.8f, 1), makeMat(MAT_CONCRETE));
        x.m->box(vec3(pp, z0 + ph + 1.f) - x.org, X, Y, Z, vec3(0.08f, 0.08f, 1.f), white, makeMat(MAT_METAL_PAINTED));
        x.m->box(vec3(pp, z0 + ph + 1.4f) - x.org, X, Y, Z, vec3(0.08f, 0.5f, 0.08f), white, makeMat(MAT_METAL_PAINTED));
        addCollision(x, pp, e.ax, 0.36f, 0.71f, z0 - 1.f, z0 + ph);
        return;
    }
    recordMass(x, fp, z0, zt, z0, FM_MAIN, false);
    facadeWalls(x, fp, z0 - 1.f, zt, z0, b.facade, fac.bayW);
    addCollision(x, e.c, e.ax, hx, hy, z0 - 1.f, zt + hx);
    if (b.arch == AR_CHURCH_MISSION) {
        const float pitch = 0.32f;
        pitchedPart(x, e, vec4(-hx, hx, -hy, hy), zt, pitch, false, 0.45f, b.roofTint, makeMat(MAT_ROOF_TILE), wallTone, wmat, 1);
        // the stepped front gable (espadana) rising above the roof line, a niche bell in its top
        float zApex = zt + hx * pitch;
        float w0 = hx * 0.75f, w1 = hx * 0.45f, w2 = hx * 0.22f;
        vec2 fc = e.P(0.f, hy - 0.2f);
        x.m->box(vec3(fc, (zt + zApex + 1.2f) * 0.5f) - x.org, X, Y, Z, vec3(w0, 0.22f, (zApex + 1.2f - zt) * 0.5f), wallTone, wmat);
        x.m->box(vec3(fc, zApex + 1.9f) - x.org, X, Y, Z, vec3(w1, 0.22f, 0.7f), wallTone, wmat);
        x.m->box(vec3(fc, zApex + 3.1f) - x.org, X, Y, Z, vec3(w2, 0.22f, 0.5f), wallTone, wmat);
        if (x.detail) x.m->box(vec3(fc + e.fr * 0.12f, zApex + 1.9f) - x.org, X, Y, Z, vec3(0.45f, 0.12f, 0.45f), packRGBA8(0.12f, 0.1f, 0.08f, 1), makeMat(MAT_PLASTER));
        // the bell tower on a front corner: a belfry stage on four piers, a tile hip cap
        float tsz = Clamp(hx * 0.32f, 1.8f, 2.8f);
        float u0 = ts > 0.f ? hx - 2.f * tsz : -hx, u1 = u0 + 2.f * tsz, v1 = hy + 0.3f, v0 = v1 - 2.f * tsz;
        float zb1 = zt + mr.range(3.5f, 5.5f), zb2 = zb1 + 3.f;
        tower(u0, u1, v0, v1, z0 - 1.f, zb1, wallTone, wmat);
        for (int i = 0; i < 2; i++)
            for (int j = 0; j < 2; j++) {
                vec2 pc = e.P(i ? u1 - 0.35f : u0 + 0.35f, j ? v1 - 0.35f : v0 + 0.35f);
                x.m->box(vec3(pc, (zb1 + zb2) * 0.5f) - x.org, X, Y, Z, vec3(0.35f, 0.35f, (zb2 - zb1) * 0.5f), wallTone, wmat);
            }
        x.m->box(vec3(e.P((u0 + u1) * 0.5f, (v0 + v1) * 0.5f), zb2 + 0.15f) - x.org, X, Y, Z, vec3(tsz + 0.1f, tsz + 0.1f, 0.15f), wallTone, wmat, true);
        pitchedPart(x, e, vec4(u0, u1, v0, v1), zb2 + 0.3f, 0.55f, true, 0.25f, b.roofTint, makeMat(MAT_ROOF_TILE), wallTone, wmat);
        if (x.detail) x.m->box(vec3(e.P((u0 + u1) * 0.5f, (v0 + v1) * 0.5f), zb1 + 1.f) - x.org, X, Y, Z, vec3(0.4f, 0.4f, 0.5f), packRGBA8(0.55f, 0.42f, 0.2f, 1), makeMat(MAT_METAL_BRUSHED));
    } else if (b.arch == AR_CHURCH_CLAPBOARD) {
        u32 rc = mr.chance(0.6f) ? packRGBA8(0.3f, 0.3f, 0.32f, 1) : packRGBA8(0.3f, 0.4f, 0.32f, 1);
        pitchedPart(x, e, vec4(-hx, hx, -hy, hy), zt, mr.range(0.8f, 1.f), false, 0.4f, rc, makeMat(MAT_ROOF_SHINGLE), white, makeMat(MAT_WOOD_SIDING), 1);
        // the steeple over the front: a square base, an octagonal belfry, a spire
        float sb = Clamp(hx * 0.3f, 1.5f, 2.1f);
        float vc = hy - sb - 0.2f;
        float zs1 = zt + hx * 0.9f + mr.range(1.5f, 3.f);
        tower(-sb, sb, vc - sb, vc + sb, zt - 0.5f, zs1, white, makeMat(MAT_WOOD_SIDING));
        x.m->box(vec3(e.P(0.f, vc), zs1 + 0.1f) - x.org, X, Y, Z, vec3(sb + 0.15f, sb + 0.15f, 0.12f), white, makeMat(MAT_PLASTER), true);
        float rb = sb * 0.8f;
        x.m->cylinder(vec3(e.P(0.f, vc), zs1 + 0.2f) - x.org, rb, rb, 2.4f, 8, white, makeMat(MAT_WOOD_SIDING), false);
        if (x.detail) x.m->cylinder(vec3(e.P(0.f, vc), zs1 + 0.8f) - x.org, rb + 0.02f, rb + 0.02f, 1.2f, 8, packRGBA8(0.15f, 0.15f, 0.16f, 1), makeMat(MAT_WOOD), false);
        x.m->cylinder(vec3(e.P(0.f, vc), zs1 + 2.6f) - x.org, rb + 0.05f, 0.04f, mr.range(6.f, 9.f), 8, mr.chance(0.6f) ? white : rc, makeMat(MAT_ROOF_SHINGLE), false);
    } else {
        // brick Gothic: a steep slate roof, a square corner tower with corner pinnacles
        u32 rc = packRGBA8(0.28f, 0.29f, 0.31f, 1);
        pitchedPart(x, e, vec4(-hx, hx, -hy, hy), zt, mr.range(0.95f, 1.15f), false, 0.35f, rc, makeMat(MAT_ROOF_SHINGLE), wallTone, wmat, 1);
        float tsz = Clamp(hx * 0.36f, 2.f, 3.f);
        float u0 = ts > 0.f ? hx - 2.f * tsz + 0.6f : -hx - 0.6f, u1 = u0 + 2.f * tsz, v1 = hy + 0.6f, v0 = v1 - 2.f * tsz;
        float zT = zt + hx * 1.05f + mr.range(3.f, 6.f);
        tower(u0, u1, v0, v1, z0 - 1.f, zT, wallTone, wmat);
        flatRoof(x, toWorld(e, rectUV(u0, u1, v0, v1)), zT, packRGBA8(0.5f, 0.5f, 0.5f, 1), makeMat(MAT_CONCRETE));
        for (int i = 0; i < 2; i++)
            for (int j = 0; j < 2; j++) {
                vec2 pc = e.P(i ? u1 - 0.3f : u0 + 0.3f, j ? v1 - 0.3f : v0 + 0.3f);
                x.m->box(vec3(pc, zT + 0.9f) - x.org, X, Y, Z, vec3(0.3f, 0.3f, 0.9f), wallTone, wmat);
                if (x.detail) pitchedRoof(x, pc, e.ax, 0.32f, 0.32f, zT + 1.8f, 2.2f, true, 0.02f, packRGBA8(0.6f, 0.58f, 0.55f, 1), makeMat(MAT_STONE), wallTone, wmat);
            }
        if (mr.chance(0.4f))
            pitchedPart(x, e, vec4(u0 + 0.6f, u1 - 0.6f, v0 + 0.6f, v1 - 0.6f), zT, 2.f, true, 0.f, rc, makeMat(MAT_ROOF_SHINGLE), wallTone, wmat);
    }
}

// Motel archetypes: the upper floor's walkway along the street face (over the sidewalk, as the generator's motels), its
// rail, posts or piers, the gallery roof of the island motels, and the sign. Visual only, like the generator's walkway.
void motelExtras(Ctx& x, const Building& b, const Env& e, const FacadeGPU& fac, const Plan& P, Rng& mr) {
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    const float z0 = b.baseZ, zw = z0 + fac.groundH, zTop = z0 + b.height, hy = b.hy;
    // the upper floor's run along the street face: the volumes that stand on the ground and reach above the walkway
    float ua = 1e9f, ub = -1e9f;
    for (const Vol& v : P.vols) {
        if (!v.ground || v.z1 < zw + 2.f) continue;
        for (const vec4& r : v.rects)
            if (r.w >= hy - 0.05f) ua = Min(ua, r.x), ub = Max(ub, r.y);
    }
    if (ub - ua < 4.f) return;
    const float wd = 2.1f, um = (ua + ub) * 0.5f, hw = (ub - ua) * 0.5f;
    vec4 ac = unpackRGBA8(fac.frameColor), wcl = unpackRGBA8(fac.wallColor);
    const u32 accent = packRGBA8(ac.x, ac.y, ac.z, 1), wallTone = packRGBA8(Saturate(wcl.x * 1.45f), Saturate(wcl.y * 1.45f), Saturate(wcl.z * 1.45f), 1);
    const u32 conc = packRGBA8(0.86f, 0.85f, 0.82f, 1), steel = packRGBA8(0.88f, 0.88f, 0.86f, 1), dark = packRGBA8(0.12f, 0.12f, 0.13f, 1);
    const u32 wood = packRGBA8(0.93f, 0.93f, 0.9f, 1);
    const bool keys = b.arch == AR_MOTEL_KEYS, med = b.arch == AR_MOTEL_MED, inn = b.arch == AR_MOTEL_INN;
    // the Keys motels' gallery rails: white, or painted turquoise, sea green, coral or butter yellow
    u32 keysRail = wood;
    if (keys) {
        const vec3 rails[] = {vec3(0.25f, 0.7f, 0.72f), vec3(0.45f, 0.72f, 0.55f), vec3(0.95f, 0.55f, 0.45f), vec3(0.98f, 0.88f, 0.5f)};
        u32 h = hash32(b.seed ^ 0x4A11u);
        if (h % 100u >= 45u) {
            vec3 c = rails[(h >> 8) % 4u];
            keysRail = packRGBA8(c.x, c.y, c.z, 1);
        }
    }
    // walkway slab
    x.m->box(vec3(e.P(um, hy + wd * 0.5f), zw - 0.11f) - x.org, X, Y, Z, vec3(hw, wd * 0.5f, 0.11f), keys ? packRGBA8(0.72f, 0.66f, 0.58f, 1) : conc,
             makeMat(keys ? MAT_WOOD : MAT_CONCRETE), true);
    // posts (piers on the Mediterranean motel, wood posts up to the gallery roof on the island motel)
    float zPostTop = keys ? zTop - 0.75f : zw - 0.22f;
    int np = Max(2, (int)roundf((ub - ua) / (med ? 3.6f : 4.f)) + 1);
    for (int k = 0; k < np; k++) {
        float u = Lerp(ua + 0.25f, ub - 0.25f, (float)k / (np - 1));
        vec2 p = e.P(u, hy + wd - 0.2f);
        if (!x.detail) break;
        // (slender: the walkway overhangs the sidewalk, as the generator's motels do, and its posts stand on it)
        if (med) x.m->box(vec3(p, (z0 + zw) * 0.5f - 0.11f) - x.org, X, Y, Z, vec3(0.12f, 0.12f, (zw - z0) * 0.5f - 0.11f), wallTone, makeMat(MAT_STUCCO));
        else if (keys) x.m->box(vec3(p, (z0 + zPostTop) * 0.5f) - x.org, X, Y, Z, vec3(0.08f, 0.08f, (zPostTop - z0) * 0.5f), wood, makeMat(MAT_PLASTER));
        else if (inn) x.m->box(vec3(p, (z0 + zPostTop) * 0.5f) - x.org, X, Y, Z, vec3(0.1f, 0.1f, (zPostTop - z0) * 0.5f), conc, makeMat(MAT_CONCRETE));
        else x.m->cylinder(vec3(p, z0) - x.org, 0.07f, 0.07f, zPostTop - z0, 8, steel, makeMat(MAT_METAL_PAINTED), false);
    }
    // the rail along the walkway's edge: accent panels (MiMo), a stucco parapet wall (Mediterranean), wood pickets
    // (island), black steel pickets (inn)
    vec2 rc = e.P(um, hy + wd - 0.05f);
    if (med) x.m->box(vec3(rc, zw + 0.45f) - x.org, X, Y, Z, vec3(hw, 0.1f, 0.45f), wallTone, makeMat(MAT_STUCCO));
    else {
        u32 railCol = keys ? keysRail : (inn ? dark : steel);
        // (the Keys motel's rail is painted wood: plaster takes its colour, the wood texture would brown it)
        x.m->box(vec3(rc, zw + 0.98f) - x.org, X, Y, Z, vec3(hw, 0.04f, 0.04f), railCol, makeMat(keys ? MAT_PLASTER : MAT_METAL_PAINTED));
        if (!keys && !inn) {
            // MiMo: coloured panels between the posts, a gap above and below
            x.m->box(vec3(rc, zw + 0.55f) - x.org, X, Y, Z, vec3(hw, 0.025f, 0.32f), accent, makeMat(MAT_METAL_PAINTED));
        } else if (x.detail) {
            for (float u = ua + 0.2f; u < ub - 0.1f; u += keys ? 0.16f : 0.14f)
                x.m->box(vec3(e.P(u, hy + wd - 0.05f), zw + 0.48f) - x.org, X, Y, Z, vec3(0.018f, 0.018f, 0.48f), railCol, makeMat(keys ? MAT_PLASTER : MAT_METAL_PAINTED));
        }
    }
    // gallery roofs: a tin shed roof on the island motel's posts, a tile one over the Mediterranean walkway, a slab on the
    // motor court's
    if (keys || med) {
        float zE = zTop - 0.75f;
        vec3 a0 = vec3(e.P(ua - 0.2f, hy), zE + 0.7f) - x.org, a1 = vec3(e.P(ub + 0.2f, hy), zE + 0.7f) - x.org;
        vec3 b0 = vec3(e.P(ua - 0.2f, hy + wd + 0.3f), zE) - x.org, b1 = vec3(e.P(ub + 0.2f, hy + wd + 0.3f), zE) - x.org;
        u32 rcol = b.roofTint, rmat = makeMat(keys ? MAT_ROOF_METAL : MAT_ROOF_TILE);
        x.m->quadFacing(a0, a1, b1, b0, vec2(0, 0), vec2(ub - ua, 0), vec2(ub - ua, wd), vec2(0, wd), rcol, rmat, vec3(e.fr, 2.f));
        x.m->quadFacing(a0, b0, b1, a1, vec2(0, 0), vec2(wd, 0), vec2(wd, ub - ua), vec2(0, ub - ua), keys ? wood : packRGBA8(0.9f, 0.88f, 0.84f, 1),
                        makeMat(keys ? MAT_WOOD : MAT_PLASTER), vec3(-e.fr, -2.f));
        if (med) {
            // the upper posts: slender stucco columns on the parapet wall
            for (int k = 0; k < np && x.detail; k++) {
                float u = Lerp(ua + 0.25f, ub - 0.25f, (float)k / (np - 1));
                vec2 p = e.P(u, hy + wd - 0.2f);
                x.m->box(vec3(p, (zw + 0.9f + zE) * 0.5f) - x.org, X, Y, Z, vec3(0.13f, 0.13f, (zE - zw - 0.9f) * 0.5f), wallTone, makeMat(MAT_STUCCO));
            }
        }
    } else if (!inn) {
        // motor court: the eave slab carried on over the walkway
        x.m->box(vec3(e.P(um, hy + wd * 0.5f + 0.15f), zTop + 0.14f) - x.org, X, Y, Z, vec3(hw + 0.3f, wd * 0.5f + 0.15f, 0.14f), packRGBA8(0.96f, 0.96f, 0.95f, 1),
                 makeMat(MAT_PLASTER), true);
        for (int k = 0; k < np && x.detail; k++) {
            float u = Lerp(ua + 0.25f, ub - 0.25f, (float)k / (np - 1));
            x.m->cylinder(vec3(e.P(u, hy + wd - 0.2f), zw) - x.org, 0.06f, 0.06f, zTop - zw, 8, steel, makeMat(MAT_METAL_PAINTED), false);
        }
    }
    // the sign
    float ss = mr.chance(0.5f) ? 1.f : -1.f;
    vec3 nc = hsvToRgb(mr.f(), 0.75f, 1.f);
    u32 neon = packRGBA8(nc.x, nc.y, nc.z, 0.22f);
    if (keys) {
        // a painted board on the gallery rail, a small neon VACANCY under it
        vec2 sp = e.P(um + ss * hw * 0.5f, hy + wd + 0.02f);
        x.m->box(vec3(sp, zw + 1.6f) - x.org, X, Y, Z, vec3(Min(2.4f, hw * 0.4f), 0.05f, 0.45f), wallTone, makeMat(MAT_WOOD));
        if (x.detail) x.m->box(vec3(sp + e.fr * 0.04f, zw + 1.6f) - x.org, X, Y, Z, vec3(Min(2.f, hw * 0.33f), 0.03f, 0.22f), accent, makeMat(MAT_PLASTER));
        x.m->box(vec3(e.P(um + ss * hw * 0.5f, hy + wd + 0.02f), zw - 0.55f) - x.org, X, Y, Z, vec3(0.7f, 0.05f, 0.14f), neon, makeMat(MAT_EMISSIVE, 6u));
    } else if (med) {
        // a blade sign on the street corner of the walkway
        vec2 sp = e.P(ss > 0.f ? ub - 0.3f : ua + 0.3f, hy + wd + 0.35f);
        x.m->box(vec3(sp, zw + 1.6f) - x.org, X, Y, Z, vec3(0.08f, 0.45f, 1.4f), neon, makeMat(MAT_EMISSIVE, 6u), true);
    } else if (b.massing != MK_CORNER_TOWER) {
        // a pole sign on the roof: the motor court's tilted with a boomerang fin, the inn's a plain box (a corner tower
        // carries the name itself)
        vec2 sp = e.P(ss > 0.f ? ub - 2.f : ua + 2.f, hy - 1.2f);
        float zr = zTop + (inn ? 1.25f : 0.3f);
        x.m->box(vec3(sp, zr + 1.5f) - x.org, X, Y, Z, vec3(0.12f, 0.12f, 1.5f), steel, makeMat(MAT_METAL_PAINTED));
        if (inn) x.m->box(vec3(sp, zr + 3.8f) - x.org, X, Y, Z, vec3(2.6f, 0.3f, 1.0f), neon, makeMat(MAT_EMISSIVE, 6u), true);
        else {
            vec3 tilt = normalize(vec3(e.ax * cosf(0.3f), sinf(0.3f)));
            vec3 up = normalize(cross(Y, tilt));
            if (up.z < 0.f) up = -up;
            x.m->box(vec3(sp, zr + 3.9f) - x.org, tilt, Y, up, vec3(2.4f, 0.25f, 0.9f), neon, makeMat(MAT_EMISSIVE, 6u), true);
            vec3 fin = normalize(vec3(e.ax * ss, 1.4f));
            vec3 fup = normalize(cross(Y, fin));
            if (fup.z < 0.f) fup = -fup;
            x.m->box(vec3(sp + e.ax * (ss * 1.2f), zr + 5.4f) - x.org, fin, Y, fup, vec3(1.3f, 0.12f, 0.18f), accent, makeMat(MAT_METAL_PAINTED));
        }
    }
}

// Strip-mall archetypes: the parking court in front (as the generator's strip malls) and the walkway canopy - an arcade of
// stucco piers under a tile shed roof (mission), a folded-plate canopy on pipe columns (MiMo), a flat metal canopy (power
// center). Visual only, like the generator's canopy.
void stripExtras(Ctx& x, const Building& b, const Env& e, const FacadeGPU& fac, Rng& mr) {
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    const float z0 = b.baseZ, hx = b.hx, hy = b.hy;
    vec4 wcl = unpackRGBA8(fac.wallColor), ac = unpackRGBA8(fac.frameColor);
    const u32 wallTone = packRGBA8(Saturate(wcl.x * 1.45f), Saturate(wcl.y * 1.45f), Saturate(wcl.z * 1.45f), 1), accent = packRGBA8(ac.x, ac.y, ac.z, 1);
    // parking court between the walkway and the street
    vec2 lotFront = b.lotC + b.front * b.lotHy;
    vec2 pc = (lotFront + (b.c + b.front * b.hy)) * 0.5f;
    float pd = length(lotFront - (b.c + b.front * b.hy)) * 0.5f;
    // (asphalt on the ground, the walk along the shops, the stalls; a plateau where the ground in front lies low)
    const float plateau = pd > 2.f ? stripCourt(x, b, pc, pd, true) : -1e9f;
    // the foot of a canopy support on the court
    auto foot = [&](vec2 p) { return courtFoot(plateau, p, z0); };
    const float cd = b.arch == AR_STRIP_MISSION ? 3.2f : 3.0f;   // the canopy's depth over the walkway
    // the canopy's supports stand on the stall lines (every other one), clear of the cars parked nose-in under it
    std::vector<float> sup;
    for (float u = -hx + 2.f; u < hx - 1.f; u += 5.4f) sup.push_back(u);
    if (sup.size() < 2) sup = {-hx + 0.4f, hx - 0.4f};
    if (b.arch == AR_STRIP_MISSION) {
        // stucco piers, a tile shed roof from above the shopfronts
        float zH = z0 + Min(4.4f, b.height - 0.4f), zL = zH - 0.75f;
        for (float u : sup) {
            vec2 p = e.P(u, hy + cd - 0.35f);
            float zf = foot(p);
            x.m->box(vec3(p, (zf + zL) * 0.5f) - x.org, X, Y, Z, vec3(0.28f, 0.28f, (zL - zf) * 0.5f), wallTone, makeMat(MAT_STUCCO));
        }
        x.m->box(vec3(e.P(0.f, hy + cd - 0.35f), zL - 0.2f) - x.org, X, Y, Z, vec3(hx, 0.32f, 0.22f), wallTone, makeMat(MAT_STUCCO), true);
        vec3 a0 = vec3(e.P(-hx - 0.3f, hy), zH) - x.org, a1 = vec3(e.P(hx + 0.3f, hy), zH) - x.org;
        vec3 b0 = vec3(e.P(-hx - 0.3f, hy + cd + 0.2f), zL) - x.org, b1 = vec3(e.P(hx + 0.3f, hy + cd + 0.2f), zL) - x.org;
        x.m->quadFacing(a0, a1, b1, b0, vec2(0, 0), vec2(2.f * hx, 0), vec2(2.f * hx, cd), vec2(0, cd), b.roofTint, makeMat(MAT_ROOF_TILE), vec3(e.fr, 2.f));
        x.m->quadFacing(a0, b0, b1, a1, vec2(0, 0), vec2(cd, 0), vec2(cd, 2.f * hx), vec2(0, 2.f * hx), packRGBA8(0.9f, 0.88f, 0.84f, 1), makeMat(MAT_PLASTER), vec3(-e.fr, -2.f));
    } else if (b.arch == AR_STRIP_MIMO) {
        // folded plate: ridges and valleys across the canopy, pipe columns under the valleys (the far LOD: a slab)
        float zV = z0 + 3.5f, zR = z0 + 4.1f;
        int nb = Max(2, (int)roundf(2.f * hx / 3.4f));
        float bw = 2.f * hx / nb;
        u32 cc = packRGBA8(0.96f, 0.96f, 0.95f, 1);
        if (!x.detail) {
            x.m->box(vec3(e.P(0.f, hy + cd * 0.5f), (zV + zR) * 0.5f) - x.org, X, Y, Z, vec3(hx, cd * 0.5f, (zR - zV) * 0.5f), cc, makeMat(MAT_PLASTER), true);
            nb = 0;
        }
        for (int k = 0; k < nb; k++) {
            float u0 = -hx + k * bw, u1 = u0 + bw * 0.5f, u2 = u0 + bw;
            for (int h2 = 0; h2 < 2; h2++) {
                float ua = h2 ? u1 : u0, ub = h2 ? u2 : u1;
                float za = h2 ? zR : zV, zb2 = h2 ? zV : zR;
                vec3 p0 = vec3(e.P(ua, hy), za) - x.org, p1 = vec3(e.P(ub, hy), zb2) - x.org, p2 = vec3(e.P(ub, hy + cd), zb2) - x.org, p3 = vec3(e.P(ua, hy + cd), za) - x.org;
                vec3 up = normalize(vec3(e.ax * ((h2 ? 1.f : -1.f) * (zR - zV)), bw * 0.5f));
                x.m->quadFacing(p0, p1, p2, p3, vec2(0, 0), vec2(bw * 0.5f, 0), vec2(bw * 0.5f, cd), vec2(0, cd), cc, makeMat(MAT_PLASTER), up);
                x.m->quadFacing(p0, p3, p2, p1, vec2(0, 0), vec2(cd, 0), vec2(cd, bw * 0.5f), vec2(0, bw * 0.5f), cc, makeMat(MAT_PLASTER), -up);
                // the fascia's zigzag edge
                vec3 q0 = p3, q1 = p2;
                x.m->quadFacing(q0, q1, q1 - vec3(0, 0, 0.12f), q0 - vec3(0, 0, 0.12f), vec2(0, 0), vec2(bw * 0.5f, 0), vec2(bw * 0.5f, 0.12f), vec2(0, 0.12f), accent,
                                makeMat(MAT_METAL_PAINTED), vec3(e.fr, 0.f));
            }
        }
        for (float u : sup) {
            if (!x.detail) break;
            // (to the nearest valley of the folded plate)
            float uv = -hx + roundf((u + hx) / bw) * bw;
            float zc = zV + (zR - zV) * Min(1.f, fabsf(uv - u) / (bw * 0.5f));
            vec2 p = e.P(u, hy + cd - 0.3f);
            float zf = foot(p);
            x.m->cylinder(vec3(p, zf) - x.org, 0.08f, 0.08f, zc - zf, 8, accent, makeMat(MAT_METAL_PAINTED), false);
        }
        // a pylon sign at the street end of the court, beside the stalls (deep courts only)
        float ss = mr.chance(0.5f) ? 1.f : -1.f;
        vec3 nc = hsvToRgb(mr.f(), 0.7f, 1.f);
        if (pd >= 4.f) {
            vec2 sp = (b.lotC + b.front * (b.lotHy - 1.f)) + b.ax * (ss * (hx - 0.5f) + dot(b.c - b.lotC, b.ax));
            float gz = gMap ? gMap->heightAt(sp.x, sp.y) : z0;
            x.m->box(vec3(sp, gz + 4.f) - x.org, X, Y, Z, vec3(0.15f, 0.15f, 4.f), packRGBA8(0.9f, 0.9f, 0.88f, 1), makeMat(MAT_METAL_PAINTED));
            x.m->box(vec3(sp, gz + 7.2f) - x.org, X, Y, Z, vec3(0.3f, 1.4f, 1.1f), packRGBA8(nc.x, nc.y, nc.z, 0.22f), makeMat(MAT_EMISSIVE, 6u), true);
            addCollision(x, sp, e.ax, 0.16f, 0.16f, gz - 0.5f, gz + 8.f);
        }
    } else {
        // power center: a flat metal canopy, square steel columns
        float zc = z0 + Min(4.3f, b.height - 0.6f);
        u32 dk = packRGBA8(0.32f, 0.33f, 0.35f, 1);
        x.m->box(vec3(e.P(0.f, hy + cd * 0.5f), zc) - x.org, X, Y, Z, vec3(hx, cd * 0.5f, 0.2f), dk, makeMat(MAT_METAL_PAINTED), true);
        for (float u : sup) {
            vec2 p = e.P(u, hy + cd - 0.3f);
            float zf = foot(p);
            x.m->box(vec3(p, (zf + zc) * 0.5f) - x.org, X, Y, Z, vec3(0.12f, 0.12f, (zc - zf) * 0.5f), dk, makeMat(MAT_METAL_PAINTED));
        }
    }
}

}  // namespace massing

bool buildArchMesh(Ctx& x, const Building& b, const FacadeGPU& fac) {
    using namespace massing;
    if (b.arch == AR_NONE || b.interior >= 0) return false;
    if (b.style == BS_HOUSE || b.style == BS_VILLA || b.style == BS_FARMHOUSE || b.style == BS_SHACK) return false;   // houses: buildArchHouse
    if (b.style == BS_BARN) {
        massing::buildArchBarn(x, b, fac);
        return true;
    }
    if (b.style == BS_CHURCH) {
        massing::buildArchChurch(x, b, fac);
        return true;
    }
    Rng mr(b.seed ^ 0x4D455353u);
    Env e = envOf(b);
    Plan P = planVolumes(b, fac, mr);
    Rng dr(b.seed ^ 0xD37A11u);
    for (const Vol& v : P.vols) emitVolume(x, b, e, v, fac, dr);
    // the condos' balcony slabs on the front and back of their slab volumes (every LOD; the detail pass puts the rails and
    // the unit dividers on them: facadedetail.cpp)
    if (b.style == BS_CONDO)
        for (const Vol& v : P.vols) {
            if (v.kind == FM_PODIUM || v.kind == FM_WING || v.uv.size() != 4 || !v.hole.empty() || v.rects.empty()) continue;
            const vec4 r = v.rects[0];
            balconyBands(x, e.P((r.x + r.y) * 0.5f, (r.z + r.w) * 0.5f), e.ax, (r.y - r.x) * 0.5f, (r.w - r.z) * 0.5f, 0.f, v.z0, v.z1, b.baseZ, fac, 1.6f, 1, false);
        }
    // rooftop dressing on the open roofs (water tanks on the older fabric; nothing on back-yard garages and sheds): from 3
    // floors the roof plant along the back of the roof (every LOD: bulkhead, motor room, HVAC units, cooling tower, the
    // older walk-ups' water tank), the small equipment on the rest
    bool old = (b.archFlags & ABF_OLD) != 0;
    bool rear = b.arch == AR_REAR_COTTAGE || b.arch == AR_REAR_GARAGE || b.arch == AR_REAR_SHED;
    const bool brick = (int)fac.wallLayer == MAT_BRICK;
    const float pTank = b.arch == AR_MID_WALKUP ? (brick ? 0.7f : 0.45f) : (b.arch == AR_MID_LOFT ? 0.3f : (old && b.style == BS_MIDRISE ? 0.2f : 0.f));
    bool tank = hashToFloat(hash32(b.seed ^ 0x7A4Bu)) < pTank, antennas = false;
    int vi = 0;
    for (const Vol& v : P.vols) {
        vi++;
        if (!v.top || v.kind == FM_WING || rear) continue;
        u8 rf = v.roof;
        if (rf == RFM_TILE_HIP || rf == RFM_METAL_GABLE || rf == RFM_SAWTOOTH || rf == RFM_BUTTERFLY) continue;
        // the largest covering rectangle
        vec4 best = v.rects[0];
        for (const vec4& r : v.rects)
            if ((r.y - r.x) * (r.w - r.z) > (best.y - best.x) * (best.w - best.z)) best = r;
        vec2 rc = e.P((best.x + best.y) * 0.5f, (best.z + best.w) * 0.5f);
        float zr = v.z1 + (rf == RFM_EAVE ? 0.3f : (rf == RFM_MANSARD ? 1.25f : 0.f));
        if (rf == RFM_TERRACE) roofTerrace(x, e, best, v.z1, dr);
        else {
            const float hu = (best.y - best.x) * 0.5f, hv = (best.w - best.z) * 0.5f;
            float band = 0.f;
            if (b.floors >= 3 && v.z1 - b.baseZ > 8.f) band = roofPlant(x, rc, b.ax, b.front, hu, hv, zr, b.seed + (u32)vi * 977u, b.floors, tank);
            if (band > 0.f) tank = false;
            rooftopClutter(x, rc + b.front * (band * 0.5f), b.ax, hu * 0.9f, (hv - band * 0.5f) * 0.9f, zr, dr, band > 0.f ? 0.f : (old ? 0.35f : 0.06f));
            // antenna masts and dishes on some of the taller roofs (their own stream: the far LOD draws none)
            if (band > 0.f && b.floors >= 4 && !antennas) {
                antennas = true;
                Rng ar(b.seed ^ 0xA27E1u);
                if (ar.chance(old ? 0.45f : 0.3f)) rooftopAntennas(x, rc + b.front * (band * 0.5f), b.ax, hu * 0.5f, (hv - band * 0.5f) * 0.5f, zr, ar, false);
            }
        }
    }
    if (P.canopyZ > 0.f) mimoCanopy(x, b, e, P.canopyZ, mr);
    if (b.style == BS_MOTEL) motelExtras(x, b, e, fac, P, mr);
    if (b.style == BS_STRIPMALL) stripExtras(x, b, e, fac, mr);
    if (P.arcade) {
        // the arcade: its ceiling under the upper floors, piers on the street line (arches by the detail pass)
        float rec = arcadeDepth(b), zg = P.vols[1].z0;
        std::vector<vec2> ceil = toWorld(e, rectUV(-b.hx, b.hx, b.hy - rec, b.hy));
        std::vector<vec3> poly;
        for (int i = (int)ceil.size() - 1; i >= 0; i--) poly.push_back(vec3(ceil[i], zg) - x.org);
        x.m->polygon(poly, vec3(0, 0, -1), packRGBA8(0.93f, 0.9f, 0.85f, 1), makeMat(MAT_PLASTER), 1.f);
        const FacadeGPU& f = fac;
        int bays = Max(1, (int)roundf(2.f * b.hx / Max(f.bayW, 0.5f)));
        float bw = 2.f * b.hx / bays;
        vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
        vec4 wc = unpackRGBA8(f.wallColor);
        u32 pierCol = packRGBA8(Saturate(wc.x * 1.5f), Saturate(wc.y * 1.5f), Saturate(wc.z * 1.5f), 1);
        for (int k = 0; k <= bays; k++) {
            float u = -b.hx + k * bw;
            u = Clamp(u, -b.hx + 0.3f, b.hx - 0.3f);
            vec2 p = e.P(u, b.hy - 0.3f);
            x.m->box(vec3(p, (b.baseZ + zg) * 0.5f) - x.org, X, Y, Z, vec3(0.3f, 0.3f, (zg - b.baseZ) * 0.5f), pierCol, makeMat((u32)f.wallLayer));
            addCollision(x, p, e.ax, 0.3f, 0.3f, b.baseZ, zg);
        }
    }
    // back of the block: lock-up garage doors along the yard side, a shed's double door, a back house's door and lamp
    if (rear && x.detail) {
        vec3 X(b.ax, 0.f), Y(b.front, 0.f);
        vec2 fc = b.c + b.front * (b.hy + 0.03f);
        if (b.arch == AR_REAR_GARAGE) {
            int nd = Max(1, (int)(2.f * b.hx / 3.3f));
            float pitch = 2.f * b.hx / nd;
            const vec3 doorPal[] = {vec3(0.85f, 0.85f, 0.83f), vec3(0.5f, 0.55f, 0.6f), vec3(0.6f, 0.3f, 0.25f), vec3(0.3f, 0.45f, 0.35f)};
            for (int k = 0; k < nd; k++) {
                float u = -b.hx + (k + 0.5f) * pitch;
                vec3 dc = doorPal[(b.seed + (u32)k * 7u) % 4u] * (0.85f + 0.15f * hashToFloat(hash32(b.seed + (u32)k)));
                vec2 d0 = fc + b.ax * (u - pitch * 0.4f), d1 = fc + b.ax * (u + pitch * 0.4f);
                float dh = Min(2.3f, b.height - 0.5f);
                x.m->quadFacing(vec3(d0, b.baseZ) - x.org, vec3(d1, b.baseZ) - x.org, vec3(d1, b.baseZ + dh) - x.org, vec3(d0, b.baseZ + dh) - x.org, vec2(0, 0),
                                vec2(pitch * 0.8f, 0), vec2(pitch * 0.8f, dh), vec2(0, dh), packRGBA8(dc.x, dc.y, dc.z, 1), makeMat(MAT_CORRUGATED), vec3(b.front, 0));
            }
        } else {
            float dw = b.arch == AR_REAR_SHED ? Min(2.4f, b.hx) : 0.95f, dh = b.arch == AR_REAR_SHED ? Min(2.4f, b.height - 0.3f) : 2.1f;
            float u = (hash32(b.seed ^ 0xD00Du) & 1u) ? b.hx * 0.4f : -b.hx * 0.4f;
            vec2 d0 = fc + b.ax * (u - dw * 0.5f), d1 = fc + b.ax * (u + dw * 0.5f);
            u32 dcol = b.arch == AR_REAR_SHED ? packRGBA8(0.45f, 0.35f, 0.25f, 1) : packRGBA8(0.2f, 0.3f, 0.45f, 1);
            x.m->quadFacing(vec3(d0, b.baseZ) - x.org, vec3(d1, b.baseZ) - x.org, vec3(d1, b.baseZ + dh) - x.org, vec3(d0, b.baseZ + dh) - x.org, vec2(0, 0), vec2(dw, 0),
                            vec2(dw, dh), vec2(0, dh), dcol, makeMat(MAT_WOOD), vec3(b.front, 0));
            if (b.arch == AR_REAR_COTTAGE && x.lights) {
                LightInstance li;
                li.pos = vec3(fc + b.ax * (u + dw * 0.5f + 0.4f) + b.front * 0.3f, b.baseZ + 2.3f);
                li.color = vec3(1.f, 0.75f, 0.45f) * 300.f;
                li.radius = 7.f;
                li.dir = vec3(0);
                li.cone = 0;
                li.type = 1;
                x.lights->push_back(li);
            }
        }
    }
    // industry: roll-up loading doors on the shed front, chimneys and a tank at factories
    if ((b.style == BS_WAREHOUSE || b.style == BS_FACTORY) && x.detail) {
        float du[8];
        int nd = archLoadingDoors(b, du, 8);
        float dh = Min(4.2f, b.height - 1.2f);
        for (int k = 0; k < nd; k++) {
            vec2 d0 = b.c + b.front * (b.hy + 0.03f) + b.ax * (du[k] - 1.8f), d1 = d0 + b.ax * 3.6f;
            x.m->quadFacing(vec3(d0, b.baseZ + 0.2f) - x.org, vec3(d1, b.baseZ + 0.2f) - x.org, vec3(d1, b.baseZ + dh) - x.org, vec3(d0, b.baseZ + dh) - x.org, vec2(0, 0),
                            vec2(3.6f, 0), vec2(3.6f, dh), vec2(0, dh), packRGBA8(0.6f, 0.62f, 0.65f, 1), makeMat(MAT_CORRUGATED), vec3(b.front, 0));
        }
        if (b.style == BS_FACTORY) {
            int nc = dr.irange(1, 2);
            for (int k = 0; k < nc; k++) {
                vec2 cp = b.c + b.ax * dr.range(-b.hx * 0.6f, b.hx * 0.6f) - b.front * dr.range(0.f, b.hy * 0.5f);
                x.m->cylinder(vec3(cp, b.baseZ + b.height) - x.org, 1.3f, 0.95f, dr.range(12.f, 26.f), 12, packRGBA8(0.55f, 0.4f, 0.35f, 1), makeMat(MAT_BRICK), false);
            }
        }
    }
    return true;
}

}  // namespace World

namespace World {

namespace massing {

// House roof finish by archetype: tile, shingle or metal, and its colour (deterministic from the seed)
void houseRoofFinish(const Building& b, Rng& hr, u32& col, u32& mat) {
    const vec3 shingle[] = {vec3(0.55f, 0.55f, 0.56f), vec3(0.78f, 0.7f, 0.6f), vec3(0.5f, 0.45f, 0.42f), vec3(0.9f, 0.9f, 0.88f), vec3(0.65f, 0.6f, 0.52f),
                            vec3(0.45f, 0.5f, 0.56f), vec3(0.62f, 0.5f, 0.42f)};
    const vec3 metal[] = {vec3(0.95f, 0.96f, 0.97f), vec3(0.8f, 0.81f, 0.83f), vec3(0.62f, 0.3f, 0.25f), vec3(0.4f, 0.56f, 0.5f), vec3(0.38f, 0.48f, 0.62f)};
    float p = hr.f();
    int kind;   // 0 tile, 1 shingle, 2 metal
    switch (b.arch) {
        case AR_HOUSE_MED: kind = 0; break;
        case AR_HOUSE_RANCH: kind = p < 0.4f ? 0 : (p < 0.52f ? 3 : 1); break;   // (tile, a white roof, shingle)
        case AR_HOUSE_BUNGALOW: kind = blockstyle::houseForm(b) == blockstyle::HF_BUNG_MISSION ? 0 : (p < 0.55f ? 1 : (p < 0.85f ? 2 : 0)); break;
        case AR_HOUSE_TWO: kind = p < 0.7f ? 1 : 0; break;
        case AR_HOUSE_SPLIT: kind = p < 0.6f ? 1 : 0; break;
        case AR_HOUSE_CONCH: kind = 2; break;
        case AR_HOUSE_MIMO: kind = 2; break;
        case AR_VILLA_MED: kind = 0; break;
        case AR_VILLA_COLONIAL: kind = p < 0.55f ? 1 : 0; break;
        case AR_SHACK_STILT: kind = 2; break;
        case AR_HOUSE_CBS: kind = p < 0.45f ? 3 : (p < 0.8f ? 0 : 2); break;   // (a white roof, tile, white metal)
        case AR_HOUSE_VICTORIAN: kind = p < 0.6f ? 2 : 1; break;
        case AR_HOUSE_RAISED: kind = 2; break;
        case AR_HOUSE_TRAILER: kind = p < 0.72f ? 2 : 1; break;   // (tin, or a shingled roof-over added later)
        default: kind = 0; break;
    }
    if (b.style == BS_FARMHOUSE && kind != 2 && hr.chance(0.75f)) kind = 2;   // (tin roofs on the farms)
    if (kind == 3) {
        // the painted or white-cement roofs of the block houses: white, pale grey, a faded blue-grey
        const vec3 white[] = {vec3(0.95f, 0.95f, 0.94f), vec3(0.88f, 0.88f, 0.87f), vec3(0.8f, 0.83f, 0.86f), vec3(0.92f, 0.9f, 0.86f)};
        vec3 c = white[hr.next() % 4u] * hr.range(0.94f, 1.04f);
        col = packRGBA8(Saturate(c.x), Saturate(c.y), Saturate(c.z), 1);
        mat = makeMat(MAT_ROOF_SHINGLE);
        return;
    }
    if (b.arch == AR_HOUSE_CBS && kind == 2) {
        col = packRGBA8(0.94f, 0.95f, 0.96f, 1);
        mat = makeMat(MAT_ROOF_METAL);
        return;
    }
    if (kind == 0) {
        float t = hr.range(0.85f, 1.12f);
        float g = hr.range(0.88f, 1.02f), bl = hr.range(0.9f, 1.f);
        // the blend of the tile (seeded apart from the stream): terracotta, a brown blend (less red), an aged dark red
        u32 fam = hash32(b.seed ^ 0x711E5u) % 100u;
        vec3 m = fam < 45u ? vec3(1.f) : (fam < 75u ? vec3(0.58f, 0.88f, 1.f) : vec3(0.78f, 0.62f, 0.62f));
        col = packRGBA8(Saturate(t * m.x), Saturate(t * g * m.y), Saturate(t * bl * m.z), 1);
        mat = makeMat(MAT_ROOF_TILE);
    } else if (kind == 1) {
        vec3 c = shingle[hr.next() % 7] * hr.range(0.9f, 1.1f);
        col = packRGBA8(Saturate(c.x), Saturate(c.y), Saturate(c.z), 1);
        mat = makeMat(MAT_ROOF_SHINGLE);
    } else {
        vec3 c = metal[hr.next() % 5];
        if ((b.arch == AR_HOUSE_CONCH || b.arch == AR_SHACK_STILT || b.arch == AR_HOUSE_RAISED || b.arch == AR_HOUSE_TRAILER) && hr.chance(0.6f)) c = metal[hr.next() % 2];
        // (old tin on the fishing shacks: a rust brown)
        if (b.arch == AR_SHACK_STILT && hr.chance(0.2f)) c = vec3(0.52f, 0.36f, 0.26f);
        col = packRGBA8(c.x, c.y, c.z, 1);
        mat = makeMat(MAT_ROOF_METAL);
    }
}

// Steps from a raised deck (top zTop, front edge at v = v0 facing +v) down to the ground: treads with colliders, each
// rise under the walkers' step height, centred on um, w wide
void deckSteps(Ctx& x, const Env& e, float um, float w, float v0, float zTop, float zGround, u32 col, u32 mat) {
    float rise = zTop - zGround;
    if (rise < 0.22f) return;
    int n = Max(1, (int)ceilf(rise / 0.2f) - 1);
    float h = rise / (n + 1), run = 0.28f;
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    yardKeep(x, e.P(um, v0 + n * run * 0.5f), e.ax, e.fr, w * 0.5f, n * run * 0.5f);
    for (int k = 1; k <= n; k++) {
        float zt = zTop - k * h, va = v0 + (k - 1) * run;
        vec2 c = e.P(um, va + run * 0.5f);
        x.m->box(vec3(c, (zt + zGround - 0.25f) * 0.5f) - x.org, X, Y, Z, vec3(w * 0.5f, run * 0.5f, (zt - zGround + 0.25f) * 0.5f), col, mat);
        addCollision(x, c, e.ax, w * 0.5f, run * 0.5f, zGround - 0.6f, zt);
    }
}

// A triangle (world positions) wound to face `want`: hipped roof ends, gable ends
void worldTri(Ctx& x, vec3 a, vec3 b, vec3 c, vec3 want, u32 col, u32 mat) {
    vec3 n = cross(b - a, c - a);
    float l = length(n);
    if (l < 1e-6f) return;
    n = n / l;
    if (dot(n, want) < 0.f) {
        std::swap(b, c);
        n = -n;
    }
    vec3 t = normalize(b - a), bt = cross(n, t);
    u32 i0 = x.m->addVertex(a - x.org, n, t, vec2(0, 0), col, mat);
    u32 i1 = x.m->addVertex(b - x.org, n, t, vec2(dot(b - a, t), dot(b - a, bt)), col, mat);
    u32 i2 = x.m->addVertex(c - x.org, n, t, vec2(dot(c - a, t), dot(c - a, bt)), col, mat);
    x.m->tri(i0, i1, i2);
}

void porchRoof(Ctx& x, const Env& e, float hy, float u0, float u1, float dep, float zEave, int roofKind, u32 col, u32 mat, u32 trim);
void porchKind(Ctx& x, const Env& e, float hy, float u0, float u1, float dep, float zb, float zEave, int roofKind, u32 col, u32 mat, u32 trim, bool rail,
               float zGround, bool steps, float ue);

// Porch on posts in front of the house: roof (0 small front gable, 1 shed, 2 none: a gallery or the house's own roof
// stands on it, 3 a hipped shed), posts, deck; u0..u1 along u at the front. A deck raised above zGround (conch houses on
// piers) is walkable, with steps down at the entry unless steps is false. The entry (the gap in the rail, the steps) is
// the porch's middle, or uEntry (the door) when given. Posts by x.porchPosts: slim, Craftsman columns on piers with a knee
// wall for the rail, or round columns.
void housePorch(Ctx& x, const Env& e, float hy, float u0, float u1, float dep, float zb, float zEave, int roofKind, u32 col, u32 mat, u32 trim, bool rail,
                float zGround = -1e9f, bool steps = true, float uEntry = 1e9f) {
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    float um = (u0 + u1) * 0.5f, hw = (u1 - u0) * 0.5f;
    if (x.porchPosts != 0 || uEntry < 1e8f) {
        porchKind(x, e, hy, u0, u1, dep, zb, zEave, roofKind, col, mat, trim, rail, zGround, steps, uEntry < 1e8f ? Clamp(uEntry, u0 + 0.7f, u1 - 0.7f) : um);
        return;
    }
    vec2 c = e.P(um, hy + dep * 0.5f);
    yardKeep(x, c, e.ax, e.fr, hw, dep * 0.5f);
    // deck (the far LOD keeps only the porch roof: deck, skirt, steps and posts are close-range detail)
    if (x.detail)
        x.m->box(vec3(c, zb - 0.12f) - x.org, X, Y, Z, vec3(hw, dep * 0.5f, 0.14f), packRGBA8(0.75f, 0.73f, 0.7f, 1), makeMat(roofKind != 0 ? MAT_WOOD : MAT_CONCRETE), true);
    if (zGround > -1e8f && zb - zGround > 0.25f) {
        // raised: solid underneath (lattice skirt), walkable on top, steps down at the entry
        if (x.detail)
            x.m->box(vec3(c, (zb - 0.26f + zGround - 0.3f) * 0.5f) - x.org, X, Y, Z, vec3(hw - 0.05f, dep * 0.5f - 0.05f, (zb - 0.26f - zGround + 0.3f) * 0.5f),
                     packRGBA8(0.9f, 0.9f, 0.88f, 1), makeMat(MAT_WOOD_SIDING));
        addCollision(x, c, e.ax, hw, dep * 0.5f, zGround - 0.6f, zb + 0.02f);
        if (steps && x.detail) deckSteps(x, e, um, 1.5f, hy + dep, zb + 0.02f, zGround, packRGBA8(0.72f, 0.7f, 0.66f, 1), makeMat(MAT_WOOD));
    }
    // posts
    int np = Max(2, (int)roundf((u1 - u0) / 2.6f) + 1);
    for (int k = 0; k < np; k++) {
        vec2 p = e.P(Lerp(u0 + 0.15f, u1 - 0.15f, (float)k / (np - 1)), hy + dep - 0.15f);
        if (x.detail) x.m->box(vec3(p, (zb + zEave) * 0.5f) - x.org, X, Y, Z, vec3(0.09f, 0.09f, (zEave - zb) * 0.5f), trim, trimWood(x));
        addCollision(x, p, e.ax, 0.1f, 0.1f, zb, zEave);
    }
    if (rail && x.detail) {
        x.m->box(vec3(e.P(um, hy + dep - 0.15f), zb + 0.9f) - x.org, X, Y, Z, vec3(hw, 0.03f, 0.03f), trim, trimWood(x));
        for (float u = u0 + 0.3f; u < u1 - 0.2f; u += 0.14f)
            if (fabsf(u - um) > 0.6f) x.m->box(vec3(e.P(u, hy + dep - 0.15f), zb + 0.45f) - x.org, X, Y, Z, vec3(0.018f, 0.018f, 0.45f), trim, trimWood(x));
    }
    porchRoof(x, e, hy, u0, u1, dep, zEave, roofKind, col, mat, trim);
}

// The porch's roof (housePorch's kinds 0, 1 and 3; 2 has none)
void porchRoof(Ctx& x, const Env& e, float hy, float u0, float u1, float dep, float zEave, int roofKind, u32 col, u32 mat, u32 trim) {
    const float um = (u0 + u1) * 0.5f, hw = (u1 - u0) * 0.5f;
    vec2 rc = e.P(um, hy + dep * 0.5f);
    if (roofKind == 2) return;
    if (roofKind == 0) {
        // front-facing gable over the porch
        pitchedRoof(x, rc, e.ax, hw + 0.2f, dep * 0.5f + 0.15f, zEave, 0.6f, false, 0.2f, col, mat, trim, makeMat(MAT_WOOD_SIDING), 1);
    } else if (roofKind == 4) {
        // a flat porch roof: a stucco slab with a deep fascia (the Mission bungalow's loggia; col / mat: the wall's)
        vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
        x.m->box(vec3(e.P(um, hy + (dep + 0.15f) * 0.5f), zEave + 0.2f) - x.org, X, Y, Z, vec3(hw + 0.15f, (dep + 0.15f) * 0.5f, 0.2f), col, mat, true);
        if (x.detail) x.m->box(vec3(e.P(um, hy + dep + 0.13f), zEave + 0.47f) - x.org, X, Y, Z, vec3(hw + 0.15f, 0.04f, 0.07f), trim, trimWood(x));
    } else if (roofKind == 3 && (u1 - u0) + 0.5f - 2.f * (dep + 0.25f) > 0.4f) {
        // a hipped shed: the slope away from the wall at a low pitch, the ends hipped back to a ridge along the wall, a flat
        // ceiling under it and a fascia board round the eave
        const float o = 0.25f, run = dep + o, pp = 0.3f, rise = run * pp;
        const float ua = u0 - o + run, ub = u1 + o - run;
        auto P3 = [&](float u, float v, float z) { return vec3(e.P(u, v), z); };
        const vec3 C0 = P3(u0 - o, hy + run, zEave), C1 = P3(u1 + o, hy + run, zEave), W0 = P3(u0 - o, hy, zEave), W1 = P3(u1 + o, hy, zEave);
        const vec3 R0 = P3(ua, hy, zEave + rise), R1 = P3(ub, hy, zEave + rise);
        const vec3 F(e.fr, 0.f), A(e.ax, 0.f), up(0, 0, 1);
        const float sl = run * sqrtf(1.f + pp * pp);
        x.m->quadFacing(C0 - x.org, C1 - x.org, R1 - x.org, R0 - x.org, vec2(0, 0), vec2(u1 - u0 + 2.f * o, 0), vec2(ub - u0 + o, sl), vec2(ua - u0 + o, sl), col, mat,
                        F * pp + up);
        worldTri(x, W0, C0, R0, -A * pp + up, col, mat);
        worldTri(x, C1, W1, R1, A * pp + up, col, mat);
        x.m->quadFacing(W0 - x.org, W1 - x.org, C1 - x.org, C0 - x.org, vec2(0, 0), vec2(u1 - u0 + 2.f * o, 0), vec2(u1 - u0 + 2.f * o, run), vec2(0, run), trim,
                        trimWood(x), -up);
        if (x.detail) {
            vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
            x.m->box(vec3(e.P(um, hy + run - 0.02f), zEave - 0.08f) - x.org, X, Y, Z, vec3(hw + o, 0.025f, 0.09f), trim, trimWood(x));
            for (int s = -1; s <= 1; s += 2)
                x.m->box(vec3(e.P(s < 0 ? u0 - o + 0.02f : u1 + o - 0.02f, hy + run * 0.5f), zEave - 0.08f) - x.org, X, Y, Z, vec3(0.025f, run * 0.5f, 0.09f), trim,
                         trimWood(x));
        }
    } else {
        // shed roof sloping away from the wall
        vec3 a0 = vec3(e.P(u0 - 0.2f, hy), zEave + 0.7f) - x.org, a1 = vec3(e.P(u1 + 0.2f, hy), zEave + 0.7f) - x.org;
        vec3 b0 = vec3(e.P(u0 - 0.2f, hy + dep + 0.3f), zEave) - x.org, b1 = vec3(e.P(u1 + 0.2f, hy + dep + 0.3f), zEave) - x.org;
        x.m->quadFacing(a0, a1, b1, b0, vec2(0, 0), vec2(u1 - u0, 0), vec2(u1 - u0, dep), vec2(0, dep), col, mat, vec3(e.fr, 2.f));
        x.m->quadFacing(a0, b0, b1, a1, vec2(0, 0), vec2(dep, 0), vec2(dep, u1 - u0), vec2(0, u1 - u0), trim, trimWood(x), vec3(-e.fr, -2.f));
    }
}

// The porch of the newer house forms (housePorch with Craftsman posts, round columns or an entry at the door): the deck,
// the posts clear of the entry, the rail or a knee wall between the piers with the gap at the entry, steps down when
// raised, the roof
void porchKind(Ctx& x, const Env& e, float hy, float u0, float u1, float dep, float zb, float zEave, int roofKind, u32 col, u32 mat, u32 trim, bool rail,
               float zGround, bool steps, float ue) {
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    const float um = (u0 + u1) * 0.5f, hw = (u1 - u0) * 0.5f;
    const vec2 c = e.P(um, hy + dep * 0.5f);
    yardKeep(x, c, e.ax, e.fr, hw, dep * 0.5f);
    if (x.detail)
        x.m->box(vec3(c, zb - 0.12f) - x.org, X, Y, Z, vec3(hw, dep * 0.5f, 0.14f), packRGBA8(0.75f, 0.73f, 0.7f, 1),
                 makeMat(x.porchPosts == 1 || roofKind == 0 ? MAT_CONCRETE : MAT_WOOD), true);
    if (zGround > -1e8f && zb - zGround > 0.25f) {
        if (x.detail)
            x.m->box(vec3(c, (zb - 0.26f + zGround - 0.3f) * 0.5f) - x.org, X, Y, Z, vec3(hw - 0.05f, dep * 0.5f - 0.05f, (zb - 0.26f - zGround + 0.3f) * 0.5f),
                     packRGBA8(0.9f, 0.9f, 0.88f, 1), makeMat(MAT_WOOD_SIDING));
        addCollision(x, c, e.ax, hw, dep * 0.5f, zGround - 0.6f, zb + 0.02f);
        if (steps && x.detail) deckSteps(x, e, ue, 1.5f, hy + dep, zb + 0.02f, zGround, packRGBA8(0.72f, 0.7f, 0.66f, 1), makeMat(MAT_WOOD));
    }
    // posts: the ends and between them at most 3.2 m apart, none in the entry - the door, and the middle of the house front
    // where gameplay stands a resident at the door (population.cpp: 1.9 m out from the front)
    const float vp = hy + dep - 0.2f;
    const int kind = x.porchPosts;
    const u32 pierC = x.pierCol ? x.pierCol : packRGBA8(0.72f, 0.44f, 0.36f, 1), pierM = x.pierMat ? x.pierMat : makeMat(MAT_BRICK);
    const float pierH = 0.95f, pierW = 0.24f;
    const bool mid = u0 < 0.f && u1 > 0.f;
    const float g0 = (mid ? Min(0.f, ue) : ue) - 0.6f, g1 = (mid ? Max(0.f, ue) : ue) + 0.6f;   // the opening in the rail
    float us[16];
    int np = 0;
    const int nSpan = Max(1, (int)ceilf((u1 - u0 - 0.4f) / 3.2f));
    for (int k = 0; k <= nSpan && np < 16; k++) {
        float u = Lerp(u0 + 0.2f, u1 - 0.2f, (float)k / nSpan);
        if (k > 0 && k < nSpan && u > g0 - 0.15f && u < g1 + 0.15f) u = (u - g0 < g1 - u) ? g0 - 0.15f : g1 + 0.15f;
        us[np++] = u;
    }
    for (int k = 0; k < np; k++) {
        vec2 p = e.P(us[k], vp);
        if (x.detail) {
            if (kind == 1) {
                // a square column on a pier, a cap where they meet
                x.m->box(vec3(p, zb + pierH * 0.5f) - x.org, X, Y, Z, vec3(pierW, pierW, pierH * 0.5f), pierC, pierM);
                x.m->box(vec3(p, zb + pierH + 0.04f) - x.org, X, Y, Z, vec3(pierW + 0.04f, pierW + 0.04f, 0.04f), trim, trimWood(x));
                x.m->box(vec3(p, (zb + pierH + zEave) * 0.5f) - x.org, X, Y, Z, vec3(0.12f, 0.12f, (zEave - zb - pierH) * 0.5f), trim, trimWood(x));
            } else if (kind == 3) {
                // a square stucco pier the full height
                x.m->box(vec3(p, (zb + zEave) * 0.5f) - x.org, X, Y, Z, vec3(0.2f, 0.2f, (zEave - zb) * 0.5f), pierC, pierM);
            } else if (kind == 2) {
                // a round column with a square base and capital
                x.m->cylinder(vec3(p, zb + 0.12f) - x.org, 0.14f, 0.12f, zEave - zb - 0.26f, 10, trim, trimWood(x), false);
                x.m->box(vec3(p, zb + 0.06f) - x.org, X, Y, Z, vec3(0.19f, 0.19f, 0.06f), trim, trimWood(x));
                x.m->box(vec3(p, zEave - 0.08f) - x.org, X, Y, Z, vec3(0.18f, 0.18f, 0.07f), trim, trimWood(x));
            } else {
                x.m->box(vec3(p, (zb + zEave) * 0.5f) - x.org, X, Y, Z, vec3(0.09f, 0.09f, (zEave - zb) * 0.5f), trim, trimWood(x));
            }
        }
        const float pc = kind == 1 ? pierW : (kind == 3 ? 0.2f : 0.14f);
        addCollision(x, p, e.ax, pc, pc, zb, zEave);
    }
    // the rail (a knee wall between the piers) along the front, the entry left open
    if (rail && x.detail) {
        for (int k = 0; k + 1 < np; k++) {
            const float pw2 = kind == 1 ? pierW : (kind == 3 ? 0.2f : 0.1f);
            float a = us[k] + pw2, b2 = us[k + 1] - pw2;
            if (b2 - a < 0.3f) continue;
            // (the span less the opening)
            float segs[2][2];
            int ns = 0;
            if (g1 <= a || g0 >= b2) segs[ns][0] = a, segs[ns][1] = b2, ns++;
            else {
                if (g0 > a) segs[ns][0] = a, segs[ns][1] = g0, ns++;
                if (g1 < b2) segs[ns][0] = g1, segs[ns][1] = b2, ns++;
            }
            for (int s = 0; s < ns; s++) {
                float s0 = segs[s][0], s1 = segs[s][1];
                if (s1 - s0 < 0.25f) continue;
                vec2 sc = e.P((s0 + s1) * 0.5f, vp);
                if (kind == 1 || kind == 3) {
                    x.m->box(vec3(sc, zb + 0.4f) - x.org, X, Y, Z, vec3((s1 - s0) * 0.5f, 0.11f, 0.4f), pierC, pierM);
                    x.m->box(vec3(sc, zb + 0.83f) - x.org, X, Y, Z, vec3((s1 - s0) * 0.5f, 0.14f, 0.03f), trim, trimWood(x));
                } else {
                    x.m->box(vec3(sc, zb + 0.9f) - x.org, X, Y, Z, vec3((s1 - s0) * 0.5f, 0.03f, 0.03f), trim, trimWood(x));
                    x.m->box(vec3(sc, zb + 0.1f) - x.org, X, Y, Z, vec3((s1 - s0) * 0.5f, 0.03f, 0.03f), trim, trimWood(x));
                    for (float u = s0 + 0.07f; u < s1 - 0.05f; u += 0.14f)
                        x.m->box(vec3(e.P(u, vp), zb + 0.5f) - x.org, X, Y, Z, vec3(0.018f, 0.018f, 0.38f), trim, trimWood(x));
                }
            }
        }
    }
    porchRoof(x, e, hy, u0, u1, dep, zEave, roofKind, col, mat, trim);
}

// The frame of a side wall (sgn = +1: the +u side): u along the wall (the front's v), v outward; for porches on a side
Env sideEnv(const Env& e, float sgn) {
    Env s;
    s.c = e.c;
    s.ax = e.fr;
    s.fr = e.ax * sgn;
    s.hx = e.hy;
    s.hy = e.hx;
    s.flip = dot(s.fr, perp(s.ax)) < 0.f;
    return s;
}

// Raised floor of a conch house on its piers, and its porch type (deterministic from the seed: the facade detail and
// the far LOD agree)
inline float conchRaise(const Building& b) { return 0.55f + 0.4f * hashToFloat(hash32(b.seed ^ 0xC0C4u)); }

// Two-storey conch house: a double gallery across the front, the upper deck on the lower posts, railed, under a shed roof
void galleryPorch(Ctx& x, const Env& e, float hy, float u0, float u1, float dep, float zb, float zUp, float zTop, u32 col, u32 mat, u32 trim, float zGround,
                  u32 ceiling = 0) {
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    housePorch(x, e, hy, u0, u1, dep, zb, zUp - 0.2f, 2, col, mat, trim, true, zGround);
    float um = (u0 + u1) * 0.5f, hw = (u1 - u0) * 0.5f;
    // the upper deck (the lower porch's ceiling)
    const bool painted = ceiling && x.detail;
    x.m->box(vec3(e.P(um, hy + dep * 0.5f), zUp - 0.1f) - x.org, X, Y, Z, vec3(hw, dep * 0.5f, 0.1f), packRGBA8(0.92f, 0.91f, 0.88f, 1), makeMat(MAT_WOOD), !painted);
    // the ceiling under the deck's boards, painted (ceiling: its colour; 0 bare wood), in place of the box's underside
    if (painted) {
        const float zc = zUp - 0.2f;
        vec3 c0 = vec3(e.P(um - hw, hy), zc) - x.org, c1 = vec3(e.P(um + hw, hy), zc) - x.org;
        vec3 c2 = vec3(e.P(um + hw, hy + dep), zc) - x.org, c3 = vec3(e.P(um - hw, hy + dep), zc) - x.org;
        x.m->quadFacing(c0, c1, c2, c3, vec2(0, 0), vec2(u1 - u0, 0), vec2(u1 - u0, dep), vec2(0, dep), ceiling, makeMat(MAT_PLASTER), vec3(0, 0, -1));
    }
    // upper posts, rail and balusters
    float zE = zTop - 0.75f;
    int np = Max(2, (int)roundf((u1 - u0) / 2.6f) + 1);
    for (int k = 0; k < np && x.detail; k++) {
        vec2 p = e.P(Lerp(u0 + 0.15f, u1 - 0.15f, (float)k / (np - 1)), hy + dep - 0.15f);
        x.m->box(vec3(p, (zUp + zE) * 0.5f) - x.org, X, Y, Z, vec3(0.08f, 0.08f, (zE - zUp) * 0.5f), trim, trimWood(x));
    }
    if (x.detail) x.m->box(vec3(e.P(um, hy + dep - 0.15f), zUp + 0.95f) - x.org, X, Y, Z, vec3(hw, 0.035f, 0.035f), trim, trimWood(x));
    if (x.detail)
        for (float u = u0 + 0.25f; u < u1 - 0.2f; u += 0.14f)
            x.m->box(vec3(e.P(u, hy + dep - 0.15f), zUp + 0.47f) - x.org, X, Y, Z, vec3(0.018f, 0.018f, 0.47f), trim, trimWood(x));
    // shed roof under the main eave
    vec3 a0 = vec3(e.P(u0 - 0.2f, hy), zE + 0.7f) - x.org, a1 = vec3(e.P(u1 + 0.2f, hy), zE + 0.7f) - x.org;
    vec3 b0 = vec3(e.P(u0 - 0.2f, hy + dep + 0.3f), zE) - x.org, b1 = vec3(e.P(u1 + 0.2f, hy + dep + 0.3f), zE) - x.org;
    x.m->quadFacing(a0, a1, b1, b0, vec2(0, 0), vec2(u1 - u0, 0), vec2(u1 - u0, dep), vec2(0, dep), col, mat, vec3(e.fr, 2.f));
    x.m->quadFacing(a0, b0, b1, a1, vec2(0, 0), vec2(dep, 0), vec2(dep, u1 - u0), vec2(0, u1 - u0), trim, trimWood(x), vec3(-e.fr, -2.f));
}

// Colonial villa: a two-storey portico of columns across the middle of the front, entablature and pediment
void colonialPortico(Ctx& x, const Env& e, float hx, float hy, float zb, float zTop, u32 roofCol, u32 roofMat, Rng& mr) {
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    float pw = Clamp(2.f * hx * mr.range(0.34f, 0.46f), 5.5f, 11.f) * 0.5f, pd = mr.range(2.6f, 3.2f);
    const u32 white = packRGBA8(0.97f, 0.97f, 0.95f, 1), stone = packRGBA8(0.86f, 0.84f, 0.8f, 1);
    // platform and steps
    vec2 pc = e.P(0.f, hy + pd * 0.5f);
    yardKeep(x, pc, e.ax, e.fr, pw + 0.3f, pd * 0.5f);
    x.m->box(vec3(pc, zb - 0.1f) - x.org, X, Y, Z, vec3(pw + 0.3f, pd * 0.5f, 0.28f), stone, makeMat(MAT_CONCRETE), true);
    addCollision(x, pc, e.ax, pw + 0.3f, pd * 0.5f, zb - 1.f, zb + 0.18f);
    // columns
    float zE = zTop - 0.1f;
    int nc = pw > 3.6f ? 6 : 4;
    for (int k = 0; k < nc; k++) {
        vec2 cp = e.P(Lerp(-pw + 0.35f, pw - 0.35f, (float)k / (nc - 1)), hy + pd - 0.4f);
        if (x.detail) {
            x.m->cylinder(vec3(cp, zb + 0.18f) - x.org, 0.26f, 0.21f, zE - 0.75f - zb - 0.18f, 12, white, makeMat(MAT_PLASTER), false);
            x.m->box(vec3(cp, zb + 0.3f) - x.org, X, Y, Z, vec3(0.34f, 0.34f, 0.12f), white, makeMat(MAT_PLASTER));
            x.m->box(vec3(cp, zE - 0.82f) - x.org, X, Y, Z, vec3(0.32f, 0.32f, 0.07f), white, makeMat(MAT_PLASTER));
        }
        addCollision(x, cp, e.ax, 0.27f, 0.27f, zb, zE);
    }
    // entablature
    vec2 ec = e.P(0.f, hy + pd * 0.5f - 0.05f);
    x.m->box(vec3(ec, zE - 0.4f) - x.org, X, Y, Z, vec3(pw + 0.15f, pd * 0.5f + 0.05f, 0.36f), white, makeMat(MAT_PLASTER), true);
    // pediment: a front gable over the portico, the house roof's finish
    pitchedRoof(x, ec, e.ax, pw + 0.15f, pd * 0.5f + 0.05f, zE - 0.04f, 0.42f, false, 0.25f, roofCol, roofMat, white, makeMat(MAT_PLASTER), 1);
}

// Gingerbread on a porch's posts (the posts of housePorch: the same spacing): a pair of curved braces up to the beam,
// drawn as straight struts, up close only
void porchBrackets(Ctx& x, const Env& e, float hy, float u0, float u1, float dep, float zEave, u32 trim) {
    if (!x.detail) return;
    int np = Max(2, (int)roundf((u1 - u0) / 2.6f) + 1);
    vec3 side(e.fr, 0.f);
    for (int k = 0; k < np; k++) {
        float u = Lerp(u0 + 0.15f, u1 - 0.15f, (float)k / (np - 1));
        for (int sd = -1; sd <= 1; sd += 2) {
            if ((k == 0 && sd < 0) || (k == np - 1 && sd > 0)) continue;
            vec3 dir = normalize(vec3(e.ax * (float)sd, 1.f));
            vec3 third = normalize(cross(dir, side));
            vec2 p = e.P(u + sd * 0.2f, hy + dep - 0.15f);
            x.m->box(vec3(p, zEave - 0.22f) - x.org, dir, side, third, vec3(0.3f, 0.03f, 0.04f), trim, trimWood(x));
        }
    }
}

// A king-post truss in the apex of a front gable (wall face at v = vf, between u0 and u1, the wall top at zw; pitch as
// pitchedRoof's) and a small attic window under it, up close only
void gableTruss(Ctx& x, const Env& e, float vf, float u0, float u1, float zw, float pitch, u32 trim, bool window) {
    if (!x.detail) return;
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    float um = (u0 + u1) * 0.5f, hw = (u1 - u0) * 0.5f, za = zw + hw * pitch;
    const u32 wood = trimWood(x);
    float h = Min(1.1f, hw * pitch * 0.45f);
    // the king post, the collar tie and two struts
    x.m->box(vec3(e.P(um, vf + 0.05f), za - 0.15f - h * 0.5f) - x.org, X, Y, Z, vec3(0.05f, 0.05f, h * 0.5f), trim, wood);
    float hc = Max(0.2f, (h + 0.15f) / pitch - 0.15f);
    x.m->box(vec3(e.P(um, vf + 0.05f), za - 0.15f - h) - x.org, X, Y, Z, vec3(hc, 0.05f, 0.05f), trim, wood);
    for (int sd = -1; sd <= 1; sd += 2) {
        vec3 a = vec3(e.P(um, vf + 0.05f), za - 0.15f - h * 0.35f), c = vec3(e.P(um + sd * hc * 0.7f, vf + 0.05f), za - 0.15f - h);
        vec3 d = c - a;
        float l = length(d);
        d = d / l;
        x.m->box((a + c) * 0.5f - x.org, d, Y, normalize(cross(d, Y)), vec3(l * 0.5f, 0.04f, 0.035f), trim, wood);
    }
    if (window && za - h - 0.35f > zw + 0.9f) {
        // the attic window under the collar
        float wz1 = za - 0.15f - h - 0.25f, wz0 = Max(zw + 0.35f, wz1 - 0.8f);
        // (a trim plate on the wall, the dark glass in front of it: the plate shows as the frame)
        x.m->box(vec3(e.P(um, vf + 0.015f), (wz0 + wz1) * 0.5f) - x.org, X, Y, Z, vec3(0.38f, 0.015f, (wz1 - wz0) * 0.5f + 0.06f), trim, wood);
        x.m->box(vec3(e.P(um, vf + 0.045f), (wz0 + wz1) * 0.5f) - x.org, X, Y, Z, vec3(0.32f, 0.015f, (wz1 - wz0) * 0.5f), packRGBA8(0.12f, 0.13f, 0.15f, 1),
                 makeMat(MAT_GLASS));
    }
}

// ------------------------------------------------------------------------------------------------ Craftsman, Foursquare
// The main roof over a house body as pitchedRoof draws it (eave z at the overhang's edge, the planes rising at `pitch`
// from the long eaves - and from the ends too when hipped): the height of its surface over a point of the envelope
struct RoofShape {
    float u0, u1, v0, v1, z, pitch, over;
    bool hip, alongU;
    float zAt(float u, float v) const {
        const float du = (u1 - u0) * 0.5f + over - fabsf(u - (u0 + u1) * 0.5f), dv = (v1 - v0) * 0.5f + over - fabsf(v - (v0 + v1) * 0.5f);
        const float d = hip ? Min(du, dv) : (alongU ? dv : du);
        return z + Max(0.f, d) * pitch;
    }
};
RoofShape roofShape(float u0, float u1, float v0, float v1, float z, float pitch, float over, bool hip, int ridge) {
    RoofShape s{u0, u1, v0, v1, z, pitch, over, hip, ridge < 0 ? (u1 - u0) >= (v1 - v0) : ridge == 0};
    return s;
}

// The pier nearest the middle of a front wall from u0 to u1 (facadedetail.cpp puts the house door there: bays from the
// facade's bay width, the wall running from u1 toward -u, or from u0 toward +u when the winding is mirrored)
inline float houseDoorU(const Env& e, float u0, float u1, float bayW) {
    const int bays = Max(1, (int)roundf((u1 - u0) / Max(bayW, 0.5f)));
    const float bw = (u1 - u0) / (float)bays;
    return e.flip ? u0 + (bays / 2) * bw : u1 - (bays / 2) * bw;
}

// A band of windows on a wall from a to b (outward n), between zlo and zhi: trim plates and dark glass, up close only
void windowBand(Ctx& x, vec2 a, vec2 b, vec2 n, float zlo, float zhi, int count, float ww, u32 trim) {
    if (!x.detail || count <= 0 || zhi - zlo < 0.3f) return;
    vec2 t = b - a;
    const float len = length(t);
    if (len < 0.6f) return;
    t = t / len;
    vec3 X(t, 0.f), Y(n, 0.f), Z(0, 0, 1);
    const float step = len / count, hw = Min(ww * 0.5f, step * 0.5f - 0.1f), zc = (zlo + zhi) * 0.5f, hh = (zhi - zlo) * 0.5f;
    if (hw < 0.15f) return;
    for (int k = 0; k < count; k++) {
        vec2 c = a + t * (step * (k + 0.5f));
        x.m->box(vec3(c + n * 0.015f, zc) - x.org, X, Y, Z, vec3(hw + 0.06f, 0.015f, hh + 0.06f), trim, trimWood(x));
        x.m->box(vec3(c + n * 0.045f, zc) - x.org, X, Y, Z, vec3(hw, 0.015f, hh), packRGBA8(0.12f, 0.13f, 0.15f, 1), makeMat(MAT_GLASS));
    }
}

// A dormer on the front slope of a roof (the slope rising from the front eave toward -v): its face at vf, um the middle,
// hw half wide; it runs back to the roof's middle, its walls start under the slope (hidden there). kind 0 a gable to the
// street, 1 a shed rising back into the roof (the Craftsman's), 2 a low hip. Drawn only where the roof stands high
// enough over it for a face of 0.7 m; returns whether it was.
bool dormer(Ctx& x, const Env& e, const RoofShape& s, float um, float hw, float vf, int kind, int nWin, u32 wallCol, u32 wallMat, u32 roofCol, u32 roofMat,
            u32 trim) {
    const float o = 0.22f, vm = (s.v0 + s.v1) * 0.5f;
    const float dd = vf - vm;
    if (dd < 1.2f) return false;
    const float vb = vm;
    const float zFace = s.zAt(um, vf);
    const float pd = kind == 0 ? 0.55f : (kind == 2 ? 0.35f : 0.12f);
    // the dormer's top over its back corners and at the back of its ridge must stay under the main roof
    float zd = zFace + 1.2f;
    const float backCorner = Min(s.zAt(um - hw - o, vb), s.zAt(um + hw + o, vb));
    if (kind == 0) zd = Min(zd, Min(s.zAt(um, vb) - (hw + o) * pd, backCorner) - 0.1f);
    else if (kind == 2) {
        const bool alongV = dd > 2.f * hw;
        const float hs = (alongV ? hw : dd * 0.5f) + o, vRidgeBack = alongV ? vb + hw + o : (vb + vf) * 0.5f;
        zd = Min(zd, Min(s.zAt(um, vRidgeBack) - hs * pd, backCorner) - 0.1f);
    } else zd = Min(zd, backCorner - (dd + o) * pd - 0.1f);
    if (zd - zFace < 0.7f) return false;
    // walls (from the eave line: the part under the slope stays inside the roof)
    plainWalls(x, toWorld(e, rectUV(um - hw, um + hw, vb, vf)), s.z, zd, wallCol, wallMat);
    windowBand(x, e.P(um - hw, vf), e.P(um + hw, vf), e.fr, zFace + 0.22f, zd - 0.14f, nWin, kind == 1 ? 0.62f : 0.7f, trim);
    const vec2 c = e.P(um, (vb + vf) * 0.5f);
    if (kind == 0) pitchedRoof(x, c, e.ax, hw, dd * 0.5f, zd, pd, false, o, roofCol, roofMat, wallCol, wallMat, 1);
    else if (kind == 2) pitchedRoof(x, c, e.ax, hw, dd * 0.5f, zd, pd, true, o, roofCol, roofMat, wallCol, wallMat, -1);
    else {
        // the shed: from the front edge (a little under the wall top) up the back; its cheeks close the sides
        const float zf = zd - o * pd, zk = zd + dd * pd;
        auto P3 = [&](float u, float v, float z) { return vec3(e.P(u, v), z); };
        const vec3 f0 = P3(um - hw - o, vf + o, zf), f1 = P3(um + hw + o, vf + o, zf), k0 = P3(um - hw - o, vb, zk), k1 = P3(um + hw + o, vb, zk);
        const vec3 F(e.fr, 0.f), up(0, 0, 1), A(e.ax, 0.f);
        const float sl = (dd + o) * sqrtf(1.f + pd * pd);
        x.m->quadFacing(f0 - x.org, f1 - x.org, k1 - x.org, k0 - x.org, vec2(0, 0), vec2(2.f * (hw + o), 0), vec2(2.f * (hw + o), sl), vec2(0, sl), roofCol, roofMat,
                        F * pd + up);
        x.m->quadFacing(f0 - x.org, f1 - x.org, k1 - x.org, k0 - x.org, vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), trim, trimWood(x), -up);
        for (int sd = -1; sd <= 1; sd += 2) {
            const float u = um + sd * hw;
            worldTri(x, P3(u, vf, zd), P3(u, vb, zd), P3(u, vb, zk), A * (float)sd, wallCol, wallMat);
        }
    }
    return true;
}

// The Craftsman side gable: the ridge along the street; the front slope carries on past the front wall over a porch across
// the whole front at a lower pitch, down to zPorch (returned) at the porch's edge. Gable ends up to the roof, a frieze
// board between the front wall's top and the roof, a soffit under the back and the rakes, the porch ceiling under the
// lower slope.
float sweptGable(Ctx& x, const Env& e, float u0, float u1, float v0, float v1, float z, float pitch, float over, float pdep, u32 col, u32 mat, u32 gableCol,
                 u32 gableMat, u32 trim) {
    const float vm = (v0 + v1) * 0.5f, hs = (v1 - v0) * 0.5f;
    const float zr = z + (hs + over) * pitch, zw = z + over * pitch;
    const float po = 0.3f, pp = Min(pitch * 0.5f, 0.26f), run = pdep + po, zPorch = zw - run * pp;
    const float ua = u0 - over, ub = u1 + over, L = ub - ua;
    auto P3 = [&](float u, float v, float h) { return vec3(e.P(u, v), h) - x.org; };
    const vec3 F(e.fr, 0.f), up(0, 0, 1);
    const float s1 = (hs + over) * sqrtf(1.f + pitch * pitch), s0 = hs * sqrtf(1.f + pitch * pitch), s2 = run * sqrtf(1.f + pp * pp);
    // back slope, front slope to the wall line, the porch slope and its ceiling
    x.m->quadFacing(P3(ua, v0 - over, z), P3(ub, v0 - over, z), P3(ub, vm, zr), P3(ua, vm, zr), vec2(0, 0), vec2(L, 0), vec2(L, s1), vec2(0, s1), col, mat, -F + up);
    x.m->quadFacing(P3(ub, v1, zw), P3(ua, v1, zw), P3(ua, vm, zr), P3(ub, vm, zr), vec2(0, 0), vec2(L, 0), vec2(L, s0), vec2(0, s0), col, mat, F + up);
    x.m->quadFacing(P3(ub, v1 + run, zPorch), P3(ua, v1 + run, zPorch), P3(ua, v1, zw), P3(ub, v1, zw), vec2(0, 0), vec2(L, 0), vec2(L, s2), vec2(0, s2), col, mat,
                    F * pp + up);
    x.m->quadFacing(P3(ub, v1 + run, zPorch), P3(ua, v1 + run, zPorch), P3(ua, v1, zw), P3(ub, v1, zw), vec2(0, 0), vec2(L, 0), vec2(L, run), vec2(0, run), trim,
                    trimWood(x), -up);
    // gable ends: a pentagon on each end wall up to the roof
    for (int sd = 0; sd < 2; sd++) {
        const float u = sd ? u1 : u0;
        const vec3 n(e.ax * (sd ? 1.f : -1.f), 0.f);
        const vec3 a = P3(u, v0, z) + x.org, b = P3(u, v1, z) + x.org, c = P3(u, v1, zw) + x.org, d = P3(u, vm, zr) + x.org, f = P3(u, v0, zw) + x.org;
        worldTri(x, a, b, c, n, gableCol, gableMat);
        worldTri(x, a, c, d, n, gableCol, gableMat);
        worldTri(x, a, d, f, n, gableCol, gableMat);
    }
    // the undersides of the overhangs (the back eave, the rakes) following the roof, and the frieze boards on the front and
    // back wall lines between the walls' top and the roof
    const u32 sof = trimWood(x);
    x.m->quadFacing(P3(ua, v0 - over, z), P3(ub, v0 - over, z), P3(ub, v0, zw), P3(ua, v0, zw), vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), trim, sof, -up);
    for (int sd = 0; sd < 2; sd++) {
        const float a0 = sd ? u1 : ua, a1 = sd ? ub : u0;
        x.m->quadFacing(P3(a0, v0, zw), P3(a1, v0, zw), P3(a1, vm, zr), P3(a0, vm, zr), vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), trim, sof, -up);
        x.m->quadFacing(P3(a0, vm, zr), P3(a1, vm, zr), P3(a1, v1, zw), P3(a0, v1, zw), vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), trim, sof, -up);
    }
    x.m->quadFacing(P3(u0, v1, z), P3(u1, v1, z), P3(u1, v1, zw), P3(u0, v1, zw), vec2(0, 0), vec2(u1 - u0, 0), vec2(u1 - u0, zw - z), vec2(0, zw - z), trim, sof, F);
    x.m->quadFacing(P3(u0, v0, z), P3(u1, v0, z), P3(u1, v0, zw), P3(u0, v0, zw), vec2(0, 0), vec2(u1 - u0, 0), vec2(u1 - u0, zw - z), vec2(0, zw - z), trim, sof, -F);
    // the fascia along the porch eave, and knee braces under the rakes (up close)
    if (x.detail) {
        vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
        x.m->box(vec3(e.P((ua + ub) * 0.5f, v1 + run - 0.02f), zPorch - 0.08f) - x.org, X, Y, Z, vec3(L * 0.5f, 0.025f, 0.09f), trim, trimWood(x));
        for (int sd = -1; sd <= 1; sd += 2) {
            const float u = sd < 0 ? u0 : u1;
            for (int k = 0; k < 3; k++) {
                const float v = Lerp(v0 + 0.7f, v1 - 0.7f, k / 2.f);
                const float zRoof = z + (hs + over - fabsf(v - vm)) * pitch;
                // (a diagonal brace from the wall out to the rake, under the roof's edge)
                vec3 p0 = vec3(e.P(u, v), zRoof - 1.0f), p1 = vec3(e.P(u + sd * (over - 0.06f), v), zRoof - 0.06f);
                vec3 dv = p1 - p0;
                float l = length(dv);
                if (l < 0.2f || zRoof - 1.0f < z - 0.4f) continue;
                dv = dv / l;
                x.m->box((p0 + p1) * 0.5f - x.org, dv, Y, normalize(cross(dv, Y)), vec3(l * 0.5f, 0.05f, 0.05f), trim, trimWood(x));
            }
        }
    }
    return zPorch;
}

// The airplane bungalow's upper room: a low, wide room astride the ridge (the "cockpit"), a band of windows along its long
// sides, a low hip roof with wide eaves
void upperRoom(Ctx& x, const Env& e, const RoofShape& s, float vc, u32 wallCol, u32 wallMat, u32 roofCol, u32 roofMat, u32 trim, const Building& b) {
    const float hx = (s.u1 - s.u0) * 0.5f, hy = (s.v1 - s.v0) * 0.5f;
    const float across = Clamp((s.alongU ? hy : hx) * 0.36f, 1.4f, 2.1f), along = Clamp((s.alongU ? hx : hy) * 0.5f, 1.8f, 3.4f);
    const float au = s.alongU ? along : across, av = s.alongU ? across : along;
    const float uc = 0.f, vcc = s.alongU ? 0.f : vc;
    const float zr = s.zAt(uc, vcc), zc = zr + 0.45f;
    plainWalls(x, toWorld(e, rectUV(uc - au, uc + au, vcc - av, vcc + av)), s.z, zc, wallCol, wallMat);
    addCollision(x, e.P(uc, vcc), e.ax, au, av, s.z, zc + 0.6f);
    // the windows on the two long sides (parallel to the ridge), over the roof there
    for (int sd = -1; sd <= 1; sd += 2) {
        vec2 a, bb, n;
        float zl;
        if (s.alongU) {
            a = e.P(uc - au, vcc + sd * av), bb = e.P(uc + au, vcc + sd * av), n = e.fr * (float)sd;
            zl = s.zAt(uc, vcc + sd * av);
        } else {
            a = e.P(uc + sd * au, vcc - av), bb = e.P(uc + sd * au, vcc + av), n = e.ax * (float)sd;
            zl = s.zAt(uc + sd * au, vcc);
        }
        const int nw = Clamp((int)(length(bb - a) / 1.45f), 2, 5);
        windowBand(x, a, bb, n, Max(zl + 0.3f, zc - 1.0f), zc - 0.18f, nw, 0.58f, trim);
    }
    pitchedRoof(x, e.P(uc, vcc), e.ax, au, av, zc, 0.3f, true, 0.65f, roofCol, roofMat, wallCol, wallMat, -1);
    (void)b;
}

// The Mission bungalow's curved gable: the front wall carried up over the middle of the front (between ua and ub, its face
// at vf, t thick) from the low parapet's top zBase in a curved shoulder to a flat crown `rise` higher, tile on the coping
void missionGable(Ctx& x, const Env& e, float ua, float ub, float vf, float zBase, float rise, float t, u32 col, u32 mat, u32 tile) {
    const float sk[] = {0.f, 0.17f, 0.3f, 0.4f, 0.6f, 0.7f, 0.83f, 1.f}, hk[] = {0.f, 0.55f, 0.88f, 1.f, 1.f, 0.88f, 0.55f, 0.f};
    const float W = ub - ua;
    const vec3 F(e.fr, 0.f), up(0, 0, 1);
    for (int k = 0; k + 1 < 8; k++) {
        const float s0 = ua + W * sk[k], s1 = ua + W * sk[k + 1], z0 = zBase + rise * hk[k], z1 = zBase + rise * hk[k + 1];
        for (int sd = 0; sd < 2; sd++) {
            const float v = sd ? vf - t : vf;
            const vec3 a = vec3(e.P(s0, v), zBase) - x.org, b = vec3(e.P(s1, v), zBase) - x.org, c = vec3(e.P(s1, v), z1) - x.org, d = vec3(e.P(s0, v), z0) - x.org;
            x.m->quadFacing(a, b, c, d, vec2(0, 0), vec2(s1 - s0, 0), vec2(s1 - s0, z1 - zBase), vec2(0, z0 - zBase), col, mat, sd ? -F : F);
        }
        // the coping over this stretch of the curve
        const vec3 a = vec3(e.P(s0, vf + 0.03f), z0 + 0.02f) - x.org, b = vec3(e.P(s1, vf + 0.03f), z1 + 0.02f) - x.org;
        const vec3 c = vec3(e.P(s1, vf - t - 0.03f), z1 + 0.02f) - x.org, d = vec3(e.P(s0, vf - t - 0.03f), z0 + 0.02f) - x.org;
        const vec3 nrm = normalize(cross(b - a, vec3(-e.fr, 0.f)));
        x.m->quadFacing(a, b, c, d, vec2(0, 0), vec2(s1 - s0, 0), vec2(s1 - s0, t), vec2(0, t), tile, makeMat(MAT_ROOF_TILE), dot(nrm, up) >= 0.f ? nrm : -nrm);
    }
}

// Stilt house of the fishing towns (AR_SHACK_STILT): the floor on posts over the flats, decks round the front, a side
// or the whole house with railings, a stair down to the yard, a porch roof, a metal roof (side or front gable, shed,
// hip) and a rain-water cistern. Height of the floor above the ground from the seed (buildmesh.cpp reads it too).
inline float shackStiltH(const Building& b) { return 1.4f + 1.2f * hashToFloat(hash32(b.seed ^ 0x5717u)); }
// the floor of a stilt shack or of a raised Keys house (the flood code: a full storey of parking under the house)
inline float stiltFloorH(const Building& b) { return b.arch == AR_HOUSE_RAISED ? 2.6f + 0.5f * hashToFloat(hash32(b.seed ^ 0x5718u)) : shackStiltH(b); }
// A mobile home's depth across the lot: a single-wide, or a double-wide where the envelope is deep enough (buildTrailer;
// the carport beside it and the back fence's returns follow it: buildmesh.cpp, facadedetail.cpp)
inline float trailerDepth(const Building& b) {
    const u32 h = hash32(b.seed ^ 0x7A1E6u);
    const bool dbl = blockstyle::trailerDouble(b);
    return Min(2.f * b.hy, dbl ? 7.8f + 0.7f * hashToFloat(h >> 1) : 4.1f + 0.3f * hashToFloat(h >> 1));
}
// The depth (half) of a house's garage wing or carport from the front: a mobile home's carport is no deeper than the home
inline float carportHalfDepth(const Building& b) {
    const float gd = Min(b.hy, 3.4f);
    return b.arch == AR_HOUSE_TRAILER ? Min(gd, Max(1.6f, trailerDepth(b) * 0.5f)) : gd;
}

// Mono-pitch roof over a rectangle: high along v1 (the front), low along v0, side walls closed in the wall colour
void shedRoofPart(Ctx& x, const Env& e, vec4 r, float z, float rise, float over, u32 col, u32 mat, u32 wallCol, u32 wallMat) {
    float u0 = r.x - over, u1 = r.y + over, v0 = r.z - over, v1 = r.w + over;
    float k = rise / Max(0.1f, r.w - r.z);
    float zLo = z - over * k, zHi = z + rise + over * k;
    vec3 a0 = vec3(e.P(u0, v0), zLo) - x.org, a1 = vec3(e.P(u1, v0), zLo) - x.org, b0 = vec3(e.P(u0, v1), zHi) - x.org, b1 = vec3(e.P(u1, v1), zHi) - x.org;
    vec3 up = normalize(vec3(-e.fr * rise, r.w - r.z));
    float sl = length(b0 - a0);
    x.m->quadFacing(a0, a1, b1, b0, vec2(0, 0), vec2(u1 - u0, 0), vec2(u1 - u0, sl), vec2(0, sl), col, mat, up);
    x.m->quadFacing(a0, b0, b1, a1, vec2(0, 0), vec2(sl, 0), vec2(sl, u1 - u0), vec2(0, u1 - u0), packRGBA8(0.6f, 0.55f, 0.48f, 1), makeMat(MAT_WOOD), -up);
    // the front wall's top up to the high edge, the side triangles
    vec3 X(e.ax, 0.f);
    for (int s = 0; s < 2; s++) {
        float u = s ? r.y : r.x;
        vec3 p0 = vec3(e.P(u, r.z), z) - x.org, p1 = vec3(e.P(u, r.w), z) - x.org, p2 = vec3(e.P(u, r.w), z + rise) - x.org;
        vec3 nn = s ? X : -X;
        u32 i0 = x.m->addVertex(p0, nn, vec3(e.fr, 0.f), vec2(0, 0), wallCol, wallMat);
        u32 i1 = x.m->addVertex(p1, nn, vec3(e.fr, 0.f), vec2(r.w - r.z, 0), wallCol, wallMat);
        u32 i2 = x.m->addVertex(p2, nn, vec3(e.fr, 0.f), vec2(r.w - r.z, rise), wallCol, wallMat);
        if (dot(cross(p1 - p0, p2 - p0), nn) >= 0.f) x.m->tri(i0, i1, i2);
        else x.m->tri(i0, i2, i1);
    }
    vec3 f0 = vec3(e.P(r.x, r.w), z) - x.org, f1 = vec3(e.P(r.y, r.w), z) - x.org;
    x.m->quadFacing(f0, f1, f1 + vec3(0, 0, rise), f0 + vec3(0, 0, rise), vec2(0, 0), vec2(r.y - r.x, 0), vec2(r.y - r.x, rise), vec2(0, rise), wallCol, wallMat,
                    vec3(e.fr, 0.f));
}

void buildStiltShack(Ctx& x, const Building& b, const FacadeGPU& fac, u32& roofCol, u32& roofMat) {
    Rng mr(b.seed ^ 0x5AC4u);
    Env e = envOf(b);
    const float hx = b.hx, hy = b.hy, z0 = b.baseZ;
    const bool raised = b.arch == AR_HOUSE_RAISED;   // (a Keys house on concrete piers rather than a shack on wood posts)
    const float zf = z0 + stiltFloorH(b), zTop = zf + b.height;
    houseRoofFinish(b, mr, roofCol, roofMat);
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    const u32 post = raised ? packRGBA8(0.82f, 0.82f, 0.8f, 1) : packRGBA8(0.6f, 0.54f, 0.46f, 1), deckCol = packRGBA8(0.7f, 0.64f, 0.55f, 1);
    const u32 woodMat = makeMat(MAT_WOOD), postMat = raised ? makeMat(MAT_CONCRETE) : woodMat;
    const u32 railMat = raised ? makeMat(MAT_PLASTER) : woodMat;   // (the raised Keys house's rails painted, the shack's bare)
    const float pr = raised ? 0.2f : 0.11f;   // a post's or pier's half width
    vec4 wc = unpackRGBA8(fac.frameColor);
    const u32 railCol = packRGBA8(wc.x, wc.y, wc.z, 1);
    vec4 wl = unpackRGBA8(fac.wallColor);
    const u32 wallCol = packRGBA8(Saturate(wl.x * 1.45f), Saturate(wl.y * 1.45f), Saturate(wl.z * 1.45f), 1);
    const u32 wallMat = makeMat((u32)fac.wallLayer == MAT_CORRUGATED ? MAT_CORRUGATED : MAT_WOOD_SIDING);
    // everything that shapes the outline first (one stream for both LODs)
    const bool L = b.massing == MK_L;
    const float ls = mr.chance(0.5f) ? 1.f : -1.f;
    const float nw = 2.f * hx * mr.range(0.38f, 0.5f), nd = 2.f * hy * mr.range(0.35f, 0.5f);
    const float dkw[3] = {0.35f, 0.4f, 0.25f};
    (void)mr.weighted(dkw, 3);   // (the stream's draw kept: the kinds are seeded in blockstyle.cpp, which the repetition log reads)
    const int deckKind = blockstyle::stiltDeckKind(b);   // 0 all round, 1 the front, 2 the front and a side (drawn: dk below)
    const float dw = mr.range(1.0f, 1.4f), df = mr.range(1.2f, 1.6f);
    const float side = mr.chance(0.5f) ? 1.f : -1.f;
    const float rkw[4] = {0.35f, 0.25f, 0.25f, 0.15f};
    (void)mr.weighted(rkw, 4);
    const int roofKind = blockstyle::stiltRoofKind(b);   // side gable, front gable, shed, hip
    const float pitch = mr.range(0.36f, 0.55f);
    const bool porchRoof = deckKind != 0 ? mr.chance(raised ? 0.85f : 0.6f) : mr.chance(raised ? 0.5f : 0.25f);
    const bool brace = mr.chance(0.45f) && !raised;
    const bool cistern = mr.chance(0.3f) && !raised;
    const float stairSide = mr.chance(0.5f) ? 1.f : -1.f;
    // room to the lot's side lines (the neighbours' decks): decks round the sides only where they fit
    const float lateral = dot(b.c - b.lotC, b.ax);
    const float roomPos = b.lotHx - lateral - hx, roomNeg = b.lotHx + lateral - hx;
    int dk = deckKind;
    if (dk == 0 && Min(roomPos, roomNeg) < dw + 0.4f) dk = 1;
    if (dk == 2 && (side > 0.f ? roomPos : roomNeg) < dw + 0.4f) dk = 1;
    // body
    std::vector<vec4> parts;
    std::vector<vec2> uvPoly;
    if (L) {
        float vc = hy - nd;
        if (ls > 0.f) {
            float ua = hx - nw;
            uvPoly = {vec2(-hx, -hy), vec2(hx, -hy), vec2(hx, vc), vec2(ua, vc), vec2(ua, hy), vec2(-hx, hy)};
            parts = {vec4(-hx, hx, -hy, vc), vec4(-hx, ua, vc, hy)};
        } else {
            float ub = -hx + nw;
            uvPoly = {vec2(-hx, -hy), vec2(hx, -hy), vec2(hx, hy), vec2(ub, hy), vec2(ub, vc), vec2(-hx, vc)};
            parts = {vec4(-hx, hx, -hy, vc), vec4(ub, hx, vc, hy)};
        }
    } else {
        uvPoly = rectUV(-hx, hx, -hy, hy);
        parts = {vec4(-hx, hx, -hy, hy)};
    }
    std::vector<vec2> fp = toWorld(e, uvPoly);
    recordMass(x, fp, zf, zTop, zf, FM_HOUSE, false);
    facadeWalls(x, fp, zf - 0.3f, zTop, zf, b.facade, fac.bayW);
    {
        std::vector<vec3> under;
        for (int i = (int)fp.size() - 1; i >= 0; i--) under.push_back(vec3(fp[i], zf - 0.3f) - x.org);
        x.m->polygon(under, vec3(0, 0, -1), post, woodMat, 1.f);
    }
    for (const vec4& p : parts)
        addCollision(x, e.P((p.x + p.y) * 0.5f, (p.z + p.w) * 0.5f), e.ax, (p.y - p.x) * 0.5f, (p.w - p.z) * 0.5f, raised ? zf - 0.35f : z0 - 2.f, zTop + 1.5f);
    if (raised) {
        // under the house: the back half closed in (storage behind lattice-panelled walls), the front open for parking
        float vb = -hy + Max(2.4f, 2.f * hy * 0.45f);
        std::vector<vec2> sfp = toWorld(e, rectUV(-hx + 0.25f, hx - 0.25f, -hy + 0.25f, vb));
        plainWalls(x, sfp, z0 - 0.3f, zf - 0.3f, packRGBA8(0.93f, 0.93f, 0.9f, 1), makeMat(MAT_WOOD_SIDING));
        addCollision(x, e.P(0.f, (-hy + 0.25f + vb) * 0.5f), e.ax, hx - 0.25f, (vb + hy - 0.25f) * 0.5f, z0 - 1.f, zf - 0.3f);
        // a slab under the parking
        std::vector<vec2> pfp = toWorld(e, rectUV(-hx, hx, vb, hy));
        std::vector<vec3> poly;
        for (auto& q : pfp) poly.push_back(vec3(q, (gMap ? gMap->heightAt(q.x, q.y) : z0) + 0.05f) - x.org);
        x.m->polygon(poly, vec3(0, 0, 1), kWhite, makeMat(MAT_CONCRETE), 1.f);
    }
    // roofs
    for (size_t k = 0; k < parts.size(); k++) {
        const vec4& p = parts[k];
        if (roofKind == 2 && k == 0) shedRoofPart(x, e, p, zTop, Clamp((p.w - p.z) * 0.18f, 0.6f, 1.4f), 0.45f, roofCol, roofMat, wallCol, wallMat);
        else {
            int ridge = (roofKind == 1 && k == 0) ? 1 : (roofKind == 0 && k == 0 ? 0 : -1);
            pitchedPart(x, e, p, zTop, pitch, roofKind == 3, 0.45f, roofCol, roofMat, wallCol, wallMat, ridge);
        }
    }
    // decks: rectangles (u0, u1, v0, v1) at the floor; the front deck reaches round the corner to a side deck
    std::vector<vec4> decks;
    const float dep = dk == 0 ? dw : df;   // the deck's depth in front of the house
    if (dk == 0) decks.push_back(vec4(-hx - dw, hx + dw, -hy - dw, hy + dw));
    else {
        float fu0 = -hx - 0.2f, fu1 = hx + 0.2f;
        if (dk == 2) (side > 0.f ? fu1 : fu0) = side * (hx + dw);
        decks.push_back(vec4(fu0, fu1, hy - (L ? nd : 0.f), hy + df));
        if (dk == 2) {
            if (side > 0.f) decks.push_back(vec4(hx, hx + dw, -hy + 0.6f, hy - (L ? nd : 0.f)));
            else decks.push_back(vec4(-hx - dw, -hx, -hy + 0.6f, hy - (L ? nd : 0.f)));
        }
    }
    const vec4 front = decks[0];
    const float zd = zf - 0.03f;
    for (const vec4& d : decks) {
        vec2 dc = e.P((d.x + d.y) * 0.5f, (d.z + d.w) * 0.5f);
        float dhx = (d.y - d.x) * 0.5f, dhy = (d.w - d.z) * 0.5f;
        yardKeep(x, dc, e.ax, e.fr, dhx, dhy);
        x.m->box(vec3(dc, zd - 0.12f) - x.org, X, Y, Z, vec3(dhx, dhy, 0.12f), deckCol, woodMat, true);
        addCollision(x, dc, e.ax, dhx, dhy, zd - 0.3f, zd);
        // posts under the outer edges, every 2.4 m or so
        int nu = Max(1, (int)ceilf((d.y - d.x) / 2.4f)), nv = Max(1, (int)ceilf((d.w - d.z) / 2.4f));
        for (int i = 0; i <= nu; i++)
            for (int j = 0; j <= nv; j++) {
                if (i != 0 && i != nu && j != 0 && j != nv) continue;
                float u = Lerp(d.x + 0.12f, d.y - 0.12f, (float)i / nu), v = Lerp(d.z + 0.12f, d.w - 0.12f, (float)j / nv);
                if (u > -hx && u < hx && v > -hy && v < hy) continue;   // under the house: inside its collision
                vec2 pp = e.P(u, v);
                if (x.detail) x.m->box(vec3(pp, (z0 - 0.4f + zd - 0.24f) * 0.5f) - x.org, X, Y, Z, vec3(pr, pr, (zd - 0.24f - z0 + 0.4f) * 0.5f), post, postMat);
                addCollision(x, pp, e.ax, pr + 0.01f, pr + 0.01f, z0 - 0.5f, zd - 0.24f);
            }
    }
    if (raised) {
        // the piers round the house's edge, about every 3.2 m (the space under the house is open: they collide)
        int nu = Max(1, (int)ceilf((2.f * hx - 0.5f) / 3.2f)), nv = Max(1, (int)ceilf((2.f * hy - 0.5f) / 3.2f));
        for (int i = 0; i <= nu; i++)
            for (int j = 0; j <= nv; j++) {
                if (i != 0 && i != nu && j != 0 && j != nv) continue;
                vec2 pp = e.P(Lerp(-hx + 0.25f, hx - 0.25f, (float)i / nu), Lerp(-hy + 0.25f, hy - 0.25f, (float)j / nv));
                x.m->box(vec3(pp, (z0 - 0.4f + zf - 0.3f) * 0.5f) - x.org, X, Y, Z, vec3(0.22f, 0.22f, (zf - 0.3f - z0 + 0.4f) * 0.5f), post, postMat);
                addCollision(x, pp, e.ax, 0.23f, 0.23f, z0 - 0.5f, zf - 0.3f);
            }
    } else {
        // the posts under the house corners
        for (int i = -1; i <= 1; i += 2)
            for (int j = -1; j <= 1; j += 2) {
                vec2 pp = e.P(i * (hx - 0.25f), j * (hy - 0.25f));
                x.m->box(vec3(pp, (z0 - 0.4f + zf - 0.3f) * 0.5f) - x.org, X, Y, Z, vec3(0.13f, 0.13f, (zf - 0.3f - z0 + 0.4f) * 0.5f), post, woodMat);
            }
    }
    // cross bracing on the front and the sides between the corner posts
    if (brace && x.detail) {
        float hb = zf - 0.4f - (z0 + 0.2f);
        for (int s = 0; s < 3; s++) {
            vec2 a, c;
            if (s == 0) a = e.P(-hx + 0.25f, hy - 0.25f), c = e.P(hx - 0.25f, hy - 0.25f);
            else {
                float u = s == 1 ? -hx + 0.25f : hx - 0.25f;
                a = e.P(u, -hy + 0.25f), c = e.P(u, hy - 0.25f);
            }
            vec3 hn = normalize(vec3(perp(normalize(c - a)), 0.f));
            for (int dgl = 0; dgl < 2; dgl++) {
                vec3 p0 = vec3(dgl ? c : a, z0 + 0.2f), p1 = vec3(dgl ? a : c, z0 + 0.2f + hb);
                vec3 dir = p1 - p0;
                float len = length(dir);
                if (len < 0.5f) continue;
                dir = dir / len;
                vec3 up = normalize(cross(dir, hn));
                x.m->box((p0 + p1) * 0.5f - x.org, dir, hn, up, vec3(len * 0.5f, 0.03f, 0.07f), post, woodMat);
            }
        }
    }
    // the stair down to the yard from the front deck's corner: straight toward the street when the front yard has the
    // room, else along the deck's front edge toward the middle; a landing at the head
    const float rise = zd - z0;
    const int nSteps = Max(2, (int)ceilf(rise / 0.19f));
    const float stepH = rise / nSteps, run = 0.27f, flight = (nSteps - 1) * run;
    const float yard = dot(b.lotC - b.c, b.front) + b.lotHy - b.hy - dep;
    const float ue = stairSide * ((stairSide > 0.f ? front.y : -front.x) - 0.6f);   // the head's centre along the front
    const bool toStreet = yard > flight + 1.4f, alongFront = !toStreet && yard > 1.6f;
    if (toStreet || alongFront) {
        // the landing in front of the deck edge
        vec2 lc = e.P(ue, front.w + 0.5f);
        yardKeep(x, lc, e.ax, e.fr, 0.5f, 0.5f);
        x.m->box(vec3(lc, zd - 0.06f) - x.org, X, Y, Z, vec3(0.5f, 0.5f, 0.06f), deckCol, woodMat, true);
        addCollision(x, lc, e.ax, 0.5f, 0.5f, zd - 0.3f, zd);
        for (int i = -1; i <= 1 && x.detail; i += 2)
            for (int j = 0; j < 2; j++) {
                vec2 pp = e.P(ue + i * 0.42f, front.w + 0.08f + j * 0.84f);
                x.m->box(vec3(pp, (z0 - 0.3f + zd - 0.12f) * 0.5f) - x.org, X, Y, Z, vec3(0.07f, 0.07f, (zd - 0.12f - z0 + 0.3f) * 0.5f), post, woodMat);
            }
        // treads (u along the flight, w across it) and the two stringers
        vec2 fdir = toStreet ? e.fr : e.ax * -stairSide, fside = toStreet ? e.ax : e.fr;
        vec2 start = toStreet ? e.P(ue, front.w + 1.f) : e.P(ue - stairSide * 0.5f, front.w + 0.5f);
        yardKeep(x, start + fdir * (flight * 0.5f), fdir, fside, flight * 0.5f + 0.1f, 0.5f);
        for (int k = 1; k < nSteps; k++) {
            float zt = zd - k * stepH;
            vec2 c = start + fdir * ((k - 0.5f) * run);
            if (x.detail) x.m->box(vec3(c, zt - 0.03f) - x.org, vec3(fdir, 0.f), vec3(fside, 0.f), Z, vec3(run * 0.5f + 0.02f, 0.46f, 0.03f), deckCol, woodMat);
            addCollision(x, c, fdir, run * 0.5f, 0.46f, zt - 0.4f, zt);
        }
        // (the far LOD keeps the stringers: the stair's outline)
        for (int sd = -1; sd <= 1; sd += 2) {
            vec3 p0 = vec3(start + fside * (sd * 0.48f), zd - 0.12f), p1 = vec3(start + fdir * flight + fside * (sd * 0.48f), z0 - 0.05f);
            vec3 dir = p1 - p0;
            float l = length(dir);
            dir = dir / l;
            vec3 up = normalize(cross(dir, vec3(fside, 0.f)));
            if (up.z < 0.f) up = -up;
            x.m->box((p0 + p1) * 0.5f - x.org, dir, vec3(fside, 0.f), up, vec3(l * 0.5f, 0.03f, 0.13f), post, woodMat);
            if (x.detail) {
                // handrail
                x.m->box((p0 + p1) * 0.5f + vec3(0, 0, 0.95f) - x.org, dir, vec3(fside, 0.f), up, vec3(l * 0.5f, 0.025f, 0.03f), railCol, railMat);
            }
        }
    }
    // railings round the deck edges: not along the house walls, open where the decks meet and at the stair head
    const float zr = zd + 0.95f;
    auto railRun = [&](vec2 a, vec2 c) {   // (u, v) ends
        vec2 wa = e.P(a.x, a.y), wb = e.P(c.x, c.y);
        vec2 t = wb - wa;
        float len = length(t);
        if (len < 0.3f) return;
        t = t / len;
        vec3 T(t, 0.f), N(perp(t), 0.f);
        if (!x.detail) return;
        x.m->box(vec3((wa + wb) * 0.5f, zr) - x.org, T, N, Z, vec3(len * 0.5f, 0.04f, 0.04f), railCol, railMat);
        {
            int nb = Max(1, (int)(len / 1.2f));
            for (int i = 0; i <= nb; i++) {
                vec2 pp = wa + t * (len * i / nb);
                x.m->box(vec3(pp, (zd + zr) * 0.5f) - x.org, T, N, Z, vec3(0.04f, 0.04f, (zr - zd) * 0.5f), railCol, railMat);
            }
            x.m->box(vec3((wa + wb) * 0.5f, zd + 0.45f) - x.org, T, N, Z, vec3(len * 0.5f, 0.025f, 0.025f), railCol, railMat);
        }
    };
    for (size_t di = 0; di < decks.size(); di++) {
        const vec4& d = decks[di];
        vec2 corners[4] = {vec2(d.x, d.z), vec2(d.y, d.z), vec2(d.y, d.w), vec2(d.x, d.w)};
        for (int k = 0; k < 4; k++) {
            vec2 a = corners[k], c = corners[(k + 1) % 4];
            vec2 mid = (a + c) * 0.5f;
            if (fabsf(mid.x) <= hx + 0.01f && fabsf(mid.y) <= hy + 0.01f) continue;   // along a house wall
            if (di == 1 && k == 2) continue;                                           // the side deck's end meets the front deck
            bool frontEdge = di == 0 && k == 2;
            if (frontEdge && (toStreet || alongFront)) {
                // (c -> a runs along the front edge from u = d.y to u = d.x)
                float g0 = ue - 0.5f, g1 = ue + 0.5f;
                if (g1 < d.y) railRun(vec2(d.y, d.w), vec2(g1, d.w));
                if (g0 > d.x) railRun(vec2(g0, d.w), vec2(d.x, d.w));
                continue;
            }
            railRun(a, c);
        }
    }
    // porch roof over the front deck (or the front strip of an all-round deck), its posts clear of the stair head
    if (porchRoof) {
        float u0 = front.x, u1 = front.y;
        float zE = zTop - 0.75f;
        int np = Max(2, (int)roundf((u1 - u0) / 2.6f) + 1);
        for (int k = 0; k < np; k++) {
            float u = Lerp(u0 + 0.12f, u1 - 0.12f, (float)k / (np - 1));
            if ((toStreet || alongFront) && fabsf(u - ue) < 0.6f) continue;
            vec2 pp = e.P(u, hy + dep - 0.12f);
            if (x.detail) x.m->box(vec3(pp, (zd + zE) * 0.5f) - x.org, X, Y, Z, vec3(0.07f, 0.07f, (zE - zd) * 0.5f), railCol, railMat);
            addCollision(x, pp, e.ax, 0.08f, 0.08f, zd, zE);
        }
        vec3 a0 = vec3(e.P(u0 - 0.15f, hy), zE + 0.6f) - x.org, a1 = vec3(e.P(u1 + 0.15f, hy), zE + 0.6f) - x.org;
        vec3 b0 = vec3(e.P(u0 - 0.15f, hy + dep + 0.25f), zE) - x.org, b1 = vec3(e.P(u1 + 0.15f, hy + dep + 0.25f), zE) - x.org;
        x.m->quadFacing(a0, a1, b1, b0, vec2(0, 0), vec2(u1 - u0, 0), vec2(u1 - u0, dep), vec2(0, dep), roofCol, roofMat, vec3(e.fr, 2.f));
        x.m->quadFacing(a0, b0, b1, a1, vec2(0, 0), vec2(dep, 0), vec2(dep, u1 - u0), vec2(0, u1 - u0), post, woodMat, vec3(-e.fr, -2.f));
    }
    // rain-water cistern on a stand at a back corner
    if (cistern) {
        vec2 cc = e.P(side * (hx - 1.f), -hy - (dk == 0 ? dw : 0.f) - 1.1f);
        float r = 0.75f, hh = 1.6f;
        yardKeep(x, cc, e.ax, e.fr, 0.8f, 0.8f);
        for (int i = -1; i <= 1 && x.detail; i += 2)
            for (int j = -1; j <= 1; j += 2)
                x.m->box(vec3(cc + e.ax * (i * 0.55f) + e.fr * (j * 0.55f), (z0 + zf - 0.9f) * 0.5f) - x.org, X, Y, Z, vec3(0.07f, 0.07f, (zf - 0.9f - z0) * 0.5f), post, woodMat);
        if (x.detail) {
            x.m->box(vec3(cc, zf - 0.95f) - x.org, X, Y, Z, vec3(0.75f, 0.75f, 0.06f), post, woodMat, true);
            x.m->cylinder(vec3(cc, zf - 0.9f) - x.org, r, r, hh, 12, packRGBA8(0.88f, 0.88f, 0.86f, 1), makeMat(MAT_METAL_PAINTED), true);
        }
        addCollision(x, cc, e.ax, 0.8f, 0.8f, z0 - 0.5f, zf - 0.9f + hh);
    }
}

}  // namespace massing

// Archetype house body: walls, roofs, porch and small tower; the garage wing, garden, pool and trees stay with the
// generic house code (buildmesh.cpp), which gets the roof finish for the garage. Returns false for plain houses.
// A mobile home (the fishing village, the Keys, the edges of the county towns, the farms): a long low box on blocks behind
// a skirt, lap siding with small windows (the facade shader), on half of them a painted band, a very low tin gable or a
// shingled roof-over. A wooden deck with steps and a rail at the door - facadedetail.cpp puts the door at the pier
// nearest the middle of the front wall - sometimes under an aluminium awning. The box fills the envelope's front
// (gameplay's door slot stands just in front of b.hy); a double-wide where the envelope is deep enough. The carport is
// buildmesh.cpp's.
void buildTrailer(Ctx& x, const Building& b, const FacadeGPU& fac, u32& roofCol, u32& roofMat) {
    using namespace massing;
    Rng mr(b.seed ^ 0x7A1E5u), hr(b.seed ^ 0x40053u);
    Env e = envOf(b);
    const float hx = b.hx, hy = b.hy;
    x.trimMat = b.style == BS_FARMHOUSE ? 0u : makeMat(MAT_PLASTER);
    houseRoofFinish(b, hr, roofCol, roofMat);
    const float zf = b.baseZ + mr.range(0.55f, 0.8f), zTop = zf + b.height;
    const float D = trailerDepth(b);
    const float L = Min(2.f * hx, Max(6.f, 2.f * hx - mr.range(0.f, 0.8f)));
    const float u0 = -L * 0.5f, u1 = L * 0.5f, v1 = hy, v0 = hy - D;
    std::vector<vec2> fp = toWorld(e, rectUV(u0, u1, v0, v1));
    recordMass(x, fp, zf, zTop, zf, FM_HOUSE, false);
    facadeWalls(x, fp, zf - 0.02f, zTop, zf, b.facade, fac.bayW);
    addCollision(x, e.P(0.f, (v0 + v1) * 0.5f), e.ax, L * 0.5f, D * 0.5f, b.baseZ - 1.f, zTop + 0.6f);
    // the skirt from the ground up to the floor, a little in from the walls: vinyl lattice or painted block
    const vec3 sk[] = {vec3(0.95f, 0.95f, 0.93f), vec3(0.88f, 0.84f, 0.74f), vec3(0.72f, 0.72f, 0.7f), vec3(0.8f, 0.78f, 0.74f)};
    const vec3 skc = sk[mr.next() % 4u];
    const bool block = mr.chance(0.25f);
    plainWalls(x, toWorld(e, rectUV(u0 + 0.06f, u1 - 0.06f, v0 + 0.06f, v1 - 0.06f)), b.baseZ - 0.5f, zf, packRGBA8(skc.x, skc.y, skc.z, 1),
               makeMat(block ? MAT_STUCCO : MAT_PLASTER));
    // the painted band of the older ones: under the eaves above the windows, or low below the sills
    if (mr.chance(0.5f)) {
        const vec3 bands[] = {vec3(0.45f, 0.3f, 0.2f), vec3(0.2f, 0.35f, 0.55f), vec3(0.3f, 0.45f, 0.3f), vec3(0.6f, 0.2f, 0.18f), vec3(0.75f, 0.6f, 0.3f)};
        const vec3 bc = bands[mr.next() % 5u];
        const float zb0 = mr.chance(0.5f) ? zTop - 0.32f : zf + 0.25f, hb = mr.range(0.16f, 0.24f);
        plainWalls(x, toWorld(e, rectUV(u0 - 0.015f, u1 + 0.015f, v0 - 0.015f, v1 + 0.015f)), zb0, zb0 + hb, packRGBA8(bc.x, bc.y, bc.z, 1),
                   makeMat(MAT_METAL_PAINTED));
    }
    // roof: a very low tin gable along the length, or a shingled roof-over with a deeper overhang
    const bool over = (roofMat & 0xffu) == MAT_ROOF_SHINGLE;
    vec4 wc4 = unpackRGBA8(fac.wallColor);
    const u32 gableCol = packRGBA8(Saturate(wc4.x * 1.45f), Saturate(wc4.y * 1.45f), Saturate(wc4.z * 1.45f), 1);
    pitchedPart(x, e, vec4(u0, u1, v0, v1), zTop, over ? mr.range(0.22f, 0.3f) : mr.range(0.06f, 0.1f), false, over ? 0.35f : 0.1f, roofCol, roofMat, gableCol,
                makeMat(MAT_WOOD_SIDING), 0);
    // the deck at the door: the pier nearest the middle of the front wall, which runs from (u1, v1) toward -u (from (u0, v1)
    // toward +u when the winding is mirrored)
    const int bays = Max(1, (int)roundf(L / Max(fac.bayW, 0.5f)));
    const float bw = L / (float)bays;
    const float ud0 = e.flip ? u0 + (bays / 2) * bw : u1 - (bays / 2) * bw;
    const float dkw = mr.range(1.1f, 1.5f), dkd = mr.range(1.6f, 2.3f);
    const float ud = Clamp(ud0, u0 + dkw + 0.1f, u1 - dkw - 0.1f);
    const u32 wood = packRGBA8(0.72f, 0.64f, 0.54f, 1), woodM = makeMat(MAT_WOOD);
    const u32 rail = b.style == BS_FARMHOUSE ? wood : packRGBA8(0.95f, 0.95f, 0.93f, 1), railM = trimWood(x);
    vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
    const float zd = zf - 0.03f;
    const vec2 dc = e.P(ud, v1 + dkd * 0.5f);
    const float gz = gMap ? gMap->heightAt(dc.x, dc.y) : b.baseZ;
    yardKeep(x, dc, e.ax, e.fr, dkw + 0.3f, dkd * 0.5f + 1.2f);
    if (x.detail) {
        x.m->box(vec3(dc, zd - 0.07f) - x.org, X, Y, Z, vec3(dkw, dkd * 0.5f, 0.07f), wood, woodM, true);
        // posts under the deck's outer corners
        for (int k = -1; k <= 1; k += 2) {
            vec2 pp = e.P(ud + k * (dkw - 0.1f), v1 + dkd - 0.1f);
            float pz = gMap ? gMap->heightAt(pp.x, pp.y) : b.baseZ;
            x.m->box(vec3(pp, (pz + zd - 0.14f) * 0.5f) - x.org, X, Y, Z, vec3(0.06f, 0.06f, Max(0.05f, (zd - 0.14f - pz) * 0.5f + 0.1f)), wood, woodM);
        }
        // the rail along the two sides and the front either side of the steps
        const float rh = 0.9f, sw = 0.55f;
        for (int k = -1; k <= 1; k += 2) {
            vec2 rc = e.P(ud + k * (dkw - 0.04f), v1 + dkd * 0.5f);
            x.m->box(vec3(rc, zd + rh) - x.org, X, Y, Z, vec3(0.04f, dkd * 0.5f, 0.04f), rail, railM);
            for (int q = 0; q < 2; q++) {
                vec2 pc = e.P(ud + k * (dkw - 0.04f), v1 + (q ? dkd - 0.04f : 0.15f));
                x.m->box(vec3(pc, zd + rh * 0.5f) - x.org, X, Y, Z, vec3(0.04f, 0.04f, rh * 0.5f), rail, railM);
            }
            float a0 = ud + k * sw, a1 = ud + k * (dkw - 0.04f);
            vec2 fc = e.P((a0 + a1) * 0.5f, v1 + dkd - 0.04f);
            x.m->box(vec3(fc, zd + rh) - x.org, X, Y, Z, vec3(fabsf(a1 - a0) * 0.5f, 0.04f, 0.04f), rail, railM);
            vec2 sp = e.P(a0, v1 + dkd - 0.04f);
            x.m->box(vec3(sp, zd + rh * 0.5f) - x.org, X, Y, Z, vec3(0.04f, 0.04f, rh * 0.5f), rail, railM);
        }
        // an aluminium awning over the deck on two slim posts
        if (mr.chance(0.4f)) {
            const u32 al = packRGBA8(0.93f, 0.93f, 0.92f, 1), alM = makeMat(MAT_METAL_PAINTED);
            const float za = zTop - 0.12f;
            vec3 a0 = vec3(e.P(ud - dkw - 0.2f, v1), za) - x.org, a1 = vec3(e.P(ud + dkw + 0.2f, v1), za) - x.org;
            vec3 b0 = vec3(e.P(ud - dkw - 0.2f, v1 + dkd + 0.25f), za - 0.25f) - x.org, b1 = vec3(e.P(ud + dkw + 0.2f, v1 + dkd + 0.25f), za - 0.25f) - x.org;
            x.m->quadFacing(a0, a1, b1, b0, vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), al, alM, vec3(e.fr, 3.f));
            x.m->quadFacing(a0, b0, b1, a1, vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), al, alM, vec3(-e.fr, -3.f));
            for (int k = -1; k <= 1; k += 2) {
                vec2 pp = e.P(ud + k * (dkw + 0.1f), v1 + dkd + 0.1f);
                x.m->box(vec3(pp, (zd + za - 0.25f) * 0.5f) - x.org, X, Y, Z, vec3(0.035f, 0.035f, (za - 0.25f - zd) * 0.5f), al, alM);
            }
        }
    }
    // the deck walkable from the ground: solid under its boards, steps down to the yard at the front
    addCollision(x, dc, e.ax, dkw, dkd * 0.5f, gz - 0.6f, zd);
    if (x.detail) deckSteps(x, e, ud, 1.0f, v1 + dkd, zd, gz, wood, woodM);
}

bool buildArchHouseBody(Ctx& x, const Building& b, const FacadeGPU& fac, u32& roofCol, u32& roofMat) {
    using namespace massing;
    if (b.arch == AR_NONE || b.interior >= 0) return false;
    if ((b.style == BS_SHACK && b.arch == AR_SHACK_STILT) || (b.style == BS_HOUSE && b.arch == AR_HOUSE_RAISED)) {
        buildStiltShack(x, b, fac, roofCol, roofMat);
        return true;
    }
    if ((b.style == BS_HOUSE || b.style == BS_FARMHOUSE) && b.arch == AR_HOUSE_TRAILER) {
        buildTrailer(x, b, fac, roofCol, roofMat);
        return true;
    }
    if (b.style != BS_HOUSE && b.style != BS_VILLA && b.style != BS_FARMHOUSE) return false;
    x.trimMat = b.style == BS_FARMHOUSE ? 0u : makeMat(MAT_PLASTER);   // (painted trim in town)
    Rng mr(b.seed ^ 0x4D455353u), hr(b.seed ^ 0x40053u);
    Env e = envOf(b);
    const float hx = b.hx, hy = b.hy;
    const bool conch = b.arch == AR_HOUSE_CONCH;
    const float zb = b.baseZ + (conch ? conchRaise(b) : 0.f);
    const float gs = (b.seed & 64u) ? 1.f : -1.f;   // the garage wing's side (buildmesh.cpp / population.cpp)
    // conch porch: 0 full-width shed porch, 1 a front-gabled porch (the house gable to the street), 2 round the front
    // and a side, 3 a small entry porch; two-storey houses mostly a double gallery (4)
    int conchPorch = 0;
    if (conch) {
        u32 cv = hash32(b.seed ^ 0xC0C5u) % 100u;
        conchPorch = (b.floors >= 2 && cv < 55u) ? 4 : (cv < 35u ? 0 : (cv < 60u ? 1 : (cv < 82u ? 2 : 3)));
        // (round the side only where the side yard has room for it beside the hedge: the side away from the garage)
        float sideRoom = b.lotHx - dot(b.c - b.lotC, b.ax) * -gs - hx;
        if (conchPorch == 2 && sideRoom < 4.3f) conchPorch = 0;
    }
    const float H = b.height, zTop = zb + H;
    houseRoofFinish(b, hr, roofCol, roofMat);
    const u32 wallTrim = packRGBA8(0.95f, 0.95f, 0.93f, 1);
    vec4 wcol = unpackRGBA8(fac.wallColor);
    const u32 gableCol = packRGBA8(Saturate(wcol.x * 1.45f), Saturate(wcol.y * 1.45f), Saturate(wcol.z * 1.45f), 1);
    const u32 gableMat = makeMat((u32)fac.wallLayer == MAT_WOOD_SIDING ? MAT_WOOD_SIDING : MAT_PLASTER);
    const float skirt = conch ? 0.75f : 2.f;
    struct Part {
        vec4 r;
        float z1;
        u8 kind;
    };
    std::vector<Part> parts;
    std::vector<vec2> mainUV = rectUV(-hx, hx, -hy, hy);
    bool flat = b.arch == AR_HOUSE_MIMO || b.arch == AR_VILLA_MODERN;
    // a Mediterranean Revival house with a flat roof behind a parapet and a barrel-tile pent along the front (blockstyle.cpp
    // gives a quarter of them ROOF_FLAT)
    const bool medFlat = b.arch == AR_HOUSE_MED && b.roof == ROOF_FLAT;
    float pitch = 0.4f;
    bool hip = b.roof == ROOF_HIP;
    int ridge = -1;
    switch (b.arch) {
        case AR_HOUSE_RANCH: pitch = mr.range(0.26f, 0.34f); break;
        case AR_HOUSE_BUNGALOW: pitch = mr.range(0.45f, 0.6f); ridge = hx <= hy * 1.25f ? 1 : -1; break;   // gable to the street
        case AR_HOUSE_MED: pitch = mr.range(0.3f, 0.36f); hip = true; break;
        case AR_HOUSE_TWO: pitch = mr.range(0.4f, 0.55f); break;
        case AR_HOUSE_SPLIT: pitch = mr.range(0.35f, 0.45f); break;
        case AR_HOUSE_CONCH: pitch = mr.range(0.5f, 0.68f); if (conchPorch == 1 && hx <= hy * 1.4f) ridge = 1; break;
        case AR_VILLA_MED: pitch = mr.range(0.3f, 0.36f); hip = true; break;
        case AR_VILLA_COLONIAL: pitch = mr.range(0.36f, 0.46f); hip = true; break;
        case AR_HOUSE_CBS: pitch = mr.range(0.22f, 0.3f); break;   // (hip, or a side gable on a fifth: blockstyle.cpp)
        case AR_HOUSE_VICTORIAN: pitch = mr.range(0.75f, 0.95f); hip = false; ridge = 0; break;   // (side gables; the leg's to the street)
        default: break;
    }
    // the forms inside the bungalow and the two-storey house (blockstyle.cpp houseForm): Craftsman side gable, hipped
    // bungalow, airplane bungalow, American Foursquare - their own stream, so the plain ones keep theirs
    const int form = blockstyle::houseForm(b);
    const u32 fh = hash32(b.seed ^ 0xC2AF8u);
    const float fq = hashToFloat(fh), fq2 = hashToFloat(hash32(fh + 7u)), fq3 = hashToFloat(hash32(fh + 13u));
    const bool town = b.region == REG_LAKE_TOWN || b.region == REG_HARLOW || b.region == REG_FORT_CASTELL || b.region == REG_REDLAND || b.region == REG_FARMLAND;
    float formOver = 0.6f;
    const bool mission = form == blockstyle::HF_BUNG_MISSION;   // (a flat roof behind a parapet, the curved gable: blockstyle sets ROOF_FLAT)
    if (form == blockstyle::HF_BUNG_SIDE) pitch = Min(pitch, 0.52f), ridge = 0, formOver = 0.75f;
    else if (form == blockstyle::HF_BUNG_HIP) pitch *= 0.82f, ridge = -1, hip = true, formOver = 0.7f;
    else if (form == blockstyle::HF_FOURSQUARE) pitch = 0.4f + 0.12f * fq, ridge = -1, hip = true, formOver = 0.75f;
    // (the Craftsman porch: square columns on brick or stone piers on most of the Craftsman forms, on some foursquares; round
    // columns on others)
    if (form != blockstyle::HF_PLAIN || (b.arch == AR_HOUSE_BUNGALOW && b.massing == MK_BOX && fq2 < (town ? 0.45f : 0.25f))) {
        const bool fs = form == blockstyle::HF_FOURSQUARE;
        x.porchPosts = fs ? (fq2 < 0.45f ? 1 : (fq2 < 0.75f ? 2 : 0)) : (fq2 < 0.8f ? 1 : 0);
        const u32 ph = hash32(b.seed ^ 0x9E12u) % 100u;
        vec4 wc4 = unpackRGBA8(fac.wallColor);
        if (ph < 50u) x.pierCol = packRGBA8(0.72f, 0.45f, 0.37f, 1), x.pierMat = makeMat(MAT_BRICK);
        else if (ph < 75u) x.pierCol = packRGBA8(0.82f, 0.8f, 0.76f, 1), x.pierMat = makeMat(MAT_STONE);
        else x.pierCol = packRGBA8(Saturate(wc4.x * 1.45f), Saturate(wc4.y * 1.45f), Saturate(wc4.z * 1.45f), 1), x.pierMat = makeMat((u32)fac.wallLayer == MAT_WOOD_SIDING ? MAT_WOOD_SIDING : MAT_PLASTER);
        // (the Mission bungalow's loggia: square stucco piers in the wall's colour)
        if (mission) x.porchPosts = 3, x.pierCol = gableCol, x.pierMat = gableMat;
    }
    float sweptDep = 0.f, sweptPorchZ = 0.f, sweptPitch = 0.f;   // (the Craftsman side gable's porch, from its roof)
    // massing: rectangles of the body (u0, u1, v0, v1) and their eave heights
    std::vector<vec2> uvPoly;
    switch (b.massing) {
        case MK_L: {
            // full width at the back, a front leg on the garage side (the entry sits in the inner corner)
            float lw = Clamp(2.f * hx * mr.range(0.4f, 0.55f), 3.5f, 2.f * hx - 3.5f), ld = Clamp(2.f * hy * mr.range(0.32f, 0.48f), 2.5f, 2.f * hy - 4.f);
            float vc = hy - ld;
            if (gs > 0.f) {
                float ua = hx - lw;
                uvPoly = {vec2(-hx, -hy), vec2(hx, -hy), vec2(hx, hy), vec2(ua, hy), vec2(ua, vc), vec2(-hx, vc)};
                parts.push_back({vec4(-hx, hx, -hy, vc), zTop, FM_HOUSE});
                parts.push_back({vec4(ua, hx, vc, hy), zTop, FM_HOUSE});
            } else {
                float ub = -hx + lw;
                uvPoly = {vec2(-hx, -hy), vec2(hx, -hy), vec2(hx, vc), vec2(ub, vc), vec2(ub, hy), vec2(-hx, hy)};
                parts.push_back({vec4(-hx, hx, -hy, vc), zTop, FM_HOUSE});
                parts.push_back({vec4(-hx, ub, vc, hy), zTop, FM_HOUSE});
            }
            break;
        }
        case MK_SPLIT: {
            // split level: a two-storey wing beside a one-storey wing (the garage side)
            float us = -hx + 2.f * hx * mr.range(0.42f, 0.56f);
            float zLow = zb + fac.groundH;
            if (gs > 0.f) {
                parts.push_back({vec4(-hx, us, -hy, hy), zTop, FM_HOUSE});
                parts.push_back({vec4(us, hx, -hy + 1.f, hy - 0.6f), zLow, FM_WING});
            } else {
                parts.push_back({vec4(us, hx, -hy, hy), zTop, FM_HOUSE});
                parts.push_back({vec4(-hx, us, -hy + 1.f, hy - 0.6f), zLow, FM_WING});
            }
            break;
        }
        case MK_WINGS: {
            // two-storey block with a one-storey wing on the side away from the garage
            float mw = 2.f * hx * mr.range(0.58f, 0.7f);
            float zLow = zb + fac.groundH;
            if (gs > 0.f) {
                parts.push_back({vec4(hx - mw, hx, -hy, hy), zTop, FM_HOUSE});
                parts.push_back({vec4(-hx, hx - mw, -hy + 0.8f, hy - 1.2f), zLow, FM_WING});
            } else {
                parts.push_back({vec4(-hx, -hx + mw, -hy, hy), zTop, FM_HOUSE});
                parts.push_back({vec4(-hx + mw, hx, -hy + 0.8f, hy - 1.2f), zLow, FM_WING});
            }
            break;
        }
        case MK_STEP_FRONT: {
            // ranch and block houses: a gable-fronted bay forward a little off the middle of the front, the rest of the
            // front set back (the entry beside the bay); a narrow or shallow house stays a box
            if (hx < 4.f || hy < 4.f) {
                parts.push_back({vec4(-hx, hx, -hy, hy), zTop, FM_HOUSE});
                break;
            }
            float bw = Clamp(2.f * hx * mr.range(0.3f, 0.42f), 3.2f, Max(3.2f, 2.f * hx - 4.f)), rec = Clamp(mr.range(1.0f, 1.8f), 0.8f, Max(0.8f, hy * 0.35f));
            float bcu = mr.range(-0.25f, 0.25f) * Max(0.f, 2.f * hx - bw);
            float u0 = bcu - bw * 0.5f, u1 = bcu + bw * 0.5f, vf = hy - rec;
            uvPoly = {vec2(-hx, -hy), vec2(hx, -hy), vec2(hx, vf), vec2(u1, vf), vec2(u1, hy), vec2(u0, hy), vec2(u0, vf), vec2(-hx, vf)};
            parts.push_back({vec4(-hx, hx, -hy, vf), zTop, FM_HOUSE});
            parts.push_back({vec4(u0, u1, vf, hy), zTop, FM_HOUSE});
            break;
        }
        case MK_STEP_BACK: {
            // modern villa: the ground floor recessed under a cantilevered upper floor
            float rec = Min(2.6f, hy * 0.3f);
            float zl = zb + fac.groundH;
            parts.push_back({vec4(-hx, hx, -hy, hy - rec), zl, FM_HOUSE});
            parts.push_back({vec4(-hx + Min(3.f, hx * 0.3f), hx, -hy + 1.5f, hy), zTop, FM_WING});
            break;
        }
        default: parts.push_back({vec4(-hx, hx, -hy, hy), zTop, FM_HOUSE}); break;
    }
    // walls and masses: the main body (one FM_HOUSE mass: garden, door) and the other parts as wings
    bool mainDone = false;
    if (!uvPoly.empty()) {
        std::vector<vec2> fp = toWorld(e, uvPoly);
        recordMass(x, fp, zb, zTop, zb, FM_HOUSE, false);
        facadeWalls(x, fp, zb - skirt, zTop, zb, b.facade, fac.bayW);
        mainDone = true;
    }
    for (const Part& p : parts) {
        bool isMain = p.kind == FM_HOUSE;
        if (!(isMain && mainDone)) {
            // a wing standing on the upper floor of a stepped villa starts at the floor line
            float zs = (b.massing == MK_STEP_BACK && !isMain) ? zb + fac.groundH : zb;
            std::vector<vec2> fp = toWorld(e, rectUV(p.r.x, p.r.y, p.r.z, p.r.w));
            recordMass(x, fp, zs, p.z1, zb, isMain ? FM_HOUSE : FM_WING, false);
            facadeWalls(x, fp, zs - (zs > zb + 0.1f ? 0.f : skirt), p.z1, zb, b.facade, fac.bayW);
            if (isMain) mainDone = true;
        }
        vec2 cc = e.P((p.r.x + p.r.y) * 0.5f, (p.r.z + p.r.w) * 0.5f);
        addCollision(x, cc, e.ax, (p.r.y - p.r.x) * 0.5f, (p.r.w - p.r.z) * 0.5f, b.baseZ - 2.f, p.z1 + (flat ? 0.3f : ((medFlat || mission) ? 0.8f : 2.f)));
    }
    // roofs
    for (const Part& p : parts) {
        vec4 r = p.r;
        if (flat) {
            if (b.roofForm == RFM_BUTTERFLY && p.kind == FM_HOUSE) butterflyRoof(x, e, r.x, r.y, r.z, r.w, p.z1, 0.9f, roofCol);
            else eaveSlab(x, toWorld(e, rectUV(r.x, r.y, r.z, r.w)), p.z1, b.arch == AR_VILLA_MODERN ? 0.7f : 1.1f, 0.25f, packRGBA8(0.96f, 0.96f, 0.95f, 1));
        } else if (mission) {
            // the Mission bungalow: the flat roof behind a low parapet, the curved gable over the middle of the front
            std::vector<vec2> fp = toWorld(e, rectUV(r.x, r.y, r.z, r.w));
            flatRoof(x, fp, p.z1 + 0.02f, x.roofCol, x.roofMat);
            const float ph = 0.55f;
            if (x.detail) {
                parapet(x, fp, p.z1, ph, 0.22f, gableCol, gableMat);
                plainWalls(x, fp, p.z1, p.z1 + ph, gableCol, gableMat);
            }
            const float gw = Clamp((r.y - r.x) * (0.5f + 0.15f * fq3), 3.f, 7.f), gc = (r.x + r.y) * 0.5f;
            missionGable(x, e, gc - gw * 0.5f, gc + gw * 0.5f, r.w, p.z1 + ph, 0.7f + 0.5f * fq, 0.22f, gableCol, gableMat, roofCol);
        } else if (medFlat) {
            // the flat roof behind a stucco parapet; the tile pent along the street side of the parts that reach it
            std::vector<vec2> fp = toWorld(e, rectUV(r.x, r.y, r.z, r.w));
            flatRoof(x, fp, p.z1 + 0.02f, x.roofCol, x.roofMat);
            if (x.detail) {
                // (the parapet's inner face and cap, and its outer face: the walls stop at the roof)
                parapet(x, fp, p.z1, 0.75f, 0.22f, gableCol, gableMat);
                plainWalls(x, fp, p.z1, p.z1 + 0.75f, gableCol, gableMat);
            }
            if (r.w > hy - 0.3f) {
                // (pentRoof leans out to the right of a -> b: run it so that side is the street)
                vec2 pa = e.P(r.x, r.w), pb = e.P(r.y, r.w), t = pb - pa;
                if (dot(vec2(t.y, -t.x), e.fr) < 0.f) std::swap(pa, pb);
                pentRoof(x, pa, pb, p.z1 + 0.1f, 0.85f, roofCol);
            }
        } else {
            bool partHip = hip || p.kind == FM_WING;
            // the archetype's ridge (bungalow: gable to the street); the leg of an L and the wings along their longer side
            int rd = (b.massing == MK_L || p.kind == FM_WING) ? -1 : ridge;
            // folk Victorian: the cross gable - the body's ridge along the street, the front leg's gable to the street;
            // the front bay of a ranch or block house: its gable to the street on the body's roof
            if (b.arch == AR_HOUSE_VICTORIAN) rd = (b.massing == MK_L && &p != &parts[0]) ? 1 : 0;
            if (b.massing == MK_STEP_FRONT && parts.size() > 1) {
                rd = &p != &parts[0] ? 1 : 0;
                if (&p != &parts[0]) partHip = false;
            }
            float over = b.arch == AR_HOUSE_RANCH ? 0.85f : (b.arch == AR_HOUSE_CBS ? 0.75f : (b.arch == AR_HOUSE_VICTORIAN ? 0.35f : formOver));
            if (form == blockstyle::HF_BUNG_SIDE && parts.size() == 1) {
                // the Craftsman side gable sweeps on down over the porch across the front
                const float yardC = dot(b.lotC - b.c, b.front) + b.lotHy - hy;
                sweptDep = Clamp(2.1f + 0.5f * fq2, 1.6f, Max(1.6f, yardC - 1.4f));
                sweptPorchZ = sweptGable(x, e, r.x, r.y, r.z, r.w, p.z1, pitch, over, sweptDep, roofCol, roofMat, gableCol, gableMat, wallTrim);
                sweptPitch = Min(pitch * 0.5f, 0.26f);
            } else pitchedPart(x, e, r, p.z1, pitch, partHip, over, roofCol, roofMat, gableCol, gableMat, rd);
        }
    }
    // the cantilevered upper floor of a stepped villa: its underside over the recessed entrance
    if (b.massing == MK_STEP_BACK && parts.size() > 1) {
        const vec4& r = parts[1].r;
        float vr = parts[0].r.w;
        std::vector<vec2> under = toWorld(e, rectUV(r.x, r.y, vr, r.w));
        std::vector<vec3> poly;
        for (int i = (int)under.size() - 1; i >= 0; i--) poly.push_back(vec3(under[i], zb + fac.groundH) - x.org);
        x.m->polygon(poly, vec3(0, 0, -1), packRGBA8(0.92f, 0.92f, 0.9f, 1), makeMat(MAT_PLASTER), 1.f);
    }
    // Mediterranean house: a small tower with a tile hip roof at the front corner away from the garage
    if ((b.arch == AR_HOUSE_MED || b.arch == AR_VILLA_MED) && b.massing == MK_CORNER_TOWER) {
        float ts = b.arch == AR_VILLA_MED ? Clamp(Min(hx, hy) * 0.5f, 3.6f, 5.2f) : Clamp(Min(hx, hy) * 0.55f, 2.8f, 4.2f);
        float u0 = gs > 0.f ? -hx : hx - ts, u1 = u0 + ts;
        std::vector<vec2> fp = toWorld(e, rectUV(u0, u1, hy - ts, hy));
        float zt = zTop + 2.6f;
        recordMass(x, fp, zTop - 0.3f, zt, zb, FM_WING, false);
        facadeWalls(x, fp, zTop - 0.3f, zt, zb, b.facade, fac.bayW);
        pitchedPart(x, e, vec4(u0, u1, hy - ts, hy), zt, 0.55f, true, 0.35f, roofCol, roofMat, gableCol, gableMat);
        addCollision(x, e.P((u0 + u1) * 0.5f, hy - ts * 0.5f), e.ax, ts * 0.5f, ts * 0.5f, zTop - 0.3f, zt + 1.5f);
    }
    // porches: bungalow front gable, conch house full-width shed porch (two-level gallery on two-storey conch houses)
    if (b.arch == AR_HOUSE_BUNGALOW && b.massing == MK_L && parts.size() > 1) {
        // an L bungalow: the porch fills the inner corner, under its own small gable
        const vec4 leg = parts[1].r;
        const float vc = parts[0].r.w;
        float nu0 = leg.x > -hx + 0.1f ? -hx : leg.y, nu1 = leg.x > -hx + 0.1f ? leg.x : hx;
        float dep = Min(2.4f, hy - vc - 0.1f);
        bool rail = mr.chance(0.5f);
        if (nu1 - nu0 > 2.f && dep > 1.2f) housePorch(x, e, vc, nu0 + 0.1f, nu1 - 0.1f, dep, zb, zb + 2.6f, 0, roofCol, roofMat, wallTrim, rail);
    } else if (b.arch == AR_HOUSE_BUNGALOW) {
        // the porch over the door (facadedetail.cpp's door: the pier nearest the middle of the front)
        const float ud = houseDoorU(e, -hx, hx, fac.bayW);
        const float yardC = dot(b.lotC - b.c, b.front) + b.lotHy - hy;
        const RoofShape rs = roofShape(-hx, hx, -hy, hy, zTop, pitch, formOver, hip, ridge);
        if (form == blockstyle::HF_BUNG_SIDE && sweptDep > 0.f) {
            // across the whole front under the swept roof: the posts up to its ceiling
            const float zPost = sweptPorchZ + 0.3f * sweptPitch + 0.2f * sweptPitch;
            housePorch(x, e, hy, -hx + 0.15f, hx - 0.15f, sweptDep, zb, zPost, 2, roofCol, roofMat, wallTrim, fq < 0.6f, -1e9f, true, ud);
            // the dormer on the front slope: a shed with a band of windows, or a small gable
            const float dw = Clamp(hx * 0.32f, 1.0f, 1.9f);
            dormer(x, e, rs, 0.f, dw, hy - 0.55f, fq3 < 0.6f ? 1 : 0, dw > 1.35f ? 3 : 2, gableCol, gableMat, roofCol, roofMat, wallTrim);
        } else {
            float pw = 2.f * hx * mr.range(0.4f, 0.6f);
            (void)mr.range(0.f, 1.f);   // (the porch used to stand anywhere along the front: now it is over the door)
            float dep = mr.range(1.9f, 2.4f);
            const bool rail = mr.chance(0.5f);
            // the porch centred on the door (a hipped bungalow's wider, under a hipped shed)
            if (form == blockstyle::HF_BUNG_HIP) pw = 2.f * hx * (0.55f + 0.2f * fq);
            pw = Min(pw, 2.f * hx - 0.4f);
            const float off = Clamp(ud, -hx + 0.2f + pw * 0.5f, hx - 0.2f - pw * 0.5f);
            dep = Clamp(dep, 1.5f, Max(1.5f, yardC - 1.3f));
            if (mission) {
                const bool slab = fq < 0.5f;
                housePorch(x, e, hy, off - pw * 0.5f, off + pw * 0.5f, dep, zb, zb + 2.6f, slab ? 4 : 1, slab ? gableCol : roofCol, slab ? gableMat : roofMat, wallTrim, rail,
                           -1e9f, true, ud);
            } else
                housePorch(x, e, hy, off - pw * 0.5f, off + pw * 0.5f, dep, zb, zb + 2.6f, form == blockstyle::HF_BUNG_HIP ? 3 : 0, roofCol, roofMat, wallTrim, rail,
                           -1e9f, true, ud);
            if (form == blockstyle::HF_BUNG_HIP && fq3 < 0.75f) {
                const float dw = Clamp(hx * 0.22f, 0.85f, 1.3f);
                dormer(x, e, rs, 0.f, dw, hy - 0.5f, 2, dw > 1.05f ? 2 : 1, gableCol, gableMat, roofCol, roofMat, wallTrim);
            }
            if (form == blockstyle::HF_BUNG_AIRPLANE) upperRoom(x, e, rs, -hy * 0.12f, gableCol, gableMat, roofCol, roofMat, wallTrim, b);
        }
    } else if (form == blockstyle::HF_FOURSQUARE) {
        // the American Foursquare: a porch across the front under a hipped shed (posts, piers or round columns), a hipped
        // dormer on the front slope of the pyramid roof
        const float ud = houseDoorU(e, -hx, hx, fac.bayW);
        const float yardC = dot(b.lotC - b.c, b.front) + b.lotHy - hy;
        const float dep = Clamp(2.2f + 0.5f * fq2, 1.6f, Max(1.6f, yardC - 1.3f));
        housePorch(x, e, hy, -hx + 0.1f, hx - 0.1f, dep, zb, zb + fac.groundH - 0.3f, 3, roofCol, roofMat, wallTrim, fq < 0.7f, -1e9f, true, ud);
        const RoofShape rs = roofShape(-hx, hx, -hy, hy, zTop, pitch, formOver, true, -1);
        if (fq3 < 0.85f) {
            const float dw = Clamp(hx * 0.26f, 1.0f, 1.5f);
            dormer(x, e, rs, 0.f, dw, hy - 0.45f, 2, 2, gableCol, gableMat, roofCol, roofMat, wallTrim);
        }
    } else if (conch) {
        float dep = mr.range(2.1f, 2.6f);
        // (the porch and its steps stay inside the front yard)
        float yardC = dot(b.lotC - b.c, b.front) + b.lotHy - hy;
        float stepsRun = Max(1.f, ceilf((zb + 0.02f - b.baseZ) / 0.2f) - 1.f) * 0.28f;
        float u0 = -hx + 0.2f, u1 = hx - 0.2f;
        // the temple front: a gable-fronted bay forward of the front; the porch stands on the longer set-back front beside
        // it (where the door is: facadedetail.cpp) and comes out a little past the bay's face
        const bool bay = b.massing == MK_STEP_FRONT && parts.size() > 1;
        float pv = hy, bu0 = 0.f, bu1 = 0.f;
        if (bay) {
            bu0 = parts[1].r.x;
            bu1 = parts[1].r.y;
            pv = parts[0].r.w;
            if (bu0 + hx >= hx - bu1) u1 = bu0 - 0.05f;
            else u0 = bu1 + 0.05f;
            dep = Max(dep, hy - pv + 0.4f);
            if (conchPorch == 2) conchPorch = 0;
        }
        // an L: the porch (or the gallery) in the inner corner beside the front leg, out to the leg's face, where the door
        // is (facadedetail.cpp's notch porch). Before, it stood across the whole front at the leg's face and floated in
        // front of the set-back part.
        const bool notch = b.massing == MK_L && parts.size() > 1;
        float notchW = 0.f;
        if (notch) {
            const vec4 leg = parts[1].r;
            const float vc = parts[0].r.w;
            const float nu0 = leg.x > -hx + 0.1f ? -hx : leg.y, nu1 = leg.x > -hx + 0.1f ? leg.x : hx;
            notchW = nu1 - nu0;
            u0 = nu0 + 0.1f;
            u1 = nu1 - 0.05f;
            pv = vc;
            dep = Max(dep, hy - vc);
            if (conchPorch == 2) conchPorch = 0;
        }
        dep = Clamp(dep, 1.5f, Max(1.5f, yardC + (hy - pv) - stepsRun - 0.4f));
        float zE = zb + Min(2.8f, fac.groundH - 0.2f);
        // (facadedetail.cpp puts a conch house's door in the longer set-back front, under the porch)
        if (notch && notchW < 2.f) {
            // (an inner corner under 2 m: the door is on the leg's face - facadedetail.cpp - under a small entry porch)
            u0 = parts[1].r.x + 0.3f;
            u1 = parts[1].r.y - 0.3f;
            pv = hy;
            conchPorch = 3;
        }
        if (bay && u1 - u0 < 1.5f) {
            // (no room beside the bay: the entry is in the bay, under a small porch on its face)
            u0 = bu0 + 0.2f;
            u1 = bu1 - 0.2f;
            pv = hy;
            conchPorch = 3;
        }
        // (the lower porch's ceiling painted: in the Keys, on half of them, the pale haint blue)
        const bool keysTown = b.region == REG_KEY_TOWN || b.region == REG_GULF_TOWN || b.region == REG_KEYS;
        const u32 ceil = x.trimMat ? ((keysTown && (hash32(b.seed ^ 0xC311u) & 1u)) ? packRGBA8(0.72f, 0.87f, 0.9f, 1) : wallTrim) : 0u;
        if (conchPorch == 4) galleryPorch(x, e, pv, u0, u1, dep, zb, zb + fac.groundH, zTop, roofCol, roofMat, wallTrim, b.baseZ, ceil);
        else if (conchPorch == 1) {
            float pw = Min(u1 - u0, 2.f * hx * mr.range(0.45f, 0.6f));
            float um = (u0 + u1) * 0.5f, off = bay ? um - gs * ((u1 - u0) * 0.5f - pw * 0.5f) * mr.range(0.f, 1.f) : -gs * (hx - pw * 0.5f - 0.3f) * mr.range(0.f, 1.f);
            housePorch(x, e, pv, off - pw * 0.5f, off + pw * 0.5f, dep, zb, zE, 0, roofCol, roofMat, wallTrim, true, b.baseZ);
        } else if (conchPorch == 3) {
            float pw = Min((u1 - u0) * 0.5f, mr.range(1.4f, 1.8f)), um = (u0 + u1) * 0.5f;
            housePorch(x, e, pv, um - pw, um + pw, mr.range(1.5f, 1.9f), zb, zE, 0, roofCol, roofMat, wallTrim, false, b.baseZ);
        } else {
            housePorch(x, e, pv, u0, u1, dep, zb, zE, 1, roofCol, roofMat, wallTrim, true, b.baseZ);
            if (conchPorch == 2) {
                // round the corner along the side away from the garage
                Env se = sideEnv(e, -gs);
                housePorch(x, se, hx - 0.2f, -hy + 1.f, hy + dep, dep, zb, zE, 1, roofCol, roofMat, wallTrim, true, b.baseZ, false);
            }
        }
        // the eyebrow house: a two-storey conch house without the double gallery brings its front eave down over the
        // upper windows (after the porch, which stays)
        if (b.floors >= 2 && conchPorch != 4 && parts.size() == 1 && hash32(b.seed ^ 0xE7EB0u) % 100u < 60u)
            eyebrowPent(x, e.P(-hx, hy), e.P(hx, hy), e.fr, zTop, 1.05f, Min(0.7f, fac.floorH * 0.28f), roofCol, roofMat, wallTrim);
        // piers under the raised floor (along the set-back front beside a bay)
        vec3 X(e.ax, 0.f), Y(e.fr, 0.f), Z(0, 0, 1);
        const float vfr = bay ? parts[0].r.w : hy;
        if (x.detail)
            for (float u = -hx + 0.4f; u <= hx - 0.3f; u += 2.4f)
                for (int k = 0; k < 2; k++) {
                    vec2 p = e.P(u, k ? (bay && u > bu0 && u < bu1 ? hy : vfr) - 0.3f : -hy + 0.3f);
                    x.m->box(vec3(p, b.baseZ - 0.2f + 0.45f) - x.org, X, Y, Z, vec3(0.2f, 0.2f, 0.45f), packRGBA8(0.7f, 0.68f, 0.64f, 1), makeMat(MAT_CONCRETE));
                }
    } else if (const int rp = blockstyle::ranchPorch(b)) {
        // the ranch porch: long and low under a shed roof, slim posts or round columns, across the middle of the front over
        // the door; on an L in the inner corner beside the front leg
        const float yardC = dot(b.lotC - b.c, b.front) + b.lotHy - hy;
        const u32 ph = hash32(b.seed ^ 0x2A0C5u);
        x.porchPosts = (ph & 3u) == 0u ? 2 : 0;
        const bool rail = ((ph >> 2) & 3u) == 0u;
        if (rp == 2 && parts.size() > 1) {
            const vec4 leg = parts[1].r;
            const float vc = parts[0].r.w;
            const float nu0 = leg.x > -hx + 0.1f ? -hx : leg.y, nu1 = leg.x > -hx + 0.1f ? leg.x : hx;
            const float dep = Min(2.3f, hy - vc - 0.1f);
            if (nu1 - nu0 > 2.4f && dep > 1.2f) housePorch(x, e, vc, nu0 + 0.15f, nu1 - 0.1f, dep, zb, zb + 2.5f, 1, roofCol, roofMat, wallTrim, rail);
        } else if (rp == 1) {
            const float ud = houseDoorU(e, -hx, hx, fac.bayW);
            const float pw = Min(2.f * hx - 0.6f, 2.f * hx * (0.48f + 0.22f * hashToFloat(ph >> 8)));
            const float off = Clamp(ud, -hx + 0.3f + pw * 0.5f, hx - 0.3f - pw * 0.5f);
            const float dep = Clamp(1.8f + 0.5f * hashToFloat(ph >> 16), 1.4f, Max(1.4f, yardC - 1.3f));
            housePorch(x, e, hy, off - pw * 0.5f, off + pw * 0.5f, dep, zb, zb + 2.5f, 1, roofCol, roofMat, wallTrim, rail, -1e9f, true, ud);
        }
    } else if (b.arch == AR_VILLA_COLONIAL) {
        colonialPortico(x, e, hx, hy, zb, zTop, roofCol, roofMat, mr);
    } else if (b.arch == AR_HOUSE_VICTORIAN) {
        // the porch: in the L's inner corner across the body's front (the entry), or across the whole front of a box; a
        // shed roof on posts with brackets, a rail; the front gable's truss
        const float zE = zb + fac.groundH - 0.25f;
        if (b.massing == MK_L && parts.size() > 1) {
            const vec4 leg = parts[1].r;
            const float vc = parts[0].r.w;
            float nu0 = leg.x > -hx + 0.1f ? -hx : leg.y, nu1 = leg.x > -hx + 0.1f ? leg.x : hx;   // the notch beside the leg
            float dep = Min(2.4f, hy - vc - 0.1f);
            if (nu1 - nu0 > 2.f && dep > 1.2f) {
                housePorch(x, e, vc, nu0 + 0.1f, nu1, dep, zb, zE, 1, roofCol, roofMat, wallTrim, true);
                porchBrackets(x, e, vc, nu0 + 0.1f, nu1, dep, zE, wallTrim);
            }
            gableTruss(x, e, hy, leg.x, leg.y, zTop, pitch, wallTrim, mr.chance(0.6f));
        } else {
            float yardC = dot(b.lotC - b.c, b.front) + b.lotHy - hy;
            float dep = Clamp(mr.range(2.f, 2.5f), 1.4f, Max(1.4f, yardC - 1.2f));
            housePorch(x, e, hy, -hx + 0.2f, hx - 0.2f, dep, zb, zE, 1, roofCol, roofMat, wallTrim, true);
            porchBrackets(x, e, hy, -hx + 0.2f, hx - 0.2f, dep, zE, wallTrim);
        }
    }
    return true;
}

}  // namespace World
