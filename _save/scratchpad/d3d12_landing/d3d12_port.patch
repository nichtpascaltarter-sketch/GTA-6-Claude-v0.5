+    memcpy(a.cpu, data, size);
+    ctx->transition(r, D3D12_RESOURCE_STATE_COPY_DEST);
+    ctx->flushBarriers();
+    ctx->list()->CopyBufferRegion(r->d3d, 0, a.res, a.offset, size);
+    ctx->anyWork = true;
