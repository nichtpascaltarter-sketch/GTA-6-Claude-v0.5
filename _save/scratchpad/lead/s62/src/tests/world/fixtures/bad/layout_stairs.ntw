ntw 1 layout id=lib.layout.test.stairs
# the kit's stair limits (docs/HANDBUILT_WORLD.md 4.9), one stair per rule
# (a mark with ^ stands for the record's first line, where a record's own findings are reported)
wall w1 a=0.00,0.00 b=20.00,0.00 t=0.20 ext=front
wall w2 a=20.00,0.00 b=20.00,20.00 t=0.20 ext=right
wall w3 a=20.00,20.00 b=0.00,20.00 t=0.20 ext=back
wall w4 a=0.00,20.00 b=0.00,0.00 t=0.20 ext=left
room lobby type=lobby poly=0.00,0.00;20.00,0.00;20.00,20.00;0.00,20.00
door d1 wall=w1 at=10.00 w=1.00 h=2.10 kind=hinged leads=out:lobby # expect door.landing
stair st1 from=f0.lobby to=f1.lobby run=1.00,2.00;1.00,5.00 w=1.00 kind=straight treads=14 rise=0.18 # expect stair.tread
stair st2 from=f0.lobby to=f1.lobby run=3.00,2.00;3.00,6.50 w=1.00 kind=straight treads=13 rise=0.24 # expect w:stair.tread w:stair.riser
stair st3 from=f0.lobby to=f1.lobby run=5.00,2.00;5.00,5.00;6.20,5.00;6.20,2.00 w=1.00 kind=dogleg treads=16 rise=0.18
  landing=0.80 # expect ^stair.landing
stair st4 from=f0.lobby to=f1.lobby run=8.00,2.00;8.00,4.50;10.50,4.50 w=1.20 kind=quarter treads=12 rise=0.18
  landing=1.20 # expect ^w:stair.landing ^w:stair.width
stair st5 from=f0.lobby to=f1.lobby run=12.00,2.00;12.00,4.00;14.00,4.00 w=0.90 kind=winder treads=14 rise=0.18
  walk=0.40 # expect ^stair.walkline ^w:stair.width ^w:stair.busy
stair st6 from=f0.lobby to=f1.lobby run=16.55,3.00;16.00,3.55;15.45,3.00;16.00,2.45;16.55,3.00 w=0.75 kind=spiral
  treads=14 rise=0.20 walk=0.52 # expect ^w:stair.walkline ^stair.tread
stair st7 from=f0.lobby to=f1.lobby run=1.00,10.00;2.00,11.00 w=1.00 kind=dogleg # expect stair.run
stair st8 from=f0.lobby to=f1.lobby run=5.00,10.00;6.00,10.50;7.00,10.00;8.00,10.50 w=1.00 kind=curved treads=10 # expect stair.run
stair st9 from=f0.lobby to=f1.lobby run=13.00,14.00;14.00,13.00;15.00,14.00 w=1.00 kind=curved treads=8 rise=0.18 # expect w:stair.radius
stair st10 from=f0.lobby to=f1.lobby run=18.00,10.00;18.00,14.00 w=1.20 kind=escalator
stair st11 from=f0.lobby to=f1.lobby run=10.00,0.50;10.00,4.00 w=1.00 kind=straight treads=12 rise=0.18
