+// A tied refuse sack: soft plastic bulging out over a bottom pressed flat and drawn in to a neck, lumpy where the rubbish
+// presses against it, the knot and its two ears on top. c: the middle of the bottom; X, Y: the sack's across axes, Z its
+// up axis (tilted for a sack lying over on the others); R: the half widths along X and Y and the height along Z. Smooth
+// normals: the gloss runs over the lumps (the old bags were boxes, hard black blocks at the kerb).
+void trashBag(MeshData& m, vec3 c, vec3 X, vec3 Y, vec3 Z, vec3 R, u32 col, u32 mat, u32 seed) {
+    const int NU = 8, NV = 5;
+    // the profile, bottom to neck: height and radius fractions
+    const float pz[NV + 1] = {0.f, 0.12f, 0.36f, 0.64f, 0.87f, 1.f};
+    const float pr[NV + 1] = {0.62f, 0.95f, 1.f, 0.84f, 0.4f, 0.09f};
+    Rng q(seed);
+    float ph[3];
+    for (float& a : ph) a = q.f() * kTwoPi;
+    const float lean = q.range(-0.12f, 0.12f), bump = q.range(0.08f, 0.14f);
+    auto at = [&](float a, float v) {
+        v = Clamp(v, 0.f, (float)NV);
+        const int j0 = Min((int)v, NV - 1);
+        const float t = v - (float)j0, zf = Lerp(pz[j0], pz[j0 + 1], t), rf = Lerp(pr[j0], pr[j0 + 1], t);
+        // lobes round the sack, strongest in the belly
+        const float w = sinf(kPi * Clamp(zf * 1.1f, 0.f, 1.f));
+        const float lump = 1.f + bump * w * (sinf(a * 2.f + ph[0] + zf * 3.f) * 0.6f + sinf(a * 3.f + ph[1] - zf * 5.f) * 0.5f + sinf(a * 5.f + ph[2]) * 0.3f);
+        const float k = rf * lump;
+        return c + X * (cosf(a) * R.x * k + lean * zf * zf * R.z) + Y * (sinf(a) * R.y * k) + Z * (zf * R.z);
+    };
+    const u32 base = (u32)m.verts.size();
+    for (int j = 0; j <= NV; j++)
+        for (int i = 0; i <= NU; i++) {
+            const float a = kTwoPi * (float)i / NU, v = (float)j;
+            const vec3 p = at(a, v), du = at(a + 0.05f, v) - at(a - 0.05f, v), dv = at(a, v + 0.15f) - at(a, v - 0.15f);
+            vec3 n = normalize(cross(du, dv));
+            if (dot(n, p - (c + Z * (R.z * pz[j]))) < 0.f) n = -n;
+            if (j == 0) n = normalize(n - Z * 0.6f);
+            m.addVertex(p, n, normalize(du), vec2((float)i / NU * 1.6f, pz[j] * 1.2f), col, mat);
+        }
+    for (int j = 0; j < NV; j++)
+        for (int i = 0; i < NU; i++) {
+            const u32 a0 = base + (u32)(j * (NU + 1) + i), a1 = a0 + 1, b0 = a0 + (u32)(NU + 1), b1 = b0 + 1;
+            const vec3 nf = cross(m.verts[a1].pos - m.verts[a0].pos, m.verts[b0].pos - m.verts[a0].pos);
+            const vec3 out = m.verts[a0].pos - (c + Z * (R.z * pz[j]));
+            if (dot(nf, out) >= 0.f) {
+                m.tri(a0, a1, b1);
+                m.tri(a0, b1, b0);
+            } else {
+                m.tri(a0, b1, a1);
+                m.tri(a0, b0, b1);
+            }
+        }
+    // the bottom, pressed flat
+    const u32 cb = m.addVertex(c + Z * 0.01f, -Z, X, vec2(0.5f, 0.f), col, mat);
+    for (int i = 0; i < NU; i++) {
+        const u32 a0 = base + (u32)i, a1 = a0 + 1;
+        const vec3 nf = cross(m.verts[a0].pos - m.verts[cb].pos, m.verts[a1].pos - m.verts[cb].pos);
+        if (dot(nf, Z) <= 0.f) m.tri(cb, a0, a1);
+        else m.tri(cb, a1, a0);
+    }
+    // the knot, its two ears (thin flaps, both faces)
+    const vec3 top = at(0.f, (float)NV) - X * (R.x * pr[NV]);
+    const vec3 kc = top + Z * 0.03f;
+    m.box(kc, X, Y, Z, vec3(0.035f, 0.03f, 0.03f), col, mat);
+    for (int sd = -1; sd <= 1; sd += 2) {
+        const vec3 ed = normalize(X * ((float)sd * 0.8f) + Z * 0.65f + Y * q.range(-0.35f, 0.35f));
+        const vec3 ew = normalize(cross(ed, Y)) * 0.035f, e0 = kc + ed * 0.01f, e1 = kc + ed * 0.13f;
+        const vec3 nn = normalize(cross(ed, ew));
+        m.quadFacing(e0 - ew, e1 - ew * 0.6f, e1 + ew * 0.6f, e0 + ew, vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), col, mat, nn);
+        m.quadFacing(e0 - ew, e0 + ew, e1 + ew * 0.6f, e1 - ew * 0.6f, vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), col, mat, -nn);
+    }
+}
