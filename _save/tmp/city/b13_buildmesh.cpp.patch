+// Balcony slabs on a residential tower's or condo's faces, one at every floor line between z0 and z1 (the facade grid
+// from vBase: fac's ground and floor heights), dep deep, with a glass railing: white bands that read from the air. The
+// faces of the rectangle c, ax, hx, hy (ch: the corners chamfered off): faces 0 the long pair, 1 the pair along ax (the
+// front and back), 2 all four. The far LOD gets the slab's top and edge and the railing's face, the near LOD the slab box,
+// the glass and (rail) its top rail.
+void balconyBands(Ctx& x, vec2 c, vec2 ax, float hx, float hy, float ch, float z0, float z1, float vBase, const FacadeGPU& fac, float dep, int faces, bool rail) {
+    const vec2 ay = perp(ax);
+    const u32 slabC = packRGBA8(0.94f, 0.94f, 0.92f, 1), glassC = packRGBA8(0.5f, 0.62f, 0.7f, 1), railC = packRGBA8(0.8f, 0.82f, 0.84f, 1);
+    const u32 concrete = makeMat(MAT_CONCRETE), glass = makeMat(MAT_GLASS), brushed = makeMat(MAT_METAL_BRUSHED);
+    const vec3 Z(0, 0, 1);
+    for (int face = 0; face < 4; face++) {
+        const bool alongX = face < 2;   // the faces at +-ay (they run along ax)
+        if ((faces == 0 && alongX != (hx >= hy)) || (faces == 1 && !alongX)) continue;
+        const float sgn = (face & 1) ? -1.f : 1.f;
+        const vec2 n = alongX ? ay * sgn : ax * sgn, t = alongX ? ax : ay;
+        const float off = alongX ? hy : hx, half = (alongX ? hx : hy) - ch - 0.35f;
+        if (half < 2.f) continue;
+        const vec3 N(n, 0.f), T(t, 0.f);
+        const float gh = rail ? 1.04f : 1.1f;   // (the condos' top rail is the detail pass's: facadedetail.cpp)
+        for (int k = 1; k < 200; k++) {
+            const float z = vBase + fac.groundH + (k - 1) * fac.floorH;
+            if (z > z1 - 1.2f) break;
+            if (z < z0 + 0.5f) continue;
+            const vec2 mid = c + n * (off + dep * 0.5f);
+            if (x.detail) {
+                x.m->box(vec3(mid, z - 0.08f) - x.org, T, vec3(n, 0.f), Z, vec3(half, dep * 0.5f, 0.1f), slabC, concrete, true);
+                const vec2 e0 = c + n * (off + dep - 0.04f) - t * half, e1 = c + n * (off + dep - 0.04f) + t * half;
+                x.m->quadFacing(vec3(e0, z + 0.04f) - x.org, vec3(e1, z + 0.04f) - x.org, vec3(e1, z + gh) - x.org, vec3(e0, z + gh) - x.org, vec2(0, 0),
+                                vec2(2.f * half, 0), vec2(2.f * half, 1), vec2(0, 1), glassC, glass, N);
+                if (rail) x.m->box(vec3(c + n * (off + dep - 0.05f), z + 1.07f) - x.org, T, vec3(n, 0.f), Z, vec3(half, 0.04f, 0.03f), railC, brushed);
+            } else {
+                // top, the slab edge and the railing's face
+                const vec2 a0 = c + n * off - t * half, a1 = c + n * off + t * half, b0 = a0 + n * dep, b1 = a1 + n * dep;
+                x.m->quadFacing(vec3(a0, z + 0.02f) - x.org, vec3(a1, z + 0.02f) - x.org, vec3(b1, z + 0.02f) - x.org, vec3(b0, z + 0.02f) - x.org, vec2(0, 0), vec2(1, 0),
+                                vec2(1, 1), vec2(0, 1), slabC, concrete, Z);
+                x.m->quadFacing(vec3(b0, z - 0.18f) - x.org, vec3(b1, z - 0.18f) - x.org, vec3(b1, z + 0.02f) - x.org, vec3(b0, z + 0.02f) - x.org, vec2(0, 0), vec2(1, 0),
+                                vec2(1, 1), vec2(0, 1), slabC, concrete, N);
+                x.m->quadFacing(vec3(b0, z + 0.02f) - x.org, vec3(b1, z + 0.02f) - x.org, vec3(b1, z + gh) - x.org, vec3(b0, z + gh) - x.org, vec2(0, 0),
+                                vec2(2.f * half, 0), vec2(2.f * half, 1), vec2(0, 1), glassC, glass, N);
+            }
+        }
+    }
+}
