+// A wooden water tank on a braced steel stand (the older masonry walk-ups): staved tank, iron hoops, conical roof and
+// finial, a ladder up the stand. p: the stand's centre on the roof at z; woodR: the staves' red. The far LOD keeps the
+// stand's legs, the tank and its roof (8 sides).
+void waterTank(Ctx& x, vec2 p, vec2 ax, float z, float woodR) {
+    const vec2 ay = perp(ax);
+    const vec3 X(ax, 0), Y(ay, 0), Z(0, 0, 1);
+    const u32 steel = packRGBA8(0.2f, 0.2f, 0.21f, 1), wood = packRGBA8(woodR, 0.4f, 0.33f, 1), metal = makeMat(MAT_METAL_PAINTED);
+    const float sz = 2.2f;
+    const int seg = x.detail ? 10 : 8;
+    // braced stand and deck
+    for (int k = 0; k < 4; k++) {
+        vec2 lp = p + ax * ((k & 1) ? 1.15f : -1.15f) + ay * ((k & 2) ? 1.15f : -1.15f);
+        x.m->box(vec3(lp, z + sz * 0.5f) - x.org, X, Y, Z, vec3(0.09f, 0.09f, sz * 0.5f), steel, metal);
+    }
+    if (x.detail) {
+        for (int k = 0; k < 2; k++)
+            x.m->box(vec3(p + (k ? ay : ax) * 0.f, z + sz * 0.45f) - x.org, k ? Y : X, k ? X : Y, Z, vec3(1.2f, 0.05f, 0.05f), steel, metal);
+        x.m->cylinder(vec3(p, z + sz) - x.org, 1.95f, 1.95f, 0.14f, 10, steel, metal, false);
+    }
+    // staved tank, iron hoops, conical roof, finial
+    x.m->cylinder(vec3(p, z + sz + 0.14f) - x.org, 1.6f, 1.55f, 3.1f, seg, wood, makeMat(MAT_WOOD), !x.detail);
+    if (x.detail)
+        for (int h = 0; h < 2; h++)
+            x.m->cylinder(vec3(p, z + sz + 0.7f + h * 1.5f) - x.org, 1.63f, 1.63f, 0.07f, 10, steel, metal, false);
+    x.m->cylinder(vec3(p, z + sz + 3.2f) - x.org, 1.78f, 0.05f, 1.05f, seg, wood, makeMat(MAT_ROOF_SHINGLE), false);
+    if (!x.detail) return;
+    x.m->box(vec3(p, z + sz + 4.35f) - x.org, X, Y, Z, vec3(0.06f, 0.06f, 0.14f), steel, metal);
+    // ladder up the stand and tank side
+    for (int k = -1; k <= 1; k += 2)
+        x.m->box(vec3(p + ay * 1.72f + ax * (k * 0.22f), z + (sz + 3.2f) * 0.5f) - x.org, X, Y, Z, vec3(0.025f, 0.025f, (sz + 3.2f) * 0.5f), steel, metal);
+}
