+// Roof plant that reads from the air, the same in every LOD (its own seeded stream): the stair bulkhead, with the lift
+// motor room beside it on the taller buildings, packaged HVAC units on their rails, a cooling tower on the big roofs and,
+// where tank is set, a wooden water tank on its stand - in a row along the back of the roof (fr: the building's front,
+// the roof rectangle c, ax, hx, hy). The far LOD gets the masses; the near LOD adds the doors, louvres and fan grilles.
+// Returns the depth of the band taken from the back edge (the small clutter keeps to the rest of the roof).
+float roofPlant(Ctx& x, vec2 c, vec2 ax, vec2 fr, float hx, float hy, float z, u32 seed, int floors, bool tank) {
+    if (hx < 4.f || hy < 3.5f) return 0.f;
+    const vec2 ay = perp(ax);
+    const float fs = dot(fr, ay) >= 0.f ? 1.f : -1.f;   // the front along ay
+    const vec3 X(ax, 0), Y(ay, 0), Z(0, 0, 1);
+    Rng q(seed ^ 0x9F1A7u);
+    struct Item { int kind; float w, d, h; };   // 0 stair bulkhead, 1 lift motor room, 2 HVAC unit, 3 cooling tower, 4 water tank
+    Item items[8];
+    int n = 0;
+    const float g = q.range(0.74f, 0.86f);
+    items[n++] = {0, q.range(2.7f, 3.3f), q.range(2.4f, 2.9f), q.range(2.7f, 3.1f)};
+    if (floors >= 5) items[n++] = {1, q.range(3.2f, 4.2f), q.range(2.8f, 3.6f), q.range(3.4f, 4.1f)};
+    if (tank) items[n++] = {4, 3.9f, 3.9f, 6.5f};
+    if (floors >= 6 && hx * hy >= 180.f && q.chance(0.6f)) items[n++] = {3, 4.2f, 4.2f, 3.1f};
+    int nh = Clamp(1 + (int)(hx * hy / 160.f), 1, 4);
+    for (int k = 0; k < nh && n < 8; k++) items[n++] = {2, q.range(2.2f, 3.8f), q.range(1.4f, 2.1f), q.range(1.2f, 1.75f)};
+    // along the back edge from one end, as many as fit (in that order)
+    const float gap = 1.1f, edge = 1.1f;
+    const float dir = q.chance(0.5f) ? 1.f : -1.f;
+    float u = -hx + edge, band = 0.f;
+    const u32 concrete = makeMat(MAT_CONCRETE), metal = makeMat(MAT_METAL_PAINTED), brushed = makeMat(MAT_METAL_BRUSHED);
+    const u32 dark = packRGBA8(0.14f, 0.15f, 0.16f, 1);
+    for (int i = 0; i < n; i++) {
+        Item it = items[i];
+        if (it.d > hy * 2.f - 2.f * edge) continue;
+        if (u + it.w > hx - edge) {
+            if (it.kind <= 1) return 0.f;   // (no room for the core: a small roof, the clutter only)
+            continue;
+        }
+        const float um = dir * (u + it.w * 0.5f), vm = -fs * (hy - edge - it.d * 0.5f - (it.kind == 2 ? q.range(0.f, 0.6f) : 0.f));
+        const vec2 p = c + ax * um + ay * vm;
+        u += it.w + gap;
+        band = Max(band, edge + it.d + (it.kind == 2 ? 0.6f : 0.f));
+        const vec3 base(p, z);
+        const vec3 Fv = Y * fs;   // the face towards the open roof
+        switch (it.kind) {
+            case 0:
+            case 1: {
+                // masonry box: a steel door (bulkhead) or a louvred vent panel (motor room) on the face towards the roof
+                const u32 col = packRGBA8(g, g * 0.985f, g * 0.95f, 1);
+                x.m->box(base + Z * (it.h * 0.5f) - x.org, X, Y, Z, vec3(it.w * 0.5f, it.d * 0.5f, it.h * 0.5f), col, concrete);
+                x.m->box(base + Z * (it.h + 0.06f) - x.org, X, Y, Z, vec3(it.w * 0.5f + 0.08f, it.d * 0.5f + 0.08f, 0.06f), packRGBA8(g * 0.9f, g * 0.9f, g * 0.88f, 1), concrete);
+                addCollision(x, p, ax, it.w * 0.5f, it.d * 0.5f, z, z + it.h);
+                if (x.detail) {
+                    vec3 fc = base + Fv * (it.d * 0.5f + 0.01f);
+                    if (it.kind == 0) {
+                        vec3 d0 = fc - X * 0.45f, d1 = fc + X * 0.45f;
+                        if (fs < 0.f) std::swap(d0, d1);
+                        x.m->quadFacing(d0 - x.org, d1 - x.org, d1 + Z * 2.05f - x.org, d0 + Z * 2.05f - x.org, vec2(0, 0), vec2(0.9f, 0), vec2(0.9f, 2.05f), vec2(0, 2.05f),
+                                        packRGBA8(0.33f, 0.36f, 0.4f, 1), metal, Fv);
+                    } else {
+                        vec3 l0 = fc - X * (it.w * 0.3f) + Z * 0.8f, l1 = fc + X * (it.w * 0.3f) + Z * 0.8f;
+                        x.m->quadFacing(l0 - x.org, l1 - x.org, l1 + Z * 1.4f - x.org, l0 + Z * 1.4f - x.org, vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), dark, brushed, Fv);
+                    }
+                }
+                break;
+            }
+            case 2: {
+                // packaged unit on two rails, a fan or two on top, a louvred side
+                const u32 col = packRGBA8(0.8f, 0.8f, 0.77f, 1);
+                const float zb = z + 0.22f;
+                x.m->box(vec3(p, zb + it.h * 0.5f) - x.org, X, Y, Z, vec3(it.w * 0.5f, it.d * 0.5f, it.h * 0.5f), col, metal);
+                if (x.detail) {
+                    for (int k = -1; k <= 1; k += 2)
+                        x.m->box(vec3(p + ay * (k * it.d * 0.32f), z + 0.11f) - x.org, X, Y, Z, vec3(it.w * 0.5f + 0.15f, 0.07f, 0.11f), packRGBA8(0.4f, 0.4f, 0.42f, 1), metal);
+                    int fans = it.w > 2.9f ? 2 : 1;
+                    float fr2 = Min(it.d * 0.36f, it.w / (2.f * fans) * 0.8f);
+                    for (int f = 0; f < fans; f++) {
+                        vec2 fp = p + ax * (fans == 2 ? (f ? 0.25f : -0.25f) * it.w : 0.f);
+                        x.m->cylinder(vec3(fp, zb + it.h) - x.org, fr2, fr2, 0.18f, 8, col, metal, false);
+                        vec3 gc = vec3(fp, zb + it.h + 0.15f) - x.org, gx = X * (fr2 * 0.9f), gy = Y * (fr2 * 0.9f);
+                        x.m->quadFacing(gc - gx - gy, gc + gx - gy, gc + gx + gy, gc - gx + gy, vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), dark, brushed, Z);
+                    }
+                    vec3 fc = vec3(p, zb) + Fv * (it.d * 0.5f + 0.01f);
+                    vec3 l0 = fc - X * (it.w * 0.42f) + Z * 0.15f, l1 = fc + X * (it.w * 0.42f) + Z * 0.15f;
+                    x.m->quadFacing(l0 - x.org, l1 - x.org, l1 + Z * (it.h - 0.3f) - x.org, l0 + Z * (it.h - 0.3f) - x.org, vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), dark, brushed, Fv);
+                }
+                break;
+            }
+            case 3: {
+                // cooling tower: a louvred box, the fan stack on top
+                const u32 col = packRGBA8(0.62f, 0.66f, 0.66f, 1);
+                x.m->box(base + Z * (it.h * 0.5f) - x.org, X, Y, Z, vec3(it.w * 0.5f, it.d * 0.5f, it.h * 0.5f), col, metal);
+                x.m->cylinder(base + Z * it.h - x.org, 1.55f, 1.45f, 0.9f, x.detail ? 12 : 8, col, metal, true);
+                addCollision(x, p, ax, it.w * 0.5f, it.d * 0.5f, z, z + it.h);
+                if (x.detail) {
+                    for (int sgn = -1; sgn <= 1; sgn += 2) {
+                        vec3 fc = base + X * (sgn * (it.w * 0.5f + 0.01f));
+                        vec3 a0 = fc - Y * (it.d * 0.4f) + Z * 0.3f, a1 = fc + Y * (it.d * 0.4f) + Z * 0.3f;
+                        if (sgn < 0) std::swap(a0, a1);
+                        x.m->quadFacing(a0 - x.org, a1 - x.org, a1 + Z * (it.h - 0.8f) - x.org, a0 + Z * (it.h - 0.8f) - x.org, vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), dark, brushed,
+                                        X * (float)sgn);
+                    }
+                    vec3 gc = base + Z * (it.h + 0.92f) - x.org, gx = X * 1.3f, gy = Y * 1.3f;
+                    x.m->quadFacing(gc - gx - gy, gc + gx - gy, gc + gx + gy, gc - gx + gy, vec2(0, 0), vec2(1, 0), vec2(1, 1), vec2(0, 1), dark, brushed, Z);
+                }
+                break;
+            }
+            default:
+                waterTank(x, p, ax, z, q.range(0.45f, 0.55f));
+                addCollision(x, p, ax, 1.25f, 1.25f, z, z + 2.2f);
+                break;
+        }
+    }
+    return band;
+}
