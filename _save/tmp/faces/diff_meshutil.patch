+// Strand card layer depth for the renderer's self-shadowing (MAT_HAIR param bits 20-22: 0 the outermost layer .. 7
+// the innermost) on the card vertices from `first` on (emitCard's return value).
+static inline void setCardDepth(MeshB& m, u32 first, u32 depth) {
+    for (u32 i = first; i < (u32)m.v.size(); i++) m.v[i].matParam = (m.v[i].matParam & ~(7u << 20)) | ((depth & 7u) << 20);
