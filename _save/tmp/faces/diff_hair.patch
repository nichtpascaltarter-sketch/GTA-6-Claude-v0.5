+            for (int e = 0; e < 3; e++) {
+                const BVert& v = c.m.v[H.grid[t.g[e]]];
+                p += v.p * bw[e];
+                nn += v.n * bw[e];
+                cvs += cvv[t.g[e]] * bw[e];
+                T += tv[t.g[e]] * bw[e];
