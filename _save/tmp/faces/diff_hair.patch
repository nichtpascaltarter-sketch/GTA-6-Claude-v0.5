+    float cvMinAll = 0.f;
+    for (int l = 0; l < nl; l++) cvMinAll = Min(cvMinAll, layers[l].cvMin);
+    // coverage and the shell's thickness per grid vertex
+    std::vector<float> cvv((size_t)H.rows * NC, -1.f), tv((size_t)H.rows * NC, 0.f);
+    for (int j = 0; j < H.rows; j++)
