ntw 1 layout id=lib.layout.test.doors
# doors and windows that don't fit their walls, join the wrong rooms, or are too narrow
wall w1 a=0.00,0.00 b=8.00,0.00 t=0.20 ext=front
wall w2 a=8.00,0.00 b=8.00,6.00 t=0.20 ext=right
wall w3 a=8.00,6.00 b=0.00,6.00 t=0.20 ext=back
wall w4 a=0.00,6.00 b=0.00,0.00 t=0.20 ext=left
wall w5 a=4.00,0.00 b=4.00,6.00 t=0.12
wall w6 a=4.00,4.80 b=8.00,4.80 t=0.12
room hall type=hall poly=4.00,4.80;8.00,4.80;8.00,6.00;4.00,6.00
room living type=living poly=0.00,0.00;4.00,0.00;4.00,6.00;0.00,6.00
room kitchen type=kitchen poly=4.00,0.00;8.00,0.00;8.00,4.80;4.00,4.80
door d1 wall=w1 at=0.30 w=0.90 h=2.10 kind=hinged leads=out:living # expect door.wall
door d2 wall=w1 at=4.00 w=0.90 h=2.10 kind=hinged leads=out:living # expect door.wall door.rooms
door d3 wall=w1 at=2.00 w=0.90 h=2.10 kind=hinged leads=out:kitchen # expect door.rooms
window n1 wall=w1 at=2.50 w=1.00 h=1.20 sill=0.90 kind=dhung room=living # expect window.wall
window n2 wall=w5 at=2.00 w=1.00 h=1.20 sill=0.90 kind=fixed room=living # expect window.wall
window n3 wall=w2 at=2.00 w=1.00 h=1.20 sill=0.90 kind=dhung room=living # expect window.room
door d4 wall=w5 at=3.00 w=0.75 h=2.10 kind=hinged leads=living:kitchen # expect door.width
door d5 wall=w6 at=2.00 w=0.85 h=2.10 kind=hinged leads=kitchen:hall # expect w:door.width
door d6 wall=w6 at=3.00 w=0.90 h=2.10 kind=hinged leads=hall:hall # expect door.rooms
